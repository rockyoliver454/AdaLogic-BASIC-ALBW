-- 420 | Sphenic numbers: products of exactly three distinct primes.
-- First 30 and count below 1,000.
DECLARE MODULE Sph
    FUNCTION IsSphenic(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sph
    FUNCTION IsSphenic(n AS S64) AS S32
        LET m AS S64 = n
        LET factors AS S64 = 0
        LET d AS S64 = 2
        WHILE d * d <= m
            IF m MOD d = 0 THEN
                m = m / d
                IF m MOD d = 0 THEN RETURN 0 END IF
                factors = factors + 1
                IF factors > 3 THEN RETURN 0 END IF
            END IF
            d = d + 1
        END WHILE
        IF m > 1 THEN factors = factors + 1 END IF
        IF factors = 3 THEN RETURN 1 END IF
        RETURN 0
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET n AS S64 = 2
        LET got AS S64 = 0
        WHILE got < 30
            IF IsSphenic(n) = 1 THEN
                s = s | n | " "
                got = got + 1
            END IF
            n = n + 1
        END WHILE
        PRINT s
        LET cnt AS S64 = 0
        FOR m = 2 TO 999
            IF IsSphenic(m) = 1 THEN cnt = cnt + 1 END IF
        END FOR
        PRINT "count=" | cnt
    END PROCEDURE
END MODULE

IMPORT Sph
BEGIN
    Sph.Run()
END
