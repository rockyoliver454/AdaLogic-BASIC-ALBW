-- 381 | Perrin numbers: P(0)=3, P(1)=0, P(2)=2, P(n)=P(n-2)+P(n-3); first 20.
DECLARE MODULE Perrin
    PROCEDURE Run()
END DECLARE MODULE

MODULE Perrin
    STRICT p[24] AS S64
    PROCEDURE Run()
        p[0] = 3
        p[1] = 0
        p[2] = 2
        FOR n = 3 TO 19
            p[n] = p[n - 2] + p[n - 3]
        END FOR
        LET s AS STRING = ""
        FOR n = 0 TO 19
            s = s | p[n] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Perrin
BEGIN
    Perrin.Run()
END
