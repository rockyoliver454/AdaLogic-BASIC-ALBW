VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET c AS S64 = x MOD 6
            LET v AS S64 = 0
            IF c = 0 THEN v = 16711680 END IF
            IF c = 1 THEN v = 16776960 END IF
            IF c = 2 THEN v = 65280 END IF
            IF c = 3 THEN v = 65535 END IF
            IF c = 4 THEN v = 255 END IF
            IF c = 5 THEN v = 16711935 END IF
            img[y * 64 + x] = v
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Colour pinstripe", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
                k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "stripes=1px cycle=6"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
