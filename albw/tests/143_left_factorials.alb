-- 143 | Left factorials: !n = sum of k! for k = 0..n-1.
BEGIN
    LET fact AS S64 = 1;
    LET sum AS S64 = 0;
    FOR k = 0 TO 9
        IF k > 0 THEN
            fact = fact * k;
        END IF
        sum = sum + fact;
    END FOR
    PRINT sum;
    --  report each term too
    fact = 1;
    FOR n = 1 TO 6
        LET s2 AS S64 = 0;
        LET f AS S64 = 1;
        FOR k = 0 TO n - 1
            IF k > 0 THEN
                f = f * k;
            END IF
            s2 = s2 + f;
        END FOR
        PRINT s2;
    END FOR
END
