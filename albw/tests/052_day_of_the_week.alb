-- 052 | Day of the week: Tomohiko Sakamoto's method.
DECLARE MODULE W
    FUNCTION Dow(y AS S32, m AS S32, d AS S32) AS S32
END DECLARE MODULE

MODULE W
    FUNCTION Dow(y AS S32, m AS S32, d AS S32) AS S32
        STRICT t[12] AS S32;
        t[0]=0; t[1]=3; t[2]=2; t[3]=5; t[4]=0; t[5]=3;
        t[6]=5; t[7]=1; t[8]=4; t[9]=6; t[10]=2; t[11]=4;
        IF m < 3 THEN
            y = y - 1;
        END IF
        RETURN (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) MOD 7
    END FUNCTION
END MODULE

IMPORT W
BEGIN
    STRICT names[7] AS STRING;
    names[0] = "Sunday"; names[1] = "Monday"; names[2] = "Tuesday";
    names[3] = "Wednesday"; names[4] = "Thursday"; names[5] = "Friday";
    names[6] = "Saturday";
    PRINT$ names[W.Dow(2024, 3, 15)];
    PRINT$ names[W.Dow(2000, 1, 1)];
    PRINT$ names[W.Dow(1969, 7, 20)];
END
