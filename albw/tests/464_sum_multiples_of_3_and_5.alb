-- 464 | Sum multiples of 3 and 5: sum of natural numbers below 1000
-- divisible by 3 or 5.
DECLARE MODULE Sum35
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sum35
    PROCEDURE Run()
        LET total AS S64 = 0
        FOR n = 1 TO 999
            IF n MOD 3 = 0 ORELSE n MOD 5 = 0 THEN total = total + n END IF
        END FOR
        PRINT total
    END PROCEDURE
END MODULE

IMPORT Sum35
BEGIN
    Sum35.Run()
END
