VERSION 1.0

BEGIN
    LET h AS S64 = OPEN("sig.bin", "w")
    WRITE h, CHR(137) | CHR(80) | CHR(78) | CHR(71) | CHR(13) | CHR(10) | CHR(26) | CHR(10) | "rest"
    CLOSE h

    LET r AS S64 = OPEN("sig.bin", "r")
    LET head AS STRING = READ(r, FILELEN("sig.bin"))
    CLOSE r

    LET b0 AS S64 = ASC(MID$(head, 1, 1))
    LET b1 AS S64 = ASC(MID$(head, 2, 1))
    LET b2 AS S64 = ASC(MID$(head, 3, 1))
    LET b3 AS S64 = ASC(MID$(head, 4, 1))
    PRINT "bytes=" | b0 | "," | b1 | "," | b2 | "," | b3
    IF b0 = 137 ANDALSO b1 = 80 ANDALSO b2 = 78 ANDALSO b3 = 71 THEN
        PRINT "type=PNG"
    ELSE
        PRINT "type=unknown"
    END IF

    LET h2 AS S64 = OPEN("sig2.bin", "w")
    WRITE h2, CHR(255) | CHR(216) | CHR(255) | CHR(224) | "jfif"
    CLOSE h2
    LET r2 AS S64 = OPEN("sig2.bin", "r")
    LET head2 AS STRING = READ(r2, FILELEN("sig2.bin"))
    CLOSE r2
    IF ASC(MID$(head2, 1, 1)) = 255 ANDALSO ASC(MID$(head2, 2, 1)) = 216 THEN
        PRINT "type2=JPEG"
    END IF
END
