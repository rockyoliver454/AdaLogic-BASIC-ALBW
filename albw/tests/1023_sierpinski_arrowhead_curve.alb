VERSION 1.0
STRICT x1[260] AS S64
STRICT y1[260] AS S64
STRICT x2[260] AS S64
STRICT y2[260] AS S64

LET frames AS S64 = 0
LET nseg AS S64 = 0
LET tx AS F64 = 8.0
LET ty AS F64 = 50.0
LET th AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE Fwd()
    LET nx AS F64 = tx + Cs(th) * 0.9
    LET ny AS F64 = ty - Sn(th) * 0.9
    x1[nseg] = ROUND(tx) y1[nseg] = ROUND(ty) x2[nseg] = ROUND(nx) y2[nseg] = ROUND(ny)
    tx = nx
    ty = ny
    nseg = nseg + 1
END PROCEDURE

PROCEDURE SA(n AS S64, d AS S64)
    IF n = 0 THEN
        CALL Fwd()
    ELSE
        CALL SB2(n - 1, 0 - d)
        th = th + 60 * d
        CALL SA(n - 1, 0 - d)
        th = th + 60 * d
        CALL SB2(n - 1, 0 - d)
    END IF
END PROCEDURE

PROCEDURE SB2(n AS S64, d AS S64)
    IF n = 0 THEN
        CALL Fwd()
    ELSE
        CALL SA(n - 1, 0 - d)
        th = th - 60 * d
        CALL SB2(n - 1, 0 - d)
        th = th - 60 * d
        CALL SA(n - 1, 0 - d)
    END IF
END PROCEDURE

BEGIN
    CALL SA(5, 1)

    CREATE_WINDOW "Sierpinski arrowhead curve", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $FF00FF
        i = 0
        WHILE i < nseg
            DRAW LINE x1[i], y1[i], x2[i], y2[i]
            i = i + 1
        END WHILE
        fpx = READ_PIXEL(x1[0], y1[0])
    END

    LISTEN

    PRINT "order=5"
    PRINT "segments=" | nseg
    PRINT "end=(" | ROUND(tx) | "," | ROUND(ty) | ")"
    PRINT "start_px=" | fpx
END
