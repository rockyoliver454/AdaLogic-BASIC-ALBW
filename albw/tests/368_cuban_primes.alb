-- 368 | Cuban primes: primes of the form (k+1)^3 - k^3 = 3k^2+3k+1, first 15.
DECLARE MODULE Cuban
    FUNCTION IsPrime(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Cuban
    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        IF n = 2 THEN RETURN 1 END IF
        IF n MOD 2 = 0 THEN RETURN 0 END IF
        LET d AS S64 = 3
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 2
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET found AS S32 = 0
        LET k AS S64 = 1
        WHILE found < 15
            LET p AS S64 = 3 * k * k + 3 * k + 1
            IF IsPrime(p) = 1 THEN
                s = s | p | " "
                found = found + 1
            END IF
            k = k + 1
        END WHILE
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Cuban
BEGIN
    Cuban.Run()
END
