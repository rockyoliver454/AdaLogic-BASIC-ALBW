-- 506 | Sorting algorithms/Gnome sort.
DECLARE MODULE Gnome
    PROCEDURE Run()
END DECLARE MODULE

MODULE Gnome
    STRICT a[10] AS S64

    PROCEDURE Run()
        a[1] = 34
        a[2] = 8
        a[3] = 64
        a[4] = 51
        a[5] = 32
        a[6] = 21
        a[7] = 5
        a[8] = 90
        a[9] = 12
        a[10] = 47
        LET i AS S64 = 2
        WHILE i <= 10
            IF a[i - 1] <= a[i] THEN
                i = i + 1
            ELSE
                LET t AS S64 = a[i]
                a[i] = a[i - 1]
                a[i - 1] = t
                IF i > 2 THEN i = i - 1 ELSE i = i + 1 END IF
            END IF
        END WHILE
        LET s AS STRING = ""
        FOR k = 1 TO 10
            s = s | a[k] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Gnome
BEGIN
    Gnome.Run()
END
