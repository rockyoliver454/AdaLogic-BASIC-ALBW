VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION


BEGIN
    sd = 20260316
    LET i AS S64 = 0
    WHILE i < 4096
        LET r AS S64 = Nxt() MOD 256
        LET g AS S64 = Nxt() MOD 256
        LET b AS S64 = Nxt() MOD 256
        img[i] = r * 65536 + g * 256 + b
        i = i + 1
    END WHILE

    CREATE_WINDOW "Image noise", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(5, 5)
    END

    LISTEN

    PRINT "pixels=4096"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(5,5)=" | fpx
END

