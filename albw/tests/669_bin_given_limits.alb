-- 669 | Bin given limits: histogram of values over
-- [0,10),[10,20),[20,30) bins.
DECLARE MODULE Bin
    PROCEDURE Run()
END DECLARE MODULE

MODULE Bin
    STRICT v[9] AS S64

    PROCEDURE Run()
        v[1] = 3
        v[2] = 14
        v[3] = 7
        v[4] = 22
        v[5] = 9
        v[6] = 11
        v[7] = 29
        v[8] = 17
        v[9] = 25
        LET b1 AS S64 = 0
        LET b2 AS S64 = 0
        LET b3 AS S64 = 0
        FOR i = 1 TO 9
            IF v[i] < 10 THEN b1 = b1 + 1 END IF
            IF v[i] >= 10 ANDALSO v[i] < 20 THEN b2 = b2 + 1 END IF
            IF v[i] >= 20 THEN b3 = b3 + 1 END IF
        END FOR
        PRINT "[0,10): " | b1
        PRINT "[10,20): " | b2
        PRINT "[20,30): " | b3
    END PROCEDURE
END MODULE

IMPORT Bin
BEGIN
    Bin.Run()
END
