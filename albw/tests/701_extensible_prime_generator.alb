-- 701 | Extensible prime generator: primes below 100 and
-- primes between 10000 and 10100 via extensible sieve logic.
DECLARE MODULE Xp
    PROCEDURE Run()
END DECLARE MODULE

MODULE Xp
    STRICT sv[10101] AS S32

    PROCEDURE Run()
        FOR i = 0 TO 10100
            sv[i] = 1
        END FOR
        sv[0] = 0
        sv[1] = 0
        LET p AS S64 = 2
        WHILE p * p <= 10100
            IF sv[p] = 1 THEN
                LET m AS S64 = p * p
                WHILE m <= 10100
                    sv[m] = 0
                    m = m + p
                END WHILE
            END IF
            p = p + 1
        END WHILE
        FOR n = 2 TO 99
            IF sv[n] = 1 THEN PRINT n END IF
        END FOR
        PRINT "--"
        FOR n2 = 10000 TO 10100
            IF sv[n2] = 1 THEN PRINT n2 END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Xp
BEGIN
    Xp.Run()
END
