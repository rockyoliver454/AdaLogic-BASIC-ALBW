-- 776 | Stair-climbing puzzle: ways to climb n stairs taking
-- 1 or 2 steps at a time.
DECLARE MODULE Sc
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sc
    PROCEDURE Run()
        LET a AS S64 = 1
        LET b AS S64 = 1
        PRINT "n=1 ways=1"
        FOR n = 2 TO 10
            LET c AS S64 = a + b
            a = b
            b = c
            PRINT "n=" | n | " ways=" | c
        END FOR
    END PROCEDURE
END MODULE

IMPORT Sc
BEGIN
    Sc.Run()
END
