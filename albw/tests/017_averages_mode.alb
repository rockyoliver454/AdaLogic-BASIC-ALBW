-- 017 | Averages/Mode: most frequent value.
BEGIN
    STRICT a[10] AS S32;
    a[0]=2; a[1]=7; a[2]=2; a[3]=9; a[4]=2;
    a[5]=7; a[6]=2; a[7]=5; a[8]=7; a[9]=7;
    LET best AS S32 = a[0];
    LET bestc AS S32 = 0;
    FOR i = 0 TO 9
        LET c AS S32 = 0;
        FOR j = 0 TO 9
            IF a[j] = a[i] THEN
                c = c + 1;
            END IF
        END FOR
        IF c > bestc THEN
            bestc = c;
            best = a[i];
        END IF
    END FOR
    PRINT$ best | " x" | bestc;
END
