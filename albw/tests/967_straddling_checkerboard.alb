-- 967 | Straddling checkerboard: 0-9 header, top row of
-- high-freq letters with 2 gaps marking the extra rows.
-- Encode then decode "ATTACKATDAWN" for a round-trip.
DECLARE MODULE Sc
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sc
    STRICT top[1] AS STRING
    STRICT r2[1] AS STRING
    STRICT r6[1] AS STRING

    FUNCTION Enc(c AS S64) AS S64
        -- returns digit(s) packed: 0..9 single, else row*10+col
        FOR i = 1 TO 10
            IF ASC(MID$(top[1], i, 1)) = c THEN RETURN i - 1 END IF
        END FOR
        FOR i = 1 TO 10
            IF ASC(MID$(r2[1], i, 1)) = c THEN RETURN 20 + i - 1 END IF
        END FOR
        FOR i = 1 TO 10
            IF ASC(MID$(r6[1], i, 1)) = c THEN RETURN 60 + i - 1 END IF
        END FOR
        RETURN 0 - 1
    END FUNCTION

    PROCEDURE Run()
        top[1] = "ET AON RIS"
        r2[1] = "BCDFGHJKLM"
        r6[1] = "PQUVWXYZ./"
        LET msg AS STRING = "ATTACKATDAWN"
        LET n AS S64 = LEN(msg)
        LET ds AS STRING = ""
        FOR i = 1 TO n
            LET v AS S64 = Enc(ASC(MID$(msg, i, 1)))
            IF v < 10 THEN
                ds = ds | v
            ELSE
                ds = ds | v / 10 | v MOD 10
            END IF
        END FOR
        PRINT "ct: " | ds
        -- decode
        LET o2 AS STRING = ""
        LET i AS S64 = 1
        LET dn AS S64 = LEN(ds)
        WHILE i <= dn
            LET d AS S64 = ASC(MID$(ds, i, 1)) - ASC("0")
            IF d = 2 THEN
                o2 = o2 | MID$(r2[1], ASC(MID$(ds, i + 1, 1)) - ASC("0") + 1, 1)
                i = i + 2
            ELSE IF d = 6 THEN
                o2 = o2 | MID$(r6[1], ASC(MID$(ds, i + 1, 1)) - ASC("0") + 1, 1)
                i = i + 2
            ELSE
                o2 = o2 | MID$(top[1], d + 1, 1)
                i = i + 1
            END IF
            END IF
        END WHILE
        PRINT "pt: " | o2
    END PROCEDURE
END MODULE

IMPORT Sc
BEGIN
    Sc.Run()
END
