-- 599 | Ordered partitions: Fubini numbers (ordered Bell) for
-- n=0..5 via recurrence a(n) = sum_k C(n,k)*a(k-1)... use
-- a(n) = sum_{k=1..n} k! * S(n,k). Expected 1 1 3 13 75 541.
DECLARE MODULE Fub
    FUNCTION C(n AS S64, k AS S64) AS S64
    FUNCTION Fact(n AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Fub
    STRICT s2[49] AS S64

    FUNCTION C(n AS S64, k AS S64) AS S64
        IF k < 0 ORELSE k > n THEN RETURN 0 END IF
        LET r AS S64 = 1
        FOR i = 1 TO k
            r = r * (n - k + i) / i
        END FOR
        RETURN r
    END FUNCTION

    FUNCTION Fact(n AS S64) AS S64
        LET r AS S64 = 1
        FOR i = 2 TO n
            r = r * i
        END FOR
        RETURN r
    END FUNCTION

    PROCEDURE Run()
        -- Stirling S(n,k) table, s2[n*7+k]
        FOR i = 0 TO 48
            s2[i] = 0
        END FOR
        s2[0] = 1
        FOR n = 1 TO 6
            FOR k = 1 TO n
                s2[n * 7 + k] = s2[(n - 1) * 7 + k - 1] + k * s2[(n - 1) * 7 + k]
            END FOR
        END FOR
        LET s AS STRING = ""
        FOR n2 = 0 TO 5
            LET f AS S64 = 0
            FOR k2 = 1 TO n2
                f = f + Fact(k2) * s2[n2 * 7 + k2]
            END FOR
            IF n2 = 0 THEN f = 1 END IF
            s = s | f | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Fub
BEGIN
    Fub.Run()
END
