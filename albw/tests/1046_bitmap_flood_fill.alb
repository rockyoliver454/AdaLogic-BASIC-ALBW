VERSION 1.0

STRICT img[4096] AS S32
STRICT stk[8192] AS S64

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sp AS S64 = 0
LET filled AS S64 = 0

PROCEDURE Flood(x AS S64, y AS S64)
    stk[sp] = y * 64 + x
    sp = sp + 1
    WHILE sp > 0
        sp = sp - 1
        LET c AS S64 = stk[sp]
        LET cx AS S64 = c MOD 64
        LET cy AS S64 = c / 64
        IF img[c] = 0 THEN
            img[c] = 16711680
            filled = filled + 1
            IF cx > 0 THEN stk[sp] = c - 1 sp = sp + 1 END IF
            IF cx < 63 THEN stk[sp] = c + 1 sp = sp + 1 END IF
            IF cy > 0 THEN stk[sp] = c - 64 sp = sp + 1 END IF
            IF cy < 63 THEN stk[sp] = c + 64 sp = sp + 1 END IF
        END IF
    END WHILE
END PROCEDURE


BEGIN
    LET y AS S64 = 8
    WHILE y < 56
        img[y * 64 + 8] = 16777215
        img[y * 64 + 56] = 16777215
        y = y + 1
    END WHILE
    LET x AS S64 = 8
    WHILE x < 56
        img[8 * 64 + x] = 16777215
        img[56 * 64 + x] = 16777215
        x = x + 1
    END WHILE

    CALL Flood(32, 32)

    CREATE_WINDOW "Flood fill", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(32, 32)
    END

    LISTEN

    PRINT "filled=" | filled
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(32,32)=" | fpx
END
