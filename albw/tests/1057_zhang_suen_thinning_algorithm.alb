VERSION 1.0

STRICT img[4096] AS S32
STRICT del[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET iter AS S64 = 0

FUNCTION N2(i AS S64) AS S64
    LET c AS S64 = img[i - 65] + img[i - 64] + img[i - 63]
    c = c + img[i - 1] + img[i + 1]
    c = c + img[i + 63] + img[i + 64] + img[i + 65]
    RETURN c / 16777215
END FUNCTION

FUNCTION TR(i AS S64) AS S64
    LET t AS S64 = 0
    IF img[i - 64] = 0 ANDALSO img[i - 63] <> 0 THEN t = t + 1 END IF
    IF img[i - 63] = 0 ANDALSO img[i + 1] <> 0 THEN t = t + 1 END IF
    IF img[i + 1] = 0 ANDALSO img[i + 65] <> 0 THEN t = t + 1 END IF
    IF img[i + 65] = 0 ANDALSO img[i + 64] <> 0 THEN t = t + 1 END IF
    IF img[i + 64] = 0 ANDALSO img[i + 63] <> 0 THEN t = t + 1 END IF
    IF img[i + 63] = 0 ANDALSO img[i - 1] <> 0 THEN t = t + 1 END IF
    IF img[i - 1] = 0 ANDALSO img[i - 65] <> 0 THEN t = t + 1 END IF
    IF img[i - 65] = 0 ANDALSO img[i - 64] <> 0 THEN t = t + 1 END IF
    RETURN t
END FUNCTION


BEGIN
    LET y AS S64 = 16
    WHILE y < 48
        LET x AS S64 = 20
        WHILE x < 44
            img[y * 64 + x] = 16777215
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    LET chgd AS S64 = 1
    iter = 0
    WHILE chgd > 0 ANDALSO iter < 40
        chgd = 0
        y = 16
        WHILE y < 48
            LET x AS S64 = 20
            WHILE x < 44
                LET i AS S64 = y * 64 + x
                del[i] = 0
                IF img[i] <> 0 THEN
                    LET b AS S64 = N2(i)
                    LET t AS S64 = TR(i)
                    IF b >= 2 ANDALSO b <= 6 ANDALSO t = 1 THEN
                        IF img[i - 64] = 0 ORELSE img[i + 1] = 0 ORELSE img[i + 64] = 0 THEN
                            IF img[i + 1] = 0 ORELSE img[i + 64] = 0 ORELSE img[i - 1] = 0 THEN
                                del[i] = 1
                                chgd = chgd + 1
                            END IF
                        END IF
                    END IF
                END IF
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
        LET i2 AS S64 = 0
        WHILE i2 < 4096
            IF del[i2] = 1 THEN img[i2] = 0 END IF
            i2 = i2 + 1
        END WHILE
        y = 16
        WHILE y < 48
            LET x AS S64 = 20
            WHILE x < 44
                LET i AS S64 = y * 64 + x
                del[i] = 0
                IF img[i] <> 0 THEN
                    LET b AS S64 = N2(i)
                    LET t AS S64 = TR(i)
                    IF b >= 2 ANDALSO b <= 6 ANDALSO t = 1 THEN
                        IF img[i - 64] = 0 ORELSE img[i + 1] = 0 ORELSE img[i - 1] = 0 THEN
                            IF img[i - 64] = 0 ORELSE img[i + 64] = 0 ORELSE img[i + 1] = 0 THEN
                                del[i] = 1
                                chgd = chgd + 1
                            END IF
                        END IF
                    END IF
                END IF
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
        i2 = 0
        WHILE i2 < 4096
            IF del[i2] = 1 THEN img[i2] = 0 END IF
            i2 = i2 + 1
        END WHILE
        iter = iter + 1
    END WHILE

    CREATE_WINDOW "Zhang-Suen thinning", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "iters=" | iter
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
