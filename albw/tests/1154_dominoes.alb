VERSION 1.0

STRICT dm[14] AS S64
STRICT used[8] AS S64

LET fail AS S64 = 0

FUNCTION TryDom(dmn AS S64, want AS S64) AS S64
    IF used[dmn] = 1 THEN
        RETURN 0 - 1
    END IF
    LET a AS S64 = dm[dmn * 2]
    LET b AS S64 = dm[dmn * 2 + 1]
    IF a = want THEN
        RETURN b
    END IF
    IF b = want THEN
        RETURN a
    END IF
    RETURN 0 - 1
END FUNCTION


BEGIN
    dm[0] = 1 dm[1] = 2
    dm[2] = 2 dm[3] = 3
    dm[4] = 3 dm[5] = 1
    dm[6] = 0 dm[7] = 2
    dm[8] = 2 dm[9] = 0
    dm[10] = 0 dm[11] = 0
    dm[12] = 3 dm[13] = 3

    LET i AS S64 = 0
    WHILE i < 8
        used[i] = 0
        i = i + 1
    END WHILE

    LET chain AS STRING = ""
    LET nxt AS S64 = dm[1]
    chain = "[" | dm[0] | "-" | dm[1] | "]"
    used[0] = 1
    LET count AS S64 = 1
    WHILE count < 7
        LET found AS S64 = 0 - 1
        i = 0
        WHILE i < 7
            IF used[i] = 0 THEN
                LET r AS S64 = TryDom(i, nxt)
                IF r >= 0 THEN
                    found = i
                    chain = chain | "[" | nxt | "-" | r | "]"
                    nxt = r
                    used[i] = 1
                END IF
            END IF
            i = i + 1
        END WHILE
        IF found < 0 THEN
            PRINT "chain ends (no domino with " | nxt | ")"
            count = 99
        ELSE
            count = count + 1
        END IF
    END WHILE
    PRINT chain
END
