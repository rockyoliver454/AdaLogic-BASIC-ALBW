VERSION 1.0


BEGIN
    LET bxs AS F64 = -1.0
    LET bys AS F64 = -1.0
    LET bbd AS F64 = 999.0
    LET hits AS S64 = 0
    LET i AS S64 = 0
    WHILE i <= 200
        LET t AS F64 = i / 200.0
        LET u AS F64 = 1.0 - t
        LET x1 AS F64 = u * u * 0.0 + 2.0 * u * t * 4.0 + t * t * 8.0
        LET y1 AS F64 = u * u * 0.0 + 2.0 * u * t * 8.0 + t * t * 0.0
        LET j AS S64 = 0
        WHILE j <= 200
            LET s AS F64 = j / 200.0
            LET w AS F64 = 1.0 - s
            LET x2 AS F64 = w * w * 0.0 + 2.0 * w * s * 8.0 + s * s * 8.0
            LET y2 AS F64 = w * w * 8.0 + 2.0 * w * s * 4.0 + s * s * 0.0
            LET ddx AS F64 = x1 - x2
            LET ddy AS F64 = y1 - y2
            LET dd AS F64 = ddx * ddx + ddy * ddy
            IF dd < 0.0025 THEN
                IF ddx * ddx + ddy * ddy < bbd ORELSE hits = 0 THEN
                    bbd = dd
                    bxs = (x1 + x2) / 2.0
                    bys = (y1 + y2) / 2.0
                END IF
                hits = hits + 1
            END IF
            j = j + 1
        END WHILE
        i = i + 1
    END WHILE
    PRINT "near-intersection samples=" | hits
    LET bx AS S64 = ROUND(bxs * 100.0)
    LET byy AS S64 = ROUND(bys * 100.0)
    PRINT "intersection ~(" | bx | "," | byy | ") x100"
END
