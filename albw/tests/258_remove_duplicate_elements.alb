-- 258 | Remove duplicate elements, preserving first-occurrence order.
BEGIN
    STRICT values[8] AS S32
    STRICT unique[8] AS S32
    LET count AS S32 = 0

    values[0] = 1
    values[1] = 2
    values[2] = 3
    values[3] = 1
    values[4] = 2
    values[5] = 4
    values[6] = 3
    values[7] = 1

    FOR i = 0 TO 7
        LET current AS S32 = values[i]
        LET seen AS S32 = 0
        FOR j = 0 TO count - 1
            IF unique[j] = current THEN
                seen = 1
            END IF
        END FOR
        IF seen = 0 THEN
            unique[count] = current
            count = count + 1
        END IF
    END FOR

    FOR i = 0 TO count - 1
        PRINT unique[i]
    END FOR
END
