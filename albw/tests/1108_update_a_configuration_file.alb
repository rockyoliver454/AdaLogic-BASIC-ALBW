VERSION 1.0

BEGIN
    LET h AS S64 = OPEN("ucfg.ini", "w")
    WRITE h, "mode=dev" | CHR(10) | "level=3" | CHR(10)
    CLOSE h

    LET r AS S64 = OPEN("ucfg.ini", "r")
    LET whole AS STRING = READ(r, FILELEN("ucfg.ini"))
    CLOSE r

    LET res AS STRING = ""
    LET start AS S64 = 1
    LET i AS S64 = 1
    WHILE i <= LEN(whole)
        IF ASC(MID$(whole, i, 1)) = 10 THEN
            LET ln AS STRING = MID$(whole, start, i - start)
            IF LEFT$(ln, 5) = "level" THEN
                res = res | "level=5" | CHR(10)
            ELSE
                res = res | ln | CHR(10)
            END IF
            start = i + 1
        END IF
        i = i + 1
    END WHILE

    LET w AS S64 = OPEN("ucfg.ini", "w")
    WRITE w, res
    CLOSE w

    LET r2 AS S64 = OPEN("ucfg.ini", "r")
    PRINT "updated=" | READ(r2, FILELEN("ucfg.ini"))
    CLOSE r2
END
