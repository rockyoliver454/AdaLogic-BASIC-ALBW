VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET v AS S64 = (x / 8) * 36
            IF v > 255 THEN v = 255 END IF
            img[y * 64 + x] = v * 65536 + v * 256 + v
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Greyscale bars", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(60, 32)
    END

    LISTEN

    PRINT "bars=8 step=36"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(60,32)=" | fpx
END

