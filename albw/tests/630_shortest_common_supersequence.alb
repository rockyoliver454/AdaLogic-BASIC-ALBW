-- 630 | Shortest common supersequence: DP for SCS length of
-- "abcbdab" and "bdcaba".
DECLARE MODULE Scs
    FUNCTION ScsLen(a AS STRING, b AS STRING) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Scs
    STRICT dp[110] AS S64

    FUNCTION ScsLen(a AS STRING, b AS STRING) AS S64
        LET m AS S64 = LEN(a)
        LET n AS S64 = LEN(b)
        FOR i = 0 TO m
            FOR j = 0 TO n
                IF i = 0 THEN
                    dp[j] = j
                ELSE
                    IF j = 0 THEN
                        dp[i * 10 + j] = i
                    ELSE
                        IF MID$(a, i, 1) = MID$(b, j, 1) THEN
                            dp[i * 10 + j] = dp[(i - 1) * 10 + (j - 1)] + 1
                        ELSE
                            LET x AS S64 = dp[(i - 1) * 10 + j]
                            LET y AS S64 = dp[i * 10 + (j - 1)]
                            IF x < y THEN
                                dp[i * 10 + j] = x + 1
                            ELSE
                                dp[i * 10 + j] = y + 1
                            END IF
                        END IF
                    END IF
                END IF
            END FOR
        END FOR
        RETURN dp[m * 10 + n]
    END FUNCTION

    PROCEDURE Run()
        PRINT ScsLen("abcbdab", "bdcaba")
        PRINT ScsLen("algorithm", "rithm")
    END PROCEDURE
END MODULE

IMPORT Scs
BEGIN
    Scs.Run()
END
