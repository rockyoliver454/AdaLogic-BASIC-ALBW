-- 488 | Binomial transform: forward and inverse binomial transform
-- of the first 12 squares (n^2, n = 0..11).
DECLARE MODULE BinT
    FUNCTION Binom(n AS S64, k AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE BinT
    STRICT src[13] AS S64
    STRICT fwd[13] AS S64
    STRICT inv[13] AS S64

    FUNCTION Binom(n AS S64, k AS S64) AS S64
        LET r AS S64 = 1
        FOR i = 1 TO k
            r = r * (n - i + 1) / i
        END FOR
        RETURN r
    END FUNCTION

    PROCEDURE Run()
        FOR i = 0 TO 11
            src[i + 1] = i * i
        END FOR
        FOR n = 0 TO 11
            LET t AS S64 = 0
            FOR k = 0 TO n
                t = t + Binom(n, k) * src[k + 1]
            END FOR
            fwd[n + 1] = t
        END FOR
        LET s AS STRING = "fwd: "
        FOR i2 = 1 TO 12
            s = s | fwd[i2] | " "
        END FOR
        PRINT s
        FOR n2 = 0 TO 11
            LET t2 AS S64 = 0
            FOR k2 = 0 TO n2
                LET term AS S64 = Binom(n2, k2) * fwd[k2 + 1]
                IF (n2 - k2) MOD 2 = 1 THEN t2 = t2 - term ELSE t2 = t2 + term END IF
            END FOR
            inv[n2 + 1] = t2
        END FOR
        LET s2 AS STRING = "inv: "
        FOR i3 = 1 TO 12
            s2 = s2 | inv[i3] | " "
        END FOR
        PRINT s2
    END PROCEDURE
END MODULE

IMPORT BinT
BEGIN
    BinT.Run()
END
