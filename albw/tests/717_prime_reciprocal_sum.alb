-- 717 | Prime reciprocal sum: partial sums of 1/p at
-- increasing bounds, showing the slow divergence.
DECLARE MODULE Pr
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pr
    STRICT sv[100001] AS S32

    PROCEDURE Run()
        FOR i = 0 TO 100000
            sv[i] = 1
        END FOR
        sv[0] = 0
        sv[1] = 0
        LET p AS S64 = 2
        WHILE p * p <= 100000
            IF sv[p] = 1 THEN
                LET m AS S64 = p * p
                WHILE m <= 100000
                    sv[m] = 0
                    m = m + p
                END WHILE
            END IF
            p = p + 1
        END WHILE
        LET s AS F64 = 0.0
        FOR n = 2 TO 100000
            IF sv[n] = 1 THEN
                s = s + 1.0 / n
            END IF
            IF n = 100 ORELSE n = 1000 ORELSE n = 10000 ORELSE n = 100000 THEN
                PRINT "1/p for p<=" | n | ": " | s
            END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Pr
BEGIN
    Pr.Run()
END
