-- 016 | Averages/Median: middle value of a sorted list.
BEGIN
    STRICT a[9] AS F64;
    a[0]=5.0; a[1]=3.0; a[2]=8.0; a[3]=1.0; a[4]=9.0;
    a[5]=2.0; a[6]=7.0; a[7]=4.0; a[8]=6.0;
    FOR i = 0 TO 7
        FOR j = 0 TO 7 - i
            IF a[j] > a[j + 1] THEN
                LET t AS F64 = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            END IF
        END FOR
    END FOR
    PRINT a[4];
END
