-- 471 | Zumkeller numbers: first 40 (abundant numbers whose divisors
-- partition into two sets of equal sum).
DECLARE MODULE Zum
    FUNCTION GetDivs(n AS S64) AS S64
    FUNCTION IsZumk(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Zum
    STRICT divs[256] AS S64
    STRICT reach[100000] AS S32

    FUNCTION GetDivs(n AS S64) AS S64
        LET cnt AS S64 = 0
        FOR d = 1 TO n
            IF n MOD d = 0 THEN
                cnt = cnt + 1
                divs[cnt] = d
            END IF
        END FOR
        RETURN cnt
    END FUNCTION

    FUNCTION IsZumk(n AS S64) AS S32
        LET nd AS S64 = GetDivs(n)
        LET total AS S64 = 0
        FOR i = 1 TO nd
            total = total + divs[i]
        END FOR
        IF total MOD 2 = 1 THEN RETURN 0 END IF
        IF total < 2 * n THEN RETURN 0 END IF
        LET half AS S64 = total / 2
        FOR j = 0 TO half
            reach[j] = 0
        END FOR
        reach[0] = 1
        FOR i2 = 1 TO nd
            LET dj AS S64 = divs[i2]
            LET v AS S64 = half
            WHILE v >= dj
                IF reach[v - dj] = 1 THEN reach[v] = 1 END IF
                v = v - 1
            END WHILE
        END FOR
        IF reach[half] = 1 THEN RETURN 1 END IF
        RETURN 0
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET n AS S64 = 1
        LET got AS S64 = 0
        WHILE got < 40
            IF IsZumk(n) = 1 THEN
                s = s | n | " "
                got = got + 1
            END IF
            n = n + 1
        END WHILE
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Zum
BEGIN
    Zum.Run()
END
