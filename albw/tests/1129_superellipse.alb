VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0

BEGIN
    LET a AS F64 = 28.0
    LET b AS F64 = 20.0
    LET n AS F64 = 2.5
    LET t AS S64 = 0
    WHILE t < 720
        LET tf AS F64 = t * 0.008726646259971647
        LET ca AS F64 = COS(tf)
        LET sa AS F64 = SIN(tf)
        LET xa AS F64 = 0.0
        LET ya AS F64 = 0.0
        IF ca < 0.0 THEN xa = 0.0 - a * (0.0 - ca) ^ (2.0 / n) ELSE xa = a * ca ^ (2.0 / n) END IF
        IF sa < 0.0 THEN ya = 0.0 - b * (0.0 - sa) ^ (2.0 / n) ELSE ya = b * sa ^ (2.0 / n) END IF
        LET px AS S64 = ROUND(32.0 + xa)
        LET py AS S64 = ROUND(32.0 + ya)
        img[py * 64 + px] = 16776960
        t = t + 1
    END WHILE

    CREATE_WINDOW "Superellipse", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "n=2.5 a=28 b=20"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
