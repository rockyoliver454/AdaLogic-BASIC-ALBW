-- 568 | Knuth's algorithm S: select 3 of 10 items in one pass with
-- deterministic LCG; verify selection is in-order and unique.
DECLARE MODULE AlgS
    PROCEDURE Run()
END DECLARE MODULE

MODULE AlgS
    STRICT chosen[10] AS S32
    STRICT st[1] AS S64

    FUNCTION NextRand(m AS S64) AS S64
        st[1] = (st[1] * 1103515245 + 12345) MOD 2147483648
        RETURN st[1] MOD m
    END FUNCTION

    PROCEDURE Run()
        st[1] = 7
        LET need AS S64 = 3
        LET left AS S64 = 10
        FOR i = 1 TO 10
            chosen[i] = 0
        END FOR
        FOR t = 1 TO 10
            IF NextRand(left) < need THEN
                chosen[t] = 1
                need = need - 1
            END IF
            left = left - 1
        END FOR
        LET s AS STRING = ""
        FOR k = 1 TO 10
            IF chosen[k] = 1 THEN s = s | k | " " END IF
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT AlgS
BEGIN
    AlgS.Run()
END
