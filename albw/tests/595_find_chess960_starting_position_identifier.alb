-- 595 | Find Chess960 starting position identifier: invert the
-- arrangement RNBQKBNR... compute SP-ID for the traditional
-- layout (518) and BBQNNRKR (0-based variant example).
DECLARE MODULE C960I
    FUNCTION Id() AS S64
    PROCEDURE Setup(s AS STRING)
    PROCEDURE Run()
END DECLARE MODULE

MODULE C960I
    STRICT pos[8] AS STRING

    PROCEDURE Setup(s AS STRING)
        FOR i = 0 TO 7
            pos[i] = MID$(s, i + 1, 1)
        END FOR
    END PROCEDURE

    FUNCTION Id() AS S64
        -- bishops
        LET b1 AS S64 = -1
        LET b2 AS S64 = -1
        FOR p = 0 TO 7
            IF pos[p] = "B" THEN
                IF p MOD 2 = 0 THEN b1 = p / 2 END IF
                IF p MOD 2 = 1 THEN b2 = p / 2 END IF
            END IF
        END FOR
        -- queen position among free squares
        LET qc AS S64 = 0
        LET q AS S64 = -1
        FOR f = 0 TO 7
            IF pos[f] <> "B" THEN
                IF pos[f] = "Q" THEN q = qc END IF
                qc = qc + 1
            END IF
        END FOR
        -- knight pair index among remaining squares
        LET cnt AS S64 = 0
        LET n1 AS S64 = -1
        LET n2 AS S64 = -1
        FOR g = 0 TO 7
            IF pos[g] <> "B" ANDALSO pos[g] <> "Q" THEN
                IF pos[g] = "N" THEN
                    IF n1 < 0 THEN n1 = cnt ELSE n2 = cnt END IF
                END IF
                cnt = cnt + 1
            END IF
        END FOR
        -- map (n1,n2) -> k in {0..9}: pairs (0,1)(0,2)(0,3)(0,4)
        -- (1,2)(1,3)(1,4)(2,3)(2,4)(3,4)
        LET k AS S64 = n1 * 5 - n1 * (n1 + 1) / 2 + n2 - n1 - 1
        RETURN (((k * 6) + q) * 4 + b1) * 4 + b2
    END FUNCTION

    PROCEDURE Run()
        Setup("RNBQKBNR")
        PRINT "RNBQKBNR -> " | Id()
        Setup("BQNBNRKR")
        PRINT "BQNBNRKR -> " | Id()
    END PROCEDURE
END MODULE

IMPORT C960I
BEGIN
    C960I.Run()
END
