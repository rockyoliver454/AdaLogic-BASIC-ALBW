-- 971 | Blum integer: n = p*q where p,q are distinct primes
-- both congruent 3 mod 4. Test candidates and list Blums.
DECLARE MODULE Bi
    PROCEDURE Run()
END DECLARE MODULE

MODULE Bi
    FUNCTION IsP(x AS S64) AS S64
        IF x < 2 THEN RETURN 0 END IF
        LET i AS S64 = 2
        WHILE i * i <= x
            IF x MOD i = 0 THEN RETURN 0 END IF
            i = i + 1
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        FOR n = 1 TO 200
            FOR p = 2 TO n - 1
                IF n MOD p = 0 THEN
                    LET q AS S64 = n / p
                    IF p < q ANDALSO IsP(p) = 1 ANDALSO IsP(q) = 1 THEN
                        IF p MOD 4 = 3 ANDALSO q MOD 4 = 3 THEN
                            PRINT n | " = " | p | "*" | q | " blum"
                        END IF
                    END IF
                END IF
            END FOR
        END FOR
        PRINT "done"
    END PROCEDURE
END MODULE

IMPORT Bi
BEGIN
    Bi.Run()
END
