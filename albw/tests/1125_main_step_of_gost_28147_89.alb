    SB[57] = 4
    SB[58] = 6
    SB[59] = 12
    SB[60] = 11
    SB[61] = 2
    SB[62] = 5
    SB[63] = 3
    SB[64] = 6
    SB[65] = 12
    SB[66] = 7
    SB[67] = 1
    SB[68] = 5
    SB[69] = 15
    SB[70] = 13
    SB[71] = 8
    SB[72] = 4
    SB[73] = 10
