    SB[98] = 4
    SB[99] = 1
    SB[100] = 3
    SB[101] = 15
    SB[102] = 5
    SB[103] = 9
    SB[104] = 0
    SB[105] = 10
    SB[106] = 14
    SB[107] = 7
    SB[108] = 6
    SB[109] = 8
    SB[110] = 2
    SB[111] = 12
    SB[112] = 1
    SB[113] = 15
    SB[114] = 13
    SB[115] = 0
    SB[116] = 5
    SB[117] = 7
    SB[118] = 10
    SB[119] = 4
    SB[120] = 9
    SB[121] = 2
    SB[122] = 3
    SB[123] = 14
    SB[124] = 6
    SB[125] = 11
    SB[126] = 8
    SB[127] = 12

    LET n1 AS S64 = $043B0421
    LET n2 AS S64 = $04320430
    LET x AS S64 = $E2C104F9

    LET s AS S64 = (n1 + x) MOD 4294967296
    LET ns AS S64 = 0
    i = 0
    WHILE i < 4
        LET cell AS S64 = (s / P2[i * 8]) MOD 256
        LET lo AS S64 = cell MOD 16
        LET hi AS S64 = cell / 16
        LET nb AS S64 = SB[i * 32 + lo] + SB[i * 32 + 16 + hi] * 16
        ns = ns + nb * P2[i * 8]
        i = i + 1
    END WHILE

    LET rol AS S64 = ((ns * 2048) MOD 4294967296) + ns / 2097152
    LET r0 AS S64 = rol XOR n2
    LET r1 AS S64 = n1

    PRINT "n1=" | r0
    PRINT "n2=" | r1
    PRINT "n1 hex=" | "07cf881f expected"
    PRINT "match=" | (r0 = $07CF881F)
END
