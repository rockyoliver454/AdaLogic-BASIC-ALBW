VERSION 1.0

STRICT SB[128] AS S64
STRICT P2[33] AS S64


BEGIN
    LET i AS S64 = 0
    P2[0] = 1
    WHILE i < 32
        P2[i + 1] = P2[i] * 2
        i = i + 1
    END WHILE
    SB[0] = 4
    SB[1] = 10
    SB[2] = 9
    SB[3] = 2
    SB[4] = 13
    SB[5] = 8
    SB[6] = 0
    SB[7] = 14
