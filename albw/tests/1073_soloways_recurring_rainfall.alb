VERSION 1.0

STRICT img[4096] AS S32
STRICT colh[16] AS S64

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION


BEGIN
    LET c AS S64 = 0
    WHILE c < 16
        colh[c] = 60
        c = c + 1
    END WHILE
    sd = 777
    LET evap AS S64 = 0
    WHILE evap < 14
        c = 0
        WHILE c < 16
            IF Nxt() MOD 4 = 0 ANDALSO colh[c] > 6 THEN
                colh[c] = colh[c] - 1
            END IF
            IF Nxt() MOD 5 = 0 ANDALSO colh[c] > 0 THEN
                LET nb AS S64 = (c + 1) MOD 16
                IF colh[nb] < 62 THEN colh[nb] = colh[nb] + 1 END IF
            END IF
            c = c + 1
        END WHILE
        evap = evap + 1
    END WHILE

    c = 0
    WHILE c < 16
        LET y AS S64 = colh[c]
        WHILE y < 64
            LET x AS S64 = c * 4
            WHILE x < c * 4 + 3
                img[y * 64 + x] = 16763904
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
        c = c + 1
    END WHILE

    CREATE_WINDOW "Soloway rainfall", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "cycles=14 cols=16"
    c = 0
    WHILE c < 16
        PRINT "h" | c | "=" | colh[c]
        c = c + 1
    END WHILE
    PRINT "ink=" | ink
    PRINT "hitpx=" | fpx
END
