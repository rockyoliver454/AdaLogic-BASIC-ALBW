-- 371 | Ormiston pairs: consecutive primes that are digit anagrams; first 15.
DECLARE MODULE Ormiston
    FUNCTION IsPrime(n AS S64) AS S32
    FUNCTION DigitKey(n AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Ormiston
    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        IF n = 2 THEN RETURN 1 END IF
        IF n MOD 2 = 0 THEN RETURN 0 END IF
        LET d AS S64 = 3
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 2
        END WHILE
        RETURN 1
    END FUNCTION

    FUNCTION DigitKey(n AS S64) AS S64
        LET m AS S64 = n
        LET sig AS S64 = 0
        WHILE m > 0
            LET dig AS S64 = m MOD 10
            sig = sig + (2 ^ dig)
            m = m / 10
        END WHILE
        RETURN sig
    END FUNCTION

    PROCEDURE Run()
        LET found AS S32 = 0
        LET prev AS S64 = 2
        LET n AS S64 = 3
        WHILE found < 15
            IF IsPrime(n) = 1 THEN
                IF DigitKey(prev) = DigitKey(n) THEN
                    PRINT prev | " " | n
                    found = found + 1
                END IF
                prev = n
            END IF
            n = n + 1
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Ormiston
BEGIN
    Ormiston.Run()
END
