VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET i AS S64 = 0
    WHILE i < 4096
        img[i] = 255
        i = i + 1
    END WHILE
    LET y AS S64 = 8
    WHILE y < 56
        img[y * 64 + 8] = 16711680
        img[y * 64 + 56] = 16711680
        y = y + 1
    END WHILE
    LET x AS S64 = 8
    WHILE x < 56
        img[8 * 64 + x] = 16711680
        img[56 * 64 + x] = 16711680
        x = x + 1
    END WHILE
    img[32 * 64 + 32] = 65280

    CREATE_WINDOW "Bitmap", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(32, 32)
    END

    LISTEN

    PRINT "w=64 h=64"
    PRINT "getpx(32,32)=" | img[32 * 64 + 32]
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(32,32)=" | fpx
END
