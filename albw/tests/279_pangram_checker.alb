-- 279 | Pangram checker: does a sentence contain every letter a..z?
BEGIN
    STRICT sentences[2] AS STRING
    sentences[0] = "The quick brown fox jumps over the lazy dog"
    sentences[1] = "The quick brown fox jumped over the lazy dog"

    FOR s = 0 TO 1
        LET sentence AS STRING = sentences[s]
        STRICT seen[26] AS S32
        FOR i = 0 TO 25
            seen[i] = 0
        END FOR
        FOR i = 1 TO LEN(sentence)
            LET c AS S32 = ASC(MID$(sentence, i, 1))
            IF c >= 65 ANDALSO c <= 90 THEN c = c + 32 END IF
            IF c >= 97 ANDALSO c <= 122 THEN seen[c - 97] = 1 END IF
        END FOR
        LET ok AS S32 = 1
        FOR i = 0 TO 25
            IF seen[i] = 0 THEN ok = 0 END IF
        END FOR
        PRINT ok
    END FOR
END
