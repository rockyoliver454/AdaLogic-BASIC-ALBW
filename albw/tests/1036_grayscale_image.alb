VERSION 1.0

STRICT img[4096] AS S32
STRICT gry[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET r AS S64 = (x * 4) MOD 256
            LET g AS S64 = (y * 4) MOD 256
            LET b AS S64 = ((x + y) * 2) MOD 256
            img[y * 64 + x] = r * 65536 + g * 256 + b
            LET lum AS S64 = (r * 299 + g * 587 + b * 114) / 1000
            gry[y * 64 + x] = lum * 65536 + lum * 256 + lum
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Grayscale image", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            COLOR gry[k]
            PLOT k MOD 64, k / 64
            ink = ink + 1
            chk = chk + gry[k] / 256
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(40, 20)
    END

    LISTEN

    PRINT "ink=" | ink
    PRINT "lumsum=" | chk
    PRINT "px(40,20)=" | fpx
END
