-- 234 | Priority queue: array-backed binary min-heap.
DECLARE MODULE PriorityQueue
    PROCEDURE Push(value AS S32)
    FUNCTION Pop() AS S32
    FUNCTION Count() AS S32
END DECLARE MODULE

MODULE PriorityQueue
    STRICT heap[32] AS S32
    LET heap_count AS S32 = 0

    PROCEDURE Push(value AS S32)
        LET pos AS S32 = heap_count
        heap[pos] = value
        heap_count = heap_count + 1
        WHILE pos > 0
            LET parent_pos AS S32 = (pos - 1) / 2
            IF heap[parent_pos] <= heap[pos] THEN BREAK END IF
            LET temporary AS S32 = heap[parent_pos]
            heap[parent_pos] = heap[pos]
            heap[pos] = temporary
            pos = parent_pos
        END WHILE
    END PROCEDURE

    FUNCTION Pop() AS S32
        LET answer AS S32 = heap[0]
        heap_count = heap_count - 1
        heap[0] = heap[heap_count]
        LET pos AS S32 = 0
        WHILE pos * 2 + 1 < heap_count
            LET child_pos AS S32 = pos * 2 + 1
            IF child_pos + 1 < heap_count ANDALSO heap[child_pos + 1] < heap[child_pos] THEN
                child_pos = child_pos + 1
            END IF
            IF heap[pos] <= heap[child_pos] THEN BREAK END IF
            LET temporary AS S32 = heap[pos]
            heap[pos] = heap[child_pos]
            heap[child_pos] = temporary
            pos = child_pos
        END WHILE
        RETURN answer
    END FUNCTION

    FUNCTION Count() AS S32
        RETURN heap_count
    END FUNCTION
END MODULE

IMPORT PriorityQueue
BEGIN
    PriorityQueue.Push(5)
    PriorityQueue.Push(1)
    PriorityQueue.Push(4)
    PriorityQueue.Push(2)
    PriorityQueue.Push(3)
    WHILE PriorityQueue.Count() > 0
        PRINT PriorityQueue.Pop()
    END WHILE
END
