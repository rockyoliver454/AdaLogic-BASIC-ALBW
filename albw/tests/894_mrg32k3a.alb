-- 894 | Pseudo-random numbers/Combined recursive generator
-- MRG32k3a (L'Ecuyer): two coupled recurrences mod m1/m2.
-- With all seeds = 12345 the first outputs are the published
-- test vector 1070006716, 3794354846, 657923608, ...
DECLARE MODULE Mr
    FUNCTION Nxt() AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Mr
    STRICT s1[4] AS S64
    STRICT s2[4] AS S64

    FUNCTION Nxt() AS S64
        LET p1 AS S64 = 1403580 * s1[2] - 810728 * s1[1]
        p1 = p1 MOD 4294967087
        IF p1 < 0 THEN p1 = p1 + 4294967087 END IF
        s1[1] = s1[2]
        s1[2] = s1[3]
        s1[3] = p1
        LET p2 AS S64 = 527612 * s2[3] - 1370589 * s2[1]
        p2 = p2 MOD 4294944443
        IF p2 < 0 THEN p2 = p2 + 4294944443 END IF
        s2[1] = s2[2]
        s2[2] = s2[3]
        s2[3] = p2
        IF p1 <= p2 THEN RETURN p1 - p2 + 4294967087 END IF
        RETURN p1 - p2
    END FUNCTION

    PROCEDURE Run()
        s1[1] = 12345
        s1[2] = 12345
        s1[3] = 12345
        s2[1] = 12345
        s2[2] = 12345
        s2[3] = 12345
        FOR i = 1 TO 5
            PRINT Nxt()
        END FOR
    END PROCEDURE
END MODULE

IMPORT Mr
BEGIN
    Mr.Run()
END
