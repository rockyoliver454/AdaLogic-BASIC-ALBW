-- 136 | Knapsack bounded: limited copies of each item.
BEGIN
    STRICT wt[3] AS S32;
    STRICT vl[3] AS S32;
    STRICT ct[3] AS S32;
    wt[0]=3; vl[0]=4; ct[0]=2;
    wt[1]=4; vl[1]=5; ct[1]=1;
    wt[2]=2; vl[2]=3; ct[2]=3;
    LET cap AS S32 = 10;
    STRICT dp[11] AS S32;
    FOR i = 0 TO 2
        LET w AS S32 = cap;
        WHILE w >= wt[i]
            FOR k = 1 TO ct[i]
                IF w >= k * wt[i] THEN
                    LET cand AS S32 = dp[w - k * wt[i]] + k * vl[i];
                    IF cand > dp[w] THEN
                        dp[w] = cand;
                    END IF
                END IF
            END FOR
            w = w - 1;
        END WHILE
    END FOR
    PRINT dp[cap];
END
