-- 706 | Wilson primes of order n: p^2 divides
-- (n-1)!*(p-n)! - (-1)^n, for n = 1..3, p < 10000.
DECLARE MODULE Wp
    FUNCTION Factm(a AS S64, m AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Wp
    FUNCTION Factm(a AS S64, m AS S64) AS S64
        -- a! mod m
        IF a < 2 THEN RETURN 1 END IF
        LET r AS S64 = 1
        FOR i = 2 TO a
            r = r * i MOD m
        END FOR
        RETURN r
    END FUNCTION

    PROCEDURE Run()
        FOR n = 1 TO 3
            LET res AS STRING = ""
            FOR p = 2 TO 9999
                LET isp AS S32 = 1
                LET d AS S64 = 2
                WHILE d * d <= p
                    IF p MOD d = 0 THEN isp = 0 END IF
                    d = d + 1
                END WHILE
                IF isp = 1 ANDALSO p >= n THEN
                    LET p2 AS S64 = p * p
                    LET f1 AS S64 = Factm(n - 1, p2)
                    LET f2 AS S64 = Factm(p - n, p2)
                    LET sgn AS S64 = 0 - 1
                    IF n MOD 2 = 0 THEN sgn = 1 END IF
                    LET w AS S64 = (f1 * f2 - sgn) MOD p2
                    IF w < 0 THEN w = w + p2 END IF
                    IF w = 0 THEN
                        IF res = "" THEN
                            res = p | ""
                        ELSE
                            res = res | " " | p
                        END IF
                    END IF
                END IF
            END FOR
            PRINT "n=" | n | ": " | res
        END FOR
    END PROCEDURE
END MODULE

IMPORT Wp
BEGIN
    Wp.Run()
END
