VERSION 1.0

STRICT wcnt[3] AS S64


FUNCTION Corr(w AS STRING) AS S64
    LET a AS S64 = 0
    LET b AS S64 = 0
    LET c AS S64 = 0
    LET i AS S64 = 1
    LET wl AS S64 = LEN(w)
    WHILE i <= wl
        LET ch AS S64 = ASC(MID$(w, i, 1))
        IF ch = 97 THEN
            a = a + 1
        ELSE
            IF ch = 98 THEN
                b = b + 1
            ELSE
                IF ch = 99 THEN
                    c = c + 1
                END IF
            END IF
        END IF
        i = i + 1
    END WHILE
    IF a = b ANDALSO b = c THEN
        RETURN 1
    END IF
    RETURN 0
END FUNCTION


BEGIN
    PRINT "aabbcc  -> " | Corr("aabbcc")
    PRINT "abcabc  -> " | Corr("abcabc")
    PRINT "aabbc   -> " | Corr("aabbc")
    PRINT "xaybzcq -> " | Corr("xaybzcq")
    PRINT "empty   -> " | Corr("")
    PRINT "noabc   -> " | Corr("hello")
END
