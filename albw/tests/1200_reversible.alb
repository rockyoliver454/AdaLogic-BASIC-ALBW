-- Reversible ops: every op has a computable inverse. REV* ops are
-- FASM-parity restricted to REVERSIBLE blocks.
LET a AS S64 = 5
LET b AS S64 = 9
REVERSIBLE
  REVADD a, 3
  REVXOR b, 255
  REVSWAP a, b
END REVERSIBLE
PRINT a
PRINT b
REVERSIBLE
  REVADD a, 7
END REVERSIBLE
PRINT a
REVERSIBLE
  REVNOT a
END REVERSIBLE
PRINT a
REVERSIBLE
  REVNEG a
END REVERSIBLE
PRINT a
REVERSIBLE
  REVROL b, 2
END REVERSIBLE
PRINT b
REVERSIBLE
  REVROR b, 2
END REVERSIBLE
PRINT b
REVERSIBLE
  REVSUB b, 8
END REVERSIBLE
PRINT b
