VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET ang AS S64 = 30
LET bx AS S64 = 0
LET byy AS S64 = 0


BEGIN
    LET af AS F64 = ang * 1.0
    LET sx AS F64 = SIN(af * 0.017453292519943295)
    LET cy AS F64 = COS(af * 0.017453292519943295)
    bx = ROUND(32.0 + sx * 20.0)
    byy = ROUND(6.0 + cy * 20.0)
    LET steps AS S64 = 0
    WHILE steps < 22
        LET px AS S64 = 32 + (bx - 32) * steps / 22
        LET py AS S64 = 6 + (byy - 6) * steps / 22
        img[py * 64 + px] = 16777215
        steps = steps + 1
    END WHILE
    LET yy AS S64 = 0
    WHILE yy < 3
        LET xx AS S64 = 0
        WHILE xx < 3
            img[(byy + yy) * 64 + bx + xx - 1] = 16711680
            xx = xx + 1
        END WHILE
        yy = yy + 1
    END WHILE

    CREATE_WINDOW "Animate a pendulum", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "angle=30 len=20"
    PRINT "bob=(" | bx | "," | byy | ")"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
