-- Rosetta: selection sort.
BEGIN
    STRICT a[8] AS S32
    a[0] = 5
    a[1] = 2
    a[2] = 9
    a[3] = 1
    a[4] = 7
    a[5] = 3
    a[6] = 8
    a[7] = 4
    FOR i = 0 TO 6
        LET m AS S32 = i
        FOR j = i + 1 TO 7
            IF a[j] < a[m] THEN
                m = j
            END IF
        END FOR
        IF m <> i THEN
            LET t AS S32 = a[i]
            a[i] = a[m]
            a[m] = t
        END IF
    END FOR
    FOR i = 0 TO 7
        PRINT a[i]
    END FOR
END
