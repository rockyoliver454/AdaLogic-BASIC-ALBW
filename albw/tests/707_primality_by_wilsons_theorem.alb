-- 707 | Primality by Wilson's theorem: n prime iff
-- (n-1)! = -1 (mod n). Verdicts for n = 2..20.
DECLARE MODULE Wt
    PROCEDURE Run()
END DECLARE MODULE

MODULE Wt
    PROCEDURE Run()
        FOR n = 2 TO 20
            LET f AS S64 = 1
            FOR i = 2 TO n - 1
                f = f * i MOD n
            END FOR
            LET verdict AS S32 = 0
            IF f = n - 1 THEN verdict = 1 END IF
            PRINT n | ": " | verdict
        END FOR
    END PROCEDURE
END MODULE

IMPORT Wt
BEGIN
    Wt.Run()
END
