-- 532 | Permutations/Rank of a permutation: rank and unrank for
-- permutations of {0..3} (Myrvold-Ruskey).
DECLARE MODULE RankP
    FUNCTION Fact(n AS S64) AS S64
    FUNCTION Rank(a1 AS S64, a2 AS S64, a3 AS S64, a4 AS S64) AS S64
    PROCEDURE Unrank(r AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE RankP
    STRICT used[4] AS S32
    STRICT unr[4] AS S64

    FUNCTION Fact(n AS S64) AS S64
        LET r AS S64 = 1
        FOR i = 2 TO n
            r = r * i
        END FOR
        RETURN r
    END FUNCTION

    FUNCTION Rank(a1 AS S64, a2 AS S64, a3 AS S64, a4 AS S64) AS S64
        LET cnt AS S64 = 0
        IF a1 > a2 THEN cnt = cnt + 1 END IF
        IF a1 > a3 THEN cnt = cnt + 1 END IF
        IF a1 > a4 THEN cnt = cnt + 1 END IF
        LET r AS S64 = cnt * Fact(3)
        cnt = 0
        IF a2 > a3 THEN cnt = cnt + 1 END IF
        IF a2 > a4 THEN cnt = cnt + 1 END IF
        r = r + cnt * Fact(2)
        cnt = 0
        IF a3 > a4 THEN cnt = 1 END IF
        RETURN r + cnt
    END FUNCTION

    PROCEDURE Unrank(r AS S64)
        FOR i = 0 TO 3
            used[i] = 0
        END FOR
        FOR pos = 1 TO 4
            LET rem AS S64 = 4 - pos
            LET c AS S64 = 0
            IF rem > 0 THEN c = r / Fact(rem) END IF
            IF rem > 0 THEN r = r MOD Fact(rem) END IF
            LET seen AS S64 = -1
            FOR v = 0 TO 3
                IF used[v] = 0 THEN
                    seen = seen + 1
                    IF seen = c THEN
                        unr[pos] = v
                        used[v] = 1
                    END IF
                END IF
            END FOR
        END FOR
    END PROCEDURE

    PROCEDURE Run()
        PRINT "rank(0,1,2,3) = " | Rank(0, 1, 2, 3)
        PRINT "rank(3,2,1,0) = " | Rank(3, 2, 1, 0)
        PRINT "rank(1,3,0,2) = " | Rank(1, 3, 0, 2)
        Unrank(0)
        PRINT "unrank(0) = " | unr[1] | unr[2] | unr[3] | unr[4]
        Unrank(23)
        PRINT "unrank(23) = " | unr[1] | unr[2] | unr[3] | unr[4]
        Unrank(13)
        PRINT "unrank(13) = " | unr[1] | unr[2] | unr[3] | unr[4]
    END PROCEDURE
END MODULE

IMPORT RankP
BEGIN
    RankP.Run()
END
