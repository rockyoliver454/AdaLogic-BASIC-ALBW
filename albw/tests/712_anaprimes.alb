-- 712 | Anaprimes (permutable primes): primes whose every
-- digit permutation is prime. Below 1000.
DECLARE MODULE An
    PROCEDURE Run()
END DECLARE MODULE

MODULE An
    STRICT sv[1000] AS S32
    STRICT cntd[10] AS S64
    STRICT c2[10] AS S64

    PROCEDURE Run()
        FOR i = 0 TO 999
            sv[i] = 1
        END FOR
        sv[0] = 0
        sv[1] = 0
        LET p AS S64 = 2
        WHILE p * p <= 999
            IF sv[p] = 1 THEN
                LET m AS S64 = p * p
                WHILE m <= 999
                    sv[m] = 0
                    m = m + p
                END WHILE
            END IF
            p = p + 1
        END WHILE
        FOR n = 2 TO 999
            IF sv[n] = 1 THEN
                -- count digits; any zero/even/5 digit in a
                -- multi-digit number can move to the units slot
                FOR t = 0 TO 9
                    cntd[t] = 0
                END FOR
                LET v AS S64 = n
                LET ok AS S32 = 1
                LET nd AS S64 = 0
                WHILE v > 0
                    LET d AS S64 = v MOD 10
                    cntd[d] = cntd[d] + 1
                    nd = nd + 1
                    v = v / 10
                END WHILE
                IF nd > 1 THEN
                    IF cntd[0] > 0 THEN ok = 0 END IF
                    IF cntd[2] > 0 THEN ok = 0 END IF
                    IF cntd[4] > 0 THEN ok = 0 END IF
                    IF cntd[5] > 0 THEN ok = 0 END IF
                    IF cntd[6] > 0 THEN ok = 0 END IF
                    IF cntd[8] > 0 THEN ok = 0 END IF
                    -- even digit-sum count of 3/9 repeated check:
                    -- remaining candidates permute to all combos;
                    -- verify a few canonical permutations directly
                    IF ok = 1 THEN
                        -- all digits in {1,3,7,9}; check each
                        -- digit multiset's critical permutations
                        -- by testing all values sharing the count
                        -- signature below 1000 via rescan
                        FOR m2 = 2 TO 999
                            IF m2 <> n ANDALSO sv[m2] = 0 THEN
                                -- check same digit multiset
                                FOR t2 = 0 TO 9
                                    c2[t2] = 0
                                END FOR
                                LET w AS S64 = m2
                                WHILE w > 0
                                    c2[w MOD 10] = c2[w MOD 10] + 1
                                    w = w / 10
                                END WHILE
                                LET same AS S32 = 1
                                FOR t3 = 0 TO 9
                                    IF c2[t3] <> cntd[t3] THEN same = 0 END IF
                                END FOR
                                IF same = 1 THEN ok = 0 END IF
                            END IF
                        END FOR
                    END IF
                END IF
                IF ok = 1 THEN PRINT n END IF
            END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT An
BEGIN
    An.Run()
END
