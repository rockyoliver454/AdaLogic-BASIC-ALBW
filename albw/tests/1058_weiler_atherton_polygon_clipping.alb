VERSION 1.0

STRICT sx[8] AS S64
STRICT sy[8] AS S64
STRICT ox[8] AS S64
STRICT oy[8] AS S64
STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET nv AS S64 = 0
LET no AS S64 = 0

PROCEDURE ClipX(xl AS S64)
    no = 0
    LET i AS S64 = 0
    WHILE i < nv
        LET j AS S64 = (i + 1) MOD nv
        LET xi AS S64 = sx[i]
        LET yi AS S64 = sy[i]
        LET xj AS S64 = sx[j]
        LET yj AS S64 = sy[j]
        IF xi >= xl THEN
            ox[no] = xi oy[no] = yi no = no + 1
        END IF
        IF (xi >= xl ANDALSO xj < xl) ORELSE (xi < xl ANDALSO xj >= xl) THEN
            LET t AS S64 = ((xl - xi) * 1000) / (xj - xi)
            ox[no] = xl
            oy[no] = yi + ((yj - yi) * t) / 1000
            no = no + 1
        END IF
        i = i + 1
    END WHILE
    nv = no
    i = 0
    WHILE i < nv
        sx[i] = ox[i] sy[i] = oy[i]
        i = i + 1
    END WHILE
END PROCEDURE

PROCEDURE ClipY(yl AS S64)
    no = 0
    LET i AS S64 = 0
    WHILE i < nv
        LET j AS S64 = (i + 1) MOD nv
        LET xi AS S64 = sx[i]
        LET yi AS S64 = sy[i]
        LET xj AS S64 = sx[j]
        LET yj AS S64 = sy[j]
        IF yi >= yl THEN
            ox[no] = xi oy[no] = yi no = no + 1
        END IF
        IF (yi >= yl ANDALSO yj < yl) ORELSE (yi < yl ANDALSO yj >= yl) THEN
            LET t AS S64 = ((yl - yi) * 1000) / (yj - yi)
            ox[no] = xi + ((xj - xi) * t) / 1000
            oy[no] = yl
            no = no + 1
        END IF
        i = i + 1
    END WHILE
    nv = no
    i = 0
    WHILE i < nv
        sx[i] = ox[i] sy[i] = oy[i]
        i = i + 1
    END WHILE
END PROCEDURE


BEGIN
    sx[0] = 8 sy[0] = 12
    sx[1] = 52 sy[1] = 8
    sx[2] = 56 sy[2] = 44
    sx[3] = 20 sy[3] = 58
    nv = 4
    CALL ClipX(16)
    CALL ClipY(16)

    LET i AS S64 = 0
    WHILE i < nv
        LET j AS S64 = (i + 1) MOD nv
        LET ax AS S64 = sx[i]
        LET ay AS S64 = sy[i]
        LET bx AS S64 = sx[j]
        LET byv AS S64 = sy[j]
        LET s AS S64 = 0
        WHILE s < 40
            LET px AS S64 = ax + (bx - ax) * s / 40
            LET py AS S64 = ay + (byv - ay) * s / 40
            IF px >= 0 ANDALSO px < 64 ANDALSO py >= 0 ANDALSO py < 64 THEN
                img[py * 64 + px] = 16776960
            END IF
            s = s + 1
        END WHILE
        i = i + 1
    END WHILE

    CREATE_WINDOW "Weiler-Atherton clip", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "clipped_verts=" | nv
    i = 0
    WHILE i < nv
        PRINT "v" | i | "=(" | sx[i] | "," | sy[i] | ")"
        i = i + 1
    END WHILE
    PRINT "ink=" | ink
    PRINT "hitpx=" | fpx
END
