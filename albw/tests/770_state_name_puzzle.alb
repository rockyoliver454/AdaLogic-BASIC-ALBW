-- 770 | State name puzzle: split US state names into two
-- groups sharing no letters, maximizing total membership.
DECLARE MODULE Sp
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sp
    STRICT nm[51] AS STRING
    STRICT msk[51] AS S64
    STRICT bg1[1] AS S64
    STRICT bg2[1] AS S64
    STRICT bn[1] AS S64

    PROCEDURE Run()
        LET raw AS STRING = "alabama,alaska,arizona,arkansas,california,colorado,connecticut,delaware,florida,georgia,hawaii,idaho,illinois,indiana,iowa,kansas,kentucky,louisiana,maine,maryland,massachusetts,michigan,minnesota,mississippi,missouri,montana,nebraska,nevada,new hampshire,new jersey,new mexico,new york,north carolina,north dakota,ohio,oklahoma,oregon,pennsylvania,rhode island,south carolina,south dakota,tennessee,texas,utah,vermont,virginia,washington,west virginia,wisconsin,wyoming"
        LET nn AS S64 = 0
        LET i AS S64 = 1
        WHILE i <= LEN(raw)
            LET w AS STRING = ""
            WHILE i <= LEN(raw) ANDALSO MID$(raw, i, 1) <> ","
                w = w | MID$(raw, i, 1)
                i = i + 1
            END WHILE
            nn = nn + 1
            nm[nn] = w
            LET m AS S64 = 0
            FOR c = 1 TO LEN(w)
                LET cd AS S64 = ASC(MID$(w, c, 1))
                IF cd >= 97 ANDALSO cd <= 122 THEN
                    m = m OR 2 ^ (cd - 97)
                END IF
            END FOR
            msk[nn] = m
            i = i + 1
        END WHILE
        -- closure expansion from each seed state
        bn[1] = 0
        FOR seed = 1 TO nn
            LET l1 AS S64 = msk[seed]
            LET moved AS S32 = 1
            WHILE moved = 1
                moved = 0
                -- l2 = union of all states disjoint from l1
                LET l2 AS S64 = 0
                FOR k = 1 TO nn
                    IF (msk[k] AND l1) = 0 THEN l2 = l2 OR msk[k] END IF
                END FOR
                -- l1' = union of all states disjoint from l2
                LET nl1 AS S64 = 0
                FOR k = 1 TO nn
                    IF (msk[k] AND l2) = 0 THEN nl1 = nl1 OR msk[k] END IF
                END FOR
                IF nl1 <> l1 THEN
                    l1 = nl1
                    moved = 1
                END IF
            END WHILE
            LET l2 AS S64 = 0
            FOR k = 1 TO nn
                IF (msk[k] AND l1) = 0 THEN l2 = l2 OR msk[k] END IF
            END FOR
            LET ca AS S64 = 0
            LET cb AS S64 = 0
            FOR k = 1 TO nn
                IF (msk[k] AND l1) = msk[k] THEN ca = ca + 1 END IF
                IF (msk[k] AND l2) = msk[k] THEN cb = cb + 1 END IF
            END FOR
            IF ca + cb > bn[1] THEN
                bn[1] = ca + cb
                bg1[1] = l1
                bg2[1] = l2
            END IF
        END FOR
        PRINT "total=" | bn[1]
        PRINT "group1:"
        FOR k = 1 TO nn
            IF (msk[k] AND bg1[1]) = msk[k] THEN PRINT "  " | nm[k] END IF
        END FOR
        PRINT "group2:"
        FOR k = 1 TO nn
            IF (msk[k] AND bg2[1]) = msk[k] THEN PRINT "  " | nm[k] END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Sp
BEGIN
    Sp.Run()
END
