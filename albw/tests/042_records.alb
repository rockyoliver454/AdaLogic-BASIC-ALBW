-- Rosetta: record/struct types -- DEFINE STRUCT lowers to a repr(C)
-- Rust struct with Copy; fields read/write via '.', whole-struct copy
-- assign works, string fields hold &'static str, STRICT arrays of
-- structs zero-init each element.
DEFINE STRUCT Point
    x AS S32
    y AS S32
END STRUCT

DEFINE STRUCT Tag
    label AS STRING
    hits  AS S32
END STRUCT

BEGIN
    LET p AS Point
    p.x = 3
    p.y = 4
    PRINT p.x * p.x + p.y * p.y
    LET q AS Point
    q = p
    q.y = q.y + 10
    PRINT p.y
    PRINT q.y
    LET t AS Tag
    t.label = "sensor"
    t.hits = 42
    PRINT$ t.label | ":" | t.hits
    STRICT pts[3] AS Point
    pts[0].x = 7
    pts[1].y = 9
    PRINT pts[0].x + pts[1].y
    PRINT pts[2].x
END
