-- 679 | Shoelace formula for polygonal area: triangle and
-- a concave pentagon.
DECLARE MODULE Sh
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sh
    STRICT px[5] AS F64
    STRICT py[5] AS F64

    PROCEDURE Run()
        -- triangle (3,4),(5,11),(12,8)
        px[1] = 3
        py[1] = 4
        px[2] = 5
        py[2] = 11
        px[3] = 12
        py[3] = 8
        LET s AS F64 = 0.0
        FOR i = 1 TO 3
            LET j AS S64 = i MOD 3 + 1
            s = s + px[i] * py[j] - px[j] * py[i]
        END FOR
        LET area AS F64 = s / 2.0
        IF area < 0.0 THEN area = 0.0 - area END IF
        PRINT "triangle area: " | area
        -- pentagon (1,6),(3,1),(7,2),(4,4),(8,5)
        px[1] = 1
        py[1] = 6
        px[2] = 3
        py[2] = 1
        px[3] = 7
        py[3] = 2
        px[4] = 4
        py[4] = 4
        px[5] = 8
        py[5] = 5
        LET s2 AS F64 = 0.0
        FOR k = 1 TO 5
            LET j2 AS S64 = k MOD 5 + 1
            s2 = s2 + px[k] * py[j2] - px[j2] * py[k]
        END FOR
        LET a2 AS F64 = s2 / 2.0
        IF a2 < 0.0 THEN a2 = 0.0 - a2 END IF
        PRINT "pentagon area: " | a2
    END PROCEDURE
END MODULE

IMPORT Sh
BEGIN
    Sh.Run()
END
