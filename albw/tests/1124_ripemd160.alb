    S2[73] = 13
    S2[74] = 6
    S2[75] = 5
    S2[76] = 15
    S2[77] = 13
    S2[78] = 11
    S2[79] = 11

    LET msg AS STRING = "The quick brown fox jumps over the lazy dog"
    LET ml AS S64 = LEN(msg)
    LET i AS S64 = 0
    WHILE i < 16
        MW[i] = 0
        i = i + 1
    END WHILE
    i = 0
    WHILE i < ml
        LET bi AS S64 = i MOD 4
        MW[i / 4] = MW[i / 4] + ASC(MID$(msg, i + 1, 1)) * (1 SHL (bi * 8))
        i = i + 1
    END WHILE
    MW[ml / 4] = MW[ml / 4] + 128 * (1 SHL ((ml MOD 4) * 8))
    MW[14] = ml * 8
    MW[15] = 0

    LET h0 AS S64 = $67452301
    LET h1 AS S64 = $EFCDAB89
    LET h2 AS S64 = $98BADCFE
    LET h3 AS S64 = $10325476
    LET h4 AS S64 = $C3D2E1F0

    LET a1 AS S64 = h0
    LET b1 AS S64 = h1
    LET c1 AS S64 = h2
    LET d1 AS S64 = h3
    LET e1 AS S64 = h4
    LET a2 AS S64 = h0
    LET b2 AS S64 = h1
    LET c2 AS S64 = h2
    LET d2 AS S64 = h3
    LET e2 AS S64 = h4

    LET j AS S64 = 0
    WHILE j < 80
        LET rd AS S64 = j / 16
        LET f AS S64 = 0
        LET kk AS S64 = 0
        IF rd = 0 THEN
            f = F1n(b1, c1, d1)
            kk = 0
        ELSE
            IF rd = 1 THEN
                f = F2n(b1, c1, d1)
                kk = $5A827999
            ELSE
                IF rd = 2 THEN
                    f = F3n(b1, c1, d1)
                    kk = $6ED9EBA1
                ELSE
                    IF rd = 3 THEN
                        f = F4n(b1, c1, d1)
                        kk = $8F1BBCDC
                    ELSE
                        f = F5n(b1, c1, d1)
                        kk = $A953FD4E
                    END IF
                END IF
            END IF
        END IF
        LET tv AS S64 = (a1 + f + MW[R1[j]] + kk) AND $FFFFFFFF
        tv = (RotL(tv, S1[j]) + e1) AND $FFFFFFFF
        a1 = e1
        e1 = d1
        d1 = RotL(c1, 10)
        c1 = b1
        b1 = tv

        IF rd = 0 THEN
            f = F5n(b2, c2, d2)
            kk = $50A28BE6
        ELSE
            IF rd = 1 THEN
                f = F4n(b2, c2, d2)
                kk = $5C4DD124
            ELSE
                IF rd = 2 THEN
                    f = F3n(b2, c2, d2)
                    kk = $6D703EF3
                ELSE
                    IF rd = 3 THEN
                        f = F2n(b2, c2, d2)
                        kk = $7A6D76E9
                    ELSE
                        f = F1n(b2, c2, d2)
                        kk = 0
                    END IF
                END IF
            END IF
        END IF
        tv = (a2 + f + MW[R2[j]] + kk) AND $FFFFFFFF
        tv = (RotL(tv, S2[j]) + e2) AND $FFFFFFFF
        a2 = e2
        e2 = d2
        d2 = RotL(c2, 10)
        c2 = b2
        b2 = tv
        j = j + 1
    END WHILE

    LET tt AS S64 = (h1 + c1 + d2) AND $FFFFFFFF
    H1 = (h2 + d1 + e2) AND $FFFFFFFF
    H2 = (h3 + e1 + a2) AND $FFFFFFFF
    H3 = (h4 + a1 + b2) AND $FFFFFFFF
    H4 = (h0 + b1 + c2) AND $FFFFFFFF
    H0 = tt

    PRINT "ripemd160=" | HexWle(H0) | HexWle(H1) | HexWle(H2) | HexWle(H3) | HexWle(H4)
END
