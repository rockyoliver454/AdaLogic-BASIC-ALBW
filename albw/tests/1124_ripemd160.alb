VERSION 1.0

STRICT MW[16] AS S64
STRICT R1[80] AS S64
STRICT R2[80] AS S64
STRICT S1[80] AS S64
STRICT S2[80] AS S64

LET H0 AS S64 = 0
LET H1 AS S64 = 0
LET H2 AS S64 = 0
LET H3 AS S64 = 0
LET H4 AS S64 = 0

FUNCTION RotL(x AS S64, r AS S64) AS S64
    LET e AS S64 = 32 - r
    LET v AS S64 = x SHL r
    v = v AND $FFFFFFFF
    LET w AS S64 = x SHR e
    RETURN v + w
END FUNCTION

FUNCTION F1n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN x XOR y XOR z
END FUNCTION

FUNCTION F2n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x AND y) + ((NOT x) AND z)
END FUNCTION

FUNCTION F3n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN ((x OR (NOT y)) XOR z) AND $FFFFFFFF
END FUNCTION

FUNCTION F4n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x AND z) + (y AND (NOT z))
END FUNCTION

FUNCTION F5n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x XOR (y OR (NOT z))) AND $FFFFFFFF
END FUNCTION

FUNCTION HexWle(w AS S64) AS STRING
    LET s AS STRING = ""
    LET i AS S64 = 0
    WHILE i < 4
        LET b AS S64 = (w SHR (i * 8)) AND 255
        LET n AS S64 = b / 16
        IF n < 10 THEN s = s | CHR(48 + n) ELSE s = s | CHR(87 + n) END IF
        n = b AND 15
        IF n < 10 THEN s = s | CHR(48 + n) ELSE s = s | CHR(87 + n) END IF
        i = i + 1
    END WHILE
    RETURN s
END FUNCTION


