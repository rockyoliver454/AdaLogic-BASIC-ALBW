-- 965 | CYK (Cocke-Younger-Kasami) parsing: CNF grammar
-- S->AB|BC, A->BA|a, B->CC|b, C->AB|a ; test "baaba".
DECLARE MODULE Ck
    PROCEDURE Run()
END DECLARE MODULE

MODULE Ck
    STRICT tab[26] AS S64
    STRICT w[6] AS S64
    STRICT n[1] AS S64

    FUNCTION Member(sym AS S64, cell AS S64) AS S64
        RETURN (tab[cell] / (2 ^ (sym - 1))) MOD 2
    END FUNCTION

    PROCEDURE Setb(sym AS S64, cell AS S64)
        tab[cell] = tab[cell] + 2 ^ (sym - 1) * (1 - Member(sym, cell))
    END PROCEDURE

    -- prod: A->XY stored as rule lhs in bits via lookup funcs
    FUNCTION Lhs(x AS S64, y AS S64, lhs AS S64) AS S64
        -- S->AB S->BC ; A->BA ; B->CC ; C->AB
        -- syms: S=1 A=2 B=3 C=4 ; terms a=5 b=6
        IF lhs = 1 THEN RETURN (x = 2 ANDALSO y = 3) ORELSE (x = 3 ANDALSO y = 4) END IF
        IF lhs = 2 THEN RETURN x = 3 ANDALSO y = 2 END IF
        IF lhs = 3 THEN RETURN x = 4 ANDALSO y = 4 END IF
        IF lhs = 4 THEN RETURN x = 2 ANDALSO y = 3 END IF
        RETURN 0
    END FUNCTION

    FUNCTION Cell(i AS S64, j AS S64) AS S64
        RETURN (i - 1) * 5 + j
    END FUNCTION

    PROCEDURE Run()
        -- word "baaba": b=6 a=5 a=5 b=6 a=5 -> terminal syms
        w[1] = 3; w[2] = 2; w[3] = 2; w[4] = 3; w[5] = 2
        n[1] = 5
        FOR i = 1 TO 25
            tab[i] = 0
        END FOR
        -- len 1: nonterm producing terminal of w[i]:
        -- A->a B->b C->a ; w symbols stored as required term
        FOR i = 1 TO 5
            LET term AS S64 = w[i]  -- 2 means 'a', 3 means 'b'
            IF term = 2 THEN
                Setb(2, Cell(i, 1))
                Setb(4, Cell(i, 1))
            ELSE
                Setb(3, Cell(i, 1))
            END IF
        END FOR
        FOR ln = 2 TO 5
            FOR i = 1 TO 5 - ln + 1
                FOR k = 1 TO ln - 1
                    FOR x = 1 TO 4
                        FOR y = 1 TO 4
                            IF Member(x, Cell(i, k)) = 1 ANDALSO Member(y, Cell(i + k, ln - k)) = 1 THEN
                                FOR lh = 1 TO 4
                                    IF Lhs(x, y, lh) <> 0 THEN
                                        Setb(lh, Cell(i, ln))
                                    END IF
                                END FOR
                            END IF
                        END FOR
                    END FOR
                END FOR
            END FOR
        END FOR
        FOR ln = 1 TO 5
            LET row AS STRING = "len" | ln | ":"
            FOR i = 1 TO 5 - ln + 1
                row = row | " " | tab[Cell(i, ln)]
            END FOR
            PRINT row
        END FOR
        IF Member(1, Cell(1, 5)) = 1 THEN
            PRINT "baaba: accepted"
        ELSE
            PRINT "baaba: rejected"
        END IF
    END PROCEDURE
END MODULE

IMPORT Ck
BEGIN
    Ck.Run()
END
