VERSION 1.0

BEGIN
    LET x AS F64 = 1.2
    LET dx AS F64 = 0.1
    LET y AS F64 = 3.4
    LET dy AS F64 = 0.2
    LET s AS F64 = x + y
    LET ds AS F64 = SQRT(dx * dx + dy * dy)
    PRINT "add: " | s | " +/-" | ds
    LET p AS F64 = x * y
    LET rp AS F64 = SQRT((dx / x) * (dx / x) + (dy / y) * (dy / y))
    PRINT "mul: " | p | " +/-" | (p * rp)
    LET q AS F64 = y / x
    LET rq AS F64 = SQRT((dx / x) * (dx / x) + (dy / y) * (dy / y))
    PRINT "div: " | q | " +/-" | (q * rq)
    LET pw AS F64 = y ^ x
    LET rpw AS F64 = SQRT((LN(y) * dx) * (LN(y) * dx) + (x * dy / y) * (x * dy / y))
    PRINT "pow: " | pw | " +/-" | (pw * rpw)
END
