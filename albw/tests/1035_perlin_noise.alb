VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0

FUNCTION LHash(x AS S64, y AS S64) AS S64
    LET h AS S64 = x * 374761393 + y * 668265263
    h = (h XOR (h / 8192)) * 1274126177
    h = h XOR (h / 65536)
    RETURN (h AND 2147483647) MOD 256
END FUNCTION

FUNCTION VN(x AS S64, y AS S64) AS S64
    LET x0 AS S64 = x / 8
    LET y0 AS S64 = y / 8
    LET fx AS S64 = (x MOD 8) * 32
    LET fy AS S64 = (y MOD 8) * 32
    LET v00 AS S64 = LHash(x0, y0)
    LET v10 AS S64 = LHash(x0 + 1, y0)
    LET v01 AS S64 = LHash(x0, y0 + 1)
    LET v11 AS S64 = LHash(x0 + 1, y0 + 1)
    LET t0 AS S64 = v00 + (v10 - v00) * fx / 256
    LET t1 AS S64 = v01 + (v11 - v01) * fx / 256
    RETURN t0 + (t1 - t0) * fy / 256
END FUNCTION


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET v AS S64 = VN(x, y)
            img[y * 64 + x] = v * 65536 + v * 256 + v
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Perlin noise", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(10, 10)
    END

    LISTEN

    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(10,10)=" | fpx
END

