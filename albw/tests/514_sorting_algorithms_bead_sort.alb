-- 514 | Sorting algorithms/Bead sort (non-negative integers).
DECLARE MODULE Bead
    PROCEDURE Run()
END DECLARE MODULE

MODULE Bead
    STRICT a[8] AS S64
    STRICT beads[80] AS S32

    PROCEDURE Run()
        a[1] = 5
        a[2] = 3
        a[3] = 9
        a[4] = 1
        a[5] = 7
        a[6] = 4
        a[7] = 2
        a[8] = 8
        -- beads[i*10+j]: row i (1..8), column j (1..10)
        FOR i = 0 TO 79
            beads[i] = 0
        END FOR
        FOR r = 1 TO 8
            FOR c = 1 TO a[r]
                beads[(r - 1) * 10 + c] = 1
            END FOR
        END FOR
        -- drop beads per column
        FOR c2 = 1 TO 10
            LET cnt AS S64 = 0
            FOR r2 = 1 TO 8
                IF beads[(r2 - 1) * 10 + c2] = 1 THEN cnt = cnt + 1 END IF
            END FOR
            FOR r3 = 1 TO 8
                IF r3 > 8 - cnt THEN
                    beads[(r3 - 1) * 10 + c2] = 1
                ELSE
                    beads[(r3 - 1) * 10 + c2] = 0
                END IF
            END FOR
        END FOR
        LET s AS STRING = ""
        FOR r4 = 1 TO 8
            LET v AS S64 = 0
            FOR c3 = 1 TO 10
                IF beads[(r4 - 1) * 10 + c3] = 1 THEN v = v + 1 END IF
            END FOR
            s = s | v | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Bead
BEGIN
    Bead.Run()
END
