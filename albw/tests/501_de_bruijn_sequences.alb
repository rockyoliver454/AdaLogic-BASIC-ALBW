-- 501 | De Bruijn sequences: prefer-1 greedy construction of a
-- B(2,4) de Bruijn sequence.
DECLARE MODULE DeB
    PROCEDURE Run()
END DECLARE MODULE

MODULE DeB
    STRICT seen[16] AS S32

    PROCEDURE Run()
        FOR i = 0 TO 15
            seen[i] = 0
        END FOR
        LET s AS STRING = "0000"
        seen[0] = 1
        LET n AS S64 = 4
        WHILE LEN(s) < 19
            LET cur AS STRING = MID$(s, LEN(s) - 2, 3)
            LET base AS S64 = ASC(MID$(cur, 1, 1)) - 48
            base = base * 2 + ASC(MID$(cur, 2, 1)) - 48
            base = base * 2 + ASC(MID$(cur, 3, 1)) - 48
            LET idx1 AS S64 = base * 2 + 1
            LET idx0 AS S64 = base * 2
            IF seen[idx1] = 0 THEN
                seen[idx1] = 1
                s = s | "1"
            ELSE
                seen[idx0] = 1
                s = s | "0"
            END IF
        END WHILE
        PRINT s
    END PROCEDURE
END MODULE

IMPORT DeB
BEGIN
    DeB.Run()
END
