VERSION 1.0

STRICT vx[5] AS S64
STRICT vy[5] AS S64

LET frames AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION


BEGIN
    LET i AS S64 = 0
    WHILE i < 5
        vx[i] = ROUND(32.0 + 26.0 * Sn(i * 144))
        vy[i] = ROUND(32.0 - 26.0 * Cs(i * 144))
        i = i + 1
    END WHILE

    CREATE_WINDOW "Pentagram", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $FFD700
        i = 0
        WHILE i < 5
            LET j AS S64 = (i + 1) MOD 5
            DRAW LINE vx[i], vy[i], vx[j], vy[j]
            i = i + 1
        END WHILE
        fpx = READ_PIXEL(vx[0], vy[0])
    END

    LISTEN

    i = 0
    WHILE i < 5
        PRINT "v" | i | "=(" | vx[i] | "," | vy[i] | ")"
        i = i + 1
    END WHILE
    PRINT "star_px=" | fpx
END
