-- 557 | Damm algorithm: quasigroup table check digit.
-- RC example: 572 -> 4.
DECLARE MODULE Damm
    FUNCTION Chk(s AS STRING) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Damm
    STRICT t[100] AS S64

    PROCEDURE LoadTbl()
        LET tbl AS STRING = "0324156789432150789657143690286890572341764809351285139204679456831270120764893521697850343985214706"
        FOR i = 0 TO 99
            t[i] = ASC(MID$(tbl, i + 1, 1)) - 48
        END FOR
    END PROCEDURE

    FUNCTION Chk(s AS STRING) AS S64
        LET d AS S64 = 0
        FOR i = 1 TO LEN(s)
            d = t[d * 10 + ASC(MID$(s, i, 1)) - 48]
        END FOR
        RETURN d
    END FUNCTION

    PROCEDURE Run()
        LoadTbl()
        PRINT "572 -> " | Chk("572")
        PRINT "5724 check -> " | Chk("5724")
        PRINT "112946 -> " | Chk("112946")
    END PROCEDURE
END MODULE

IMPORT Damm
BEGIN
    Damm.Run()
END
