VERSION 1.0

STRICT img[4096] AS S32
STRICT acc[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET mx AS S64 = 0
LET mxi AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION


BEGIN
    LET i AS S64 = 0
    WHILE i < 32
        img[(8 + i) * 64 + 8 + i * 2] = 16777215
        i = i + 1
    END WHILE
    i = 0
    WHILE i < 20
        img[(40 + i) * 64 + 56 - i] = 16777215
        i = i + 1
    END WHILE

    LET p AS S64 = 0
    WHILE p < 4096
        IF img[p] <> 0 THEN
            LET th AS S64 = 0
            LET xf AS F64 = (p MOD 64) * 1.0
            LET yf AS F64 = (p / 64) * 1.0
            WHILE th < 180
                LET rh AS S64 = ROUND(xf * Cs(th) + yf * Sn(th)) + 64
                IF rh >= 0 ANDALSO rh < 128 THEN
                    LET ai AS S64 = (rh / 2) * 64 + th / 3
                    acc[ai] = acc[ai] + 1
                    IF acc[ai] > mx THEN
                        mx = acc[ai]
                        mxi = ai
                    END IF
                END IF
                th = th + 1
            END WHILE
        END IF
        p = p + 1
    END WHILE

    CREATE_WINDOW "Hough transform", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        WHILE k < 4096
            IF acc[k] > 0 THEN
                LET v AS S64 = acc[k] * 255 / mx
                COLOR v * 65536 + v * 256 + v
                PLOT k MOD 64, k / 64
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(mxi MOD 64, mxi / 64)
    END

    LISTEN

    PRINT "peak=" | mx
    PRINT "peak_at=(" | mxi MOD 64 | "," | mxi / 64 | ")"
    PRINT "hitpx=" | fpx
END
