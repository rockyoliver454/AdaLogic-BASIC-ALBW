VERSION 1.0

STRICT A[8] AS S64
STRICT B[8] AS S64
STRICT CC[16] AS S64


BEGIN
    A[0] = 1
    A[1] = 0
    A[2] = 1
    B[0] = 1
    B[1] = 0 - 1
    B[2] = 0

    LET i AS S64 = 0
    WHILE i < 16
        CC[i] = 0
        i = i + 1
    END WHILE

    i = 0
    WHILE i < 8
        LET j AS S64 = 0
        WHILE j < 8
            CC[i + j] = CC[i + j] + A[i] * B[j]
            j = j + 1
        END WHILE
        i = i + 1
    END WHILE

    PRINT "(1+x^2)*(1-x) coeffs:"
    i = 0
    WHILE i < 6
        PRINT "x^" | i | " : " | CC[i]
        i = i + 1
    END WHILE

    PRINT "derivative of A:"
    i = 1
    WHILE i < 8
        IF A[i] <> 0 THEN
            PRINT i * A[i] | " x^" | (i - 1)
        END IF
        i = i + 1
    END WHILE
END
