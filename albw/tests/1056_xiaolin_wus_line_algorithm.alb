VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET x0 AS F64 = 4.0
    LET y0 AS F64 = 10.0
    LET x1 AS F64 = 60.0
    LET y1 AS F64 = 48.0
    LET dx AS F64 = x1 - x0
    LET dy AS F64 = y1 - y0
    LET gr AS F64 = dy / dx
    LET x AS S64 = 4
    LET iy AS F64 = y0
    WHILE x <= 60
        LET xi AS S64 = x
        LET yi AS S64 = iy
        LET frac AS F64 = iy - (yi * 1.0)
        LET i1 AS S64 = ROUND((1.0 - frac) * 255.0)
        LET i2 AS S64 = ROUND(frac * 255.0)
        img[yi * 64 + xi] = i1 * 65536 + i1 * 256 + i1
        IF yi + 1 < 64 THEN img[(yi + 1) * 64 + xi] = i2 * 65536 + i2 * 256 + i2 END IF
        iy = iy + gr
        x = x + 1
    END WHILE

    CREATE_WINDOW "Xiaolin Wu line", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "line=(4,10)->(60,48)"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
