-- 380 | Pell numbers: P(0)=0, P(1)=1, P(n)=2P(n-1)+P(n-2); first 15.
DECLARE MODULE Pell
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pell
    STRICT p[16] AS S64
    PROCEDURE Run()
        p[0] = 0
        p[1] = 1
        FOR n = 2 TO 14
            p[n] = 2 * p[n - 1] + p[n - 2]
        END FOR
        LET s AS STRING = ""
        FOR n = 0 TO 14
            s = s | p[n] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Pell
BEGIN
    Pell.Run()
END
