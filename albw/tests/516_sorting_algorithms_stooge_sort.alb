-- 516 | Sorting algorithms/Stooge sort.
DECLARE MODULE Stooge
    PROCEDURE St(lo AS S64, hi AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE Stooge
    STRICT a[9] AS S64

    PROCEDURE St(lo AS S64, hi AS S64)
        IF a[lo] > a[hi] THEN
            LET t AS S64 = a[lo]
            a[lo] = a[hi]
            a[hi] = t
        END IF
        IF hi - lo + 1 > 2 THEN
            LET th AS S64 = (hi - lo + 1) / 3
            St(lo, hi - th)
            St(lo + th, hi)
            St(lo, hi - th)
        END IF
    END PROCEDURE

    PROCEDURE Run()
        a[1] = 9
        a[2] = 1
        a[3] = 8
        a[4] = 2
        a[5] = 7
        a[6] = 3
        a[7] = 6
        a[8] = 4
        a[9] = 5
        St(1, 9)
        LET s AS STRING = ""
        FOR k = 1 TO 9
            s = s | a[k] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Stooge
BEGIN
    Stooge.Run()
END
