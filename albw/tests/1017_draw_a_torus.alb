VERSION 1.0
STRICT img[4096] AS S32

LET frames AS S64 = 0
LET np AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fx AS S64 = 0
LET fy AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE TPlot(u AS S64, v AS S64)
    LET rf AS F64 = 16.0 + 6.0 * Cs(v)
    LET x AS F64 = rf * Cs(u)
    LET y0 AS F64 = rf * Sn(u)
    LET z AS F64 = 6.0 * Sn(v)
    LET y AS F64 = y0 * 0.5 - z * 0.8660254037844386
    LET sx AS S64 = ROUND(32.0 + x)
    LET sy AS S64 = ROUND(32.0 - y)
    IF sx >= 0 ANDALSO sx < 64 ANDALSO sy >= 0 ANDALSO sy < 64 THEN
        img[sy * 64 + sx] = 16744192
    END IF
    np = np + 1
END PROCEDURE

BEGIN
    LET u AS S64 = 0
    LET v AS S64 = 0
    WHILE u < 360
        v = 0
        WHILE v < 360
            CALL TPlot(u, v)
            v = v + 5
        END WHILE
        u = u + 5
    END WHILE

    CREATE_WINDOW "Draw a torus", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fx = k MOD 64
        fy = k / 64
        fpx = READ_PIXEL(fx, fy)
    END

    LISTEN

    PRINT "points=" | np
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(" | fx | "," | fy | ")=" | fpx
END
