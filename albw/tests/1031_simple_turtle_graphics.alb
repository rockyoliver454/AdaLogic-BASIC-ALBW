VERSION 1.0

STRICT x1[400] AS S64
STRICT y1[400] AS S64
STRICT x2[400] AS S64
STRICT y2[400] AS S64

LET frames AS S64 = 0
LET nseg AS S64 = 0
LET tx AS S64 = 3200
LET ty AS S64 = 3200
LET th AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE Turn(d AS S64)
    th = (th + d + 360) MOD 360
END PROCEDURE

PROCEDURE Fwd(c AS S64)
    LET xf AS F64 = tx * 1.0
    LET yf AS F64 = ty * 1.0
    LET cf AS F64 = c * 1.0
    LET nx AS S64 = ROUND(xf + Cs(th) * cf)
    LET ny AS S64 = ROUND(yf - Sn(th) * cf)
    x1[nseg] = tx / 100 y1[nseg] = ty / 100
    x2[nseg] = nx / 100 y2[nseg] = ny / 100
    nseg = nseg + 1
    tx = nx
    ty = ny
END PROCEDURE


BEGIN
    CALL Fwd(1600)
    CALL Turn(90)
    CALL Fwd(1600)
    CALL Turn(90)
    CALL Fwd(1600)
    CALL Turn(90)
    CALL Fwd(1600)
    CALL Turn(90)
    CALL Turn(45)
    CALL Fwd(2263)
    CALL Turn(0 - 90)
    CALL Fwd(1600)

    CREATE_WINDOW "Simple turtle graphics", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $FFFFFF
        i = 0
        WHILE i < nseg
            DRAW LINE x1[i], y1[i], x2[i], y2[i]
            i = i + 1
        END WHILE
        fpx = READ_PIXEL(x1[0], y1[0])
    END

    LISTEN

    PRINT "segments=" | nseg
    PRINT "start=(32,32)"
    PRINT "end=(" | tx / 100 | "," | ty / 100 | ")"
    PRINT "start_px=" | fpx
END
