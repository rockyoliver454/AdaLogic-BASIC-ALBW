-- 976 | Tarjan's SCC algorithm: find strongly connected
-- components of a directed graph (recursive DFS).
DECLARE MODULE Tj
    PROCEDURE Run()
END DECLARE MODULE

MODULE Tj
    STRICT ad[9] AS S64
    STRICT an[9] AS S64
    STRICT idx[8] AS S64
    STRICT low[8] AS S64
    STRICT stk[8] AS S64
    STRICT ons[8] AS S64
    STRICT cnt[1] AS S64
    STRICT sp[1] AS S64

    PROCEDURE Dfs(v AS S64)
        cnt[1] = cnt[1] + 1
        idx[v] = cnt[1]
        low[v] = cnt[1]
        sp[1] = sp[1] + 1
        stk[sp[1]] = v
        ons[v] = 1
        FOR e = an[v] TO an[v + 1] - 1
            LET w AS S64 = ad[e]
            IF idx[w] = 0 THEN
                Dfs(w)
                IF low[w] < low[v] THEN low[v] = low[w] END IF
            ELSE
                IF ons[w] = 1 ANDALSO idx[w] < low[v] THEN low[v] = idx[w] END IF
            END IF
        END FOR
        IF low[v] = idx[v] THEN
            LET s AS STRING = "scc:"
            LET w AS S64 = 0
            WHILE w <> v
                w = stk[sp[1]]
                sp[1] = sp[1] - 1
                ons[w] = 0
                s = s | " " | w
            END WHILE
            PRINT s
        END IF
    END PROCEDURE

    PROCEDURE Run()
        -- graph: 1->2, 2->3, 3->1, 3->4, 4->5, 5->6, 6->5, 6->4
        -- CSR arrays: an[v]=start, ad[e]=target (8 verts, 8 edges)
        ad[1] = 2
        an[1] = 1
        ad[2] = 3
        an[2] = 2
        ad[3] = 1; ad[4] = 4
        an[3] = 3
        ad[5] = 5
        an[4] = 5
        ad[6] = 6
        an[5] = 6
        ad[7] = 5; ad[8] = 4
        an[6] = 7
        an[7] = 9
        an[8] = 9
        an[9] = 9
        cnt[1] = 0
        sp[1] = 0
        FOR v = 1 TO 8
            idx[v] = 0; low[v] = 0; ons[v] = 0
        END FOR
        FOR v = 1 TO 8
            IF idx[v] = 0 THEN Dfs(v) END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Tj
BEGIN
    Tj.Run()
END
