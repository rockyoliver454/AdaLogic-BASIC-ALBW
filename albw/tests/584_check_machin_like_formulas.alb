-- 584 | Check Machin-like formulas: verify
-- pi/4 = 4*atan(1/5) - atan(1/239)  (Machin)
-- pi/4 = atan(1/2) + atan(1/3)    (Euler)
DECLARE MODULE Mach
    FUNCTION Machin() AS F64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Mach
    FUNCTION Machin() AS F64
        RETURN 4.0 * ATAN(1.0 / 5.0) - ATAN(1.0 / 239.0)
    END FUNCTION

    PROCEDURE Run()
        LET pi AS F64 = 3.141592653589793
        LET m AS F64 = Machin()
        LET e AS F64 = ATAN(1.0 / 2.0) + ATAN(1.0 / 3.0)
        PRINT "pi/4 = " | (pi / 4.0)
        PRINT "machin = " | m
        PRINT "euler  = " | e
        LET ok1 AS S32 = 0
        LET ok2 AS S32 = 0
        IF m - pi / 4.0 < 0.0000001 ANDALSO pi / 4.0 - m < 0.0000001 THEN ok1 = 1 END IF
        IF e - pi / 4.0 < 0.0000001 ANDALSO pi / 4.0 - e < 0.0000001 THEN ok2 = 1 END IF
        PRINT "machin ok: " | ok1
        PRINT "euler ok: " | ok2
    END PROCEDURE
END MODULE

IMPORT Mach
BEGIN
    Mach.Run()
END
