-- 384 | Count in factors: print prime factorizations for 1..10 and 9991.
DECLARE MODULE CntFact
    PROCEDURE Show(n AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE CntFact
    PROCEDURE Show(n AS S64)
        IF n = 1 THEN
            PRINT "1 = 1"
            RETURN
        END IF
        LET s AS STRING = n | " = "
        LET m AS S64 = n
        LET d AS S64 = 2
        LET first AS S32 = 1
        WHILE d * d <= m
            WHILE m MOD d = 0
                IF first = 0 THEN s = s | " x " END IF
                s = s | d
                first = 0
                m = m / d
            END WHILE
            d = d + 1
        END WHILE
        IF m > 1 THEN
            IF first = 0 THEN s = s | " x " END IF
            s = s | m
        END IF
        PRINT s
    END PROCEDURE

    PROCEDURE Run()
        FOR n = 1 TO 10
            Show(n)
        END FOR
        Show(9991)
    END PROCEDURE
END MODULE

IMPORT CntFact
BEGIN
    CntFact.Run()
END
