VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET clicks AS S64 = 0


BEGIN
    LET y AS S64 = 6
    WHILE y < 58
        LET x AS S64 = 8
        WHILE x < 56
            img[y * 64 + x] = 2105376
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE
    y = 6
    WHILE y < 14
        LET x AS S64 = 8
        WHILE x < 56
            img[y * 64 + x] = 32768
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE
    y = 24
    WHILE y < 36
        LET x AS S64 = 20
        WHILE x < 44
            img[y * 64 + x] = 8421504
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE
    clicks = 3

    CREATE_WINDOW "Simple windowed application", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "titlebar=8px button=24x12"
    PRINT "clicks=" | clicks
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
