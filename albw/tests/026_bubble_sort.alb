-- Rosetta: bubble sort on a STRICT array.
BEGIN
    STRICT a[8] AS S32
    a[0] = 5
    a[1] = 2
    a[2] = 9
    a[3] = 1
    a[4] = 7
    a[5] = 3
    a[6] = 8
    a[7] = 4
    FOR i = 0 TO 6
        FOR j = 0 TO 6 - i
            IF a[j] > a[j + 1] THEN
                LET t AS S32 = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            END IF
        END FOR
    END FOR
    FOR i = 0 TO 7
        PRINT a[i]
    END FOR
END
