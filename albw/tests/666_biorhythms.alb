-- 666 | Biorhythms: days since a fixed birth date, then
-- physical/emotional/intellectual cycle values.
DECLARE MODULE Bio
    FUNCTION Jdn(y AS S64, m AS S64, d AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Bio
    FUNCTION Jdn(y AS S64, m AS S64, d AS S64) AS S64
        LET a AS S64 = (14 - m) / 12
        LET y2 AS S64 = y + 4800 - a
        LET m2 AS S64 = m + 12 * a - 3
        RETURN d + (153 * m2 + 2) / 5 + 365 * y2 + y2 / 4 - y2 / 100 + y2 / 400 - 32045
    END FUNCTION

    PROCEDURE Run()
        LET birth AS S64 = Jdn(1980, 5, 12)
        LET target AS S64 = Jdn(2025, 1, 15)
        LET days AS S64 = target - birth
        PRINT "days alive: " | days
        LET pi2 AS F64 = 6.283185307
        LET ph AS F64 = SIN(pi2 * (days MOD 23) / 23.0)
        LET em AS F64 = SIN(pi2 * (days MOD 28) / 28.0)
        LET it AS F64 = SIN(pi2 * (days MOD 33) / 33.0)
        PRINT "physical: " | ph
        PRINT "emotional: " | em
        PRINT "intellectual: " | it
    END PROCEDURE
END MODULE

IMPORT Bio
BEGIN
    Bio.Run()
END
