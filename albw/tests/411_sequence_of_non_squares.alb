-- 411 | Sequence of non-squares: a(n) = n + floor(1/2 + sqrt(n)); first 22, none square.
DECLARE MODULE NonSquare
    PROCEDURE Run()
END DECLARE MODULE

MODULE NonSquare
    PROCEDURE Run()
        LET s AS STRING = ""
        FOR n = 1 TO 22
            LET a AS S64 = n + FLOOR(SQRT(n) + 0.5)
            s = s | a | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT NonSquare
BEGIN
    NonSquare.Run()
END
