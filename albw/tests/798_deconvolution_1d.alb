-- 798 | Deconvolution/1D: given g = f*h, recover h.
-- h_i = (g_i - sum_{k<i} f_{i-k} h_k) / f_0.
DECLARE MODULE Dc
    PROCEDURE Run()
END DECLARE MODULE

MODULE Dc
    STRICT ff[9] AS S64
    STRICT gg[16] AS S64
    STRICT hh[9] AS S64
    STRICT hr[9] AS S64

    PROCEDURE Run()
        -- f = [-3,-6,-1,8,-6,3,-1,-9,-9,3,-2,5,2,-2,-7,-1]
        -- h = [-8,-9,-3,-1,-6,7]  => g = f*h (35 entries)
        -- use the RC small demo instead: f=[1,2,3], h=[4,5,6]
        -- g = conv: [4,13,28,27,18]
        ff[1] = 1
        ff[2] = 2
        ff[3] = 3
        hh[1] = 4
        hh[2] = 5
        hh[3] = 6
        -- build g = f*h
        FOR i = 1 TO 16
            gg[i] = 0
        END FOR
        FOR i = 1 TO 3
            FOR j = 1 TO 3
                gg[i + j - 1] = gg[i + j - 1] + ff[i] * hh[j]
            END FOR
        END FOR
        PRINT "g:";
        FOR i = 1 TO 5
            PRINT gg[i]
        END FOR
        -- deconv: recover h (len = len(g)-len(f)+1 = 3)
        FOR i = 1 TO 3
            LET s AS S64 = gg[i]
            IF i > 1 THEN
                FOR k = 1 TO i - 1
                    s = s - ff[i - k + 1] * hr[k]
                END FOR
            END IF
            hr[i] = s / ff[1]
        END FOR
        PRINT "recovered h:";
        FOR i = 1 TO 3
            PRINT hr[i]
        END FOR
    END PROCEDURE
END MODULE

IMPORT Dc
BEGIN
    Dc.Run()
END
