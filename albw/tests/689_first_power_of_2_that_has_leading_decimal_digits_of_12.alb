-- 689 | First power of 2 that has leading decimal digits of
-- 12: smallest k with 2^k starting "12", plus next few.
DECLARE MODULE Pow
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pow
    PROCEDURE Run()
        -- fractional part of k*log10(2) in [log10(1.2), log10(1.3))
        LET l2 AS F64 = 0.301029995663981
        LET lo AS F64 = 0.079181246047625
        LET hi AS F64 = 0.113943352306837
        LET cnt AS S64 = 0
        LET k AS S64 = 0
        WHILE cnt < 10
            k = k + 1
            LET f AS F64 = k * l2
            LET ip AS S64 = f
            f = f - ip
            IF f >= lo ANDALSO f < hi THEN
                PRINT "2^" | k | " starts with 12"
                cnt = cnt + 1
            END IF
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Pow
BEGIN
    Pow.Run()
END
