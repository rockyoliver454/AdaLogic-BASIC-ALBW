VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET npx AS S64 = 0

PROCEDURE BLine(x0 AS S64, y0 AS S64, x1 AS S64, y1 AS S64)
    LET dx AS S64 = x1 - x0
    IF dx < 0 THEN dx = 0 - dx END IF
    LET dy AS S64 = y1 - y0
    IF dy < 0 THEN dy = 0 - dy END IF
    LET sx AS S64 = 1
    IF x0 > x1 THEN sx = 0 - 1 END IF
    LET sy AS S64 = 1
    IF y0 > y1 THEN sy = 0 - 1 END IF
    LET e AS S64 = dx - dy
    LET x AS S64 = x0
    LET y AS S64 = y0
    LET done AS S64 = 0
    WHILE done = 0
        img[y * 64 + x] = 16777215
        npx = npx + 1
        IF x = x1 ANDALSO y = y1 THEN
            done = 1
        ELSE
            LET e2 AS S64 = e * 2
            IF e2 > 0 - dy THEN
                e = e - dy
                x = x + sx
            END IF
            IF e2 < dx THEN
                e = e + dx
                y = y + sy
            END IF
        END IF
    END WHILE
END PROCEDURE


BEGIN
    CALL BLine(4, 4, 60, 20)
    CALL BLine(4, 60, 60, 30)
    CALL BLine(32, 60, 32, 8)

    CREATE_WINDOW "Bresenham lines", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(60, 20)
    END

    LISTEN

    PRINT "pixels=" | npx
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "endpx=" | fpx
END
