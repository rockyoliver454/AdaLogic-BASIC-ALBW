-- 370 | Palindromic primes in base 16: primes < 500 whose hex form is a palindrome.
DECLARE MODULE PalP16
    FUNCTION IsPrime(n AS S64) AS S32
    FUNCTION HexPal(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE PalP16
    STRICT dig[16] AS S64

    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        IF n = 2 THEN RETURN 1 END IF
        IF n MOD 2 = 0 THEN RETURN 0 END IF
        LET d AS S64 = 3
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 2
        END WHILE
        RETURN 1
    END FUNCTION

    FUNCTION HexPal(n AS S64) AS S32
        LET m AS S64 = n
        LET nd AS S32 = 0
        WHILE m > 0
            dig[nd] = m MOD 16
            nd = nd + 1
            m = m / 16
        END WHILE
        FOR i = 0 TO nd / 2
            IF i < nd - 1 - i THEN
                IF dig[i] <> dig[nd - 1 - i] THEN RETURN 0 END IF
            END IF
        END FOR
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        FOR n = 2 TO 499
            IF IsPrime(n) = 1 ANDALSO HexPal(n) = 1 THEN s = s | n | " " END IF
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT PalP16
BEGIN
    PalP16.Run()
END
