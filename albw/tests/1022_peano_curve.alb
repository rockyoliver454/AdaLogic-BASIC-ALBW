VERSION 1.0
STRICT x1[90] AS S64
STRICT y1[90] AS S64
STRICT x2[90] AS S64
STRICT y2[90] AS S64

LET frames AS S64 = 0
LET nseg AS S64 = 0
LET tx AS S64 = 6
LET ty AS S64 = 54
LET th AS S64 = 0
LET fpx AS S64 = 0

PROCEDURE Fwd()
    LET nx AS S64 = tx
    LET ny AS S64 = ty
    IF th = 0 THEN nx = tx + 6 END IF
    IF th = 1 THEN ny = ty + 6 END IF
    IF th = 2 THEN nx = tx - 6 END IF
    IF th = 3 THEN ny = ty - 6 END IF
    x1[nseg] = tx y1[nseg] = ty x2[nseg] = nx y2[nseg] = ny
    tx = nx
    ty = ny
    nseg = nseg + 1
END PROCEDURE

PROCEDURE Turn(d AS S64)
    th = (th + d + 4) MOD 4
END PROCEDURE

PROCEDURE PL(level AS S64)
    IF level > 0 THEN
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
        CALL Turn(0 - 1)
        CALL Fwd()
        CALL Turn(0 - 1)
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
        CALL Turn(1)
        CALL Fwd()
        CALL Turn(1)
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
    END IF
END PROCEDURE

PROCEDURE PR(level AS S64)
    IF level > 0 THEN
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
        CALL Turn(1)
        CALL Fwd()
        CALL Turn(1)
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
        CALL Turn(0 - 1)
        CALL Fwd()
        CALL Turn(0 - 1)
        CALL PR(level - 1)
        CALL Fwd()
        CALL PL(level - 1)
        CALL Fwd()
        CALL PR(level - 1)
    END IF
END PROCEDURE

BEGIN
    CALL PL(2)

    CREATE_WINDOW "Peano curve", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $FF8000
        i = 0
        WHILE i < nseg
            DRAW LINE x1[i], y1[i], x2[i], y2[i]
            i = i + 1
        END WHILE
        fpx = READ_PIXEL(x1[0], y1[0])
    END

    LISTEN

    PRINT "order=2"
    PRINT "segments=" | nseg
    PRINT "end=(" | tx | "," | ty | ")"
    PRINT "start_px=" | fpx
END
