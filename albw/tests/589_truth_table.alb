-- 589 | Truth table: print AND/OR/XOR/IMPLIES tables for two
-- boolean inputs.
DECLARE MODULE TT
    PROCEDURE Run()
END DECLARE MODULE

MODULE TT
    PROCEDURE Run()
        PRINT "a b | AND OR XOR IMPLIES"
        FOR a = 0 TO 1
            FOR b = 0 TO 1
                LET a2 AS S32 = a
                LET b2 AS S32 = b
                LET r1 AS S32 = 0
                LET r2 AS S32 = 0
                LET r3 AS S32 = 0
                LET r4 AS S32 = 1
                IF a2 = 1 ANDALSO b2 = 1 THEN r1 = 1 END IF
                IF a2 = 1 ORELSE b2 = 1 THEN r2 = 1 END IF
                IF a2 <> b2 THEN r3 = 1 END IF
                IF a2 = 1 ANDALSO b2 = 0 THEN r4 = 0 END IF
                PRINT a | " " | b | " |  " | r1 | "   " | r2 | "   " | r3 | "   " | r4
            END FOR
        END FOR
    END PROCEDURE
END MODULE

IMPORT TT
BEGIN
    TT.Run()
END
