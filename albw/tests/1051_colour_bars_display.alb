VERSION 1.0

STRICT img[4096] AS S32
STRICT bc[8] AS S64

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    bc[0] = 16777215
    bc[1] = 16776960
    bc[2] = 65535
    bc[3] = 65280
    bc[4] = 16711935
    bc[5] = 16711680
    bc[6] = 255
    bc[7] = 0
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            img[y * 64 + x] = bc[x / 8]
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Colour bars", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
                k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "bars=8"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
