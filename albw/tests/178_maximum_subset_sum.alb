-- 178 | Maximum subset sum (Kadane's algorithm).
BEGIN
    STRICT a[8] AS S32;
    a[0]=-2; a[1]=1; a[2]=-3; a[3]=4; a[4]=-1;
    a[5]=2; a[6]=1; a[7]=-5;
    LET best AS S32 = a[0];
    LET cur AS S32 = 0;
    FOR i = 0 TO 7
        cur = cur + a[i];
        IF cur > best THEN
            best = cur;
        END IF
        IF cur < 0 THEN
            cur = 0;
        END IF
    END FOR
    PRINT best;
END
