VERSION 1.0

STRICT pm[120] AS STRING
STRICT used[120] AS S64
LET cnt AS S64 = 0


PROCEDURE GenPrms(prefix AS STRING, dpth AS S64, n AS S64)
    IF dpth = n THEN
        pm[cnt] = prefix
        cnt = cnt + 1
        RETURN
    END IF
    LET i AS S64 = 1
    WHILE i <= n
        LET ck AS S64 = 0
        LET j AS S64 = 1
        WHILE j <= LEN(prefix)
            IF ASC(MID$(prefix, j, 1)) = 48 + i THEN
                ck = 1
            END IF
            j = j + 1
        END WHILE
        IF ck = 0 THEN
            GenPrms(prefix | CHR(48 + i), dpth + 1, n)
        END IF
        i = i + 1
    END WHILE
END PROCEDURE


FUNCTION Ovr(a AS STRING, b AS STRING) AS S64
    LET la AS S64 = LEN(a)
    LET lb AS S64 = LEN(b)
    LET mx AS S64 = la
    IF lb < mx THEN
        mx = lb
    END IF
    LET k AS S64 = mx
    WHILE k > 0
        IF MID$(a, la - k + 1, k) = MID$(b, 1, k) THEN
            RETURN k
        END IF
        k = k - 1
    END WHILE
    RETURN 0
END FUNCTION


BEGIN
    LET n AS S64 = 3
    cnt = 0
    GenPrms("", 0, n)

    LET sup AS STRING = pm[0]
    used[0] = 1
    LET lft AS S64 = cnt - 1
    WHILE lft > 0
        LET best AS S64 = -1
        LET bov AS S64 = -1
        LET i AS S64 = 0
        WHILE i < cnt
            IF used[i] = 0 THEN
                LET ov AS S64 = Ovr(sup, pm[i])
                IF ov > bov THEN
                    bov = ov
                    best = i
                END IF
            END IF
            i = i + 1
        END WHILE
        LET bp AS STRING = pm[best]
        sup = sup | MID$(bp, bov + 1, LEN(bp) - bov)
        used[best] = 1
        lft = lft - 1
    END WHILE
    PRINT "n=3 superstring=" | sup
    PRINT "length=" | LEN(sup) | " (optimal=9)"

    LET ok AS S64 = 1
    LET i2 AS S64 = 0
    WHILE i2 < cnt
        LET found AS S64 = 0
        LET p AS S64 = 1
        WHILE p + 2 <= LEN(sup)
            IF MID$(sup, p, 3) = pm[i2] THEN
                found = 1
            END IF
            p = p + 1
        END WHILE
        IF found = 0 THEN
            ok = 0
        END IF
        i2 = i2 + 1
    END WHILE
    PRINT "contains all 6 permutations=" | ok
END
