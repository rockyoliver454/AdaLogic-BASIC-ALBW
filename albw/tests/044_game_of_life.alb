-- 044 | Conway's Game of Life: blinker + block, 4 generations.
BEGIN
    STRICT g[8,8] AS S32;
    STRICT nx[8,8] AS S32;
    g[2,1] = 1; g[2,2] = 1; g[2,3] = 1;
    g[5,5] = 1; g[5,6] = 1; g[6,5] = 1; g[6,6] = 1;
    FOR gen = 0 TO 3
        PRINT$ "gen " | gen;
        FOR r = 0 TO 7
            LET row AS STRING = "";
            FOR c = 0 TO 7
                IF g[r,c] = 1 THEN
                    row = row | "*";
                ELSE
                    row = row | ".";
                END IF
            END FOR
            PRINT$ row;
        END FOR
        FOR r = 0 TO 7
            FOR c = 0 TO 7
                LET nn AS S32 = 0;
                FOR dr = -1 TO 1
                    FOR dc = -1 TO 1
                        LET rr AS S32 = r + dr;
                        LET cc AS S32 = c + dc;
                        IF rr >= 0 ANDALSO rr < 8 ANDALSO cc >= 0 ANDALSO cc < 8 THEN
                            IF dr <> 0 ORELSE dc <> 0 THEN
                                nn = nn + g[rr,cc];
                            END IF
                        END IF
                    END FOR
                END FOR
                nx[r,c] = 0;
                IF g[r,c] = 1 ANDALSO (nn = 2 ORELSE nn = 3) THEN
                    nx[r,c] = 1;
                END IF
                IF g[r,c] = 0 ANDALSO nn = 3 THEN
                    nx[r,c] = 1;
                END IF
            END FOR
        END FOR
        FOR r = 0 TO 7
            FOR c = 0 TO 7
                g[r,c] = nx[r,c];
            END FOR
        END FOR
    END FOR
END
