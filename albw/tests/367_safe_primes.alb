-- 367 | Safe primes: p prime where (p-1)/2 is also prime; first 15.
DECLARE MODULE SafeP
    FUNCTION IsPrime(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE SafeP
    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        IF n = 2 THEN RETURN 1 END IF
        IF n MOD 2 = 0 THEN RETURN 0 END IF
        LET d AS S64 = 3
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 2
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET found AS S32 = 0
        LET n AS S64 = 5
        WHILE found < 15
            IF IsPrime(n) = 1 ANDALSO IsPrime((n - 1) / 2) = 1 THEN
                s = s | n | " "
                found = found + 1
            END IF
            n = n + 1
        END WHILE
        PRINT s
    END PROCEDURE
END MODULE

IMPORT SafeP
BEGIN
    SafeP.Run()
END
