VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET nch AS S64 = 0


BEGIN
    LET msg AS STRING = "TEACUP"
    LET n AS S64 = LEN(msg)
    LET i AS S64 = 0
    WHILE i < n
        LET a AS S64 = 210 + i * 20
        LET af AS F64 = a * 1.0
        LET cx AS S64 = ROUND(32.0 + COS(af * 0.017453292519943295) * 18.0)
        LET cy AS S64 = ROUND(32.0 + SIN(af * 0.017453292519943295) * 10.0)
        LET px AS S64 = cx
        LET py AS S64 = cy
        LET dx AS S64 = 0
        LET dy AS S64 = 0
        dx = 0
        WHILE dx < 5
            dy = 0
            WHILE dy < 7
                img[(py + dy) * 64 + px + dx] = 16777215
                dy = dy + 1
            END WHILE
            dx = dx + 1
        END WHILE
        nch = nch + 1
        i = i + 1
    END WHILE
    LET cupx AS S64 = 20
    WHILE cupx < 44
        LET cupy AS S64 = 0
        WHILE cupy < 3
            img[(44 + cupy) * 64 + cupx] = 11591910
            cupy = cupy + 1
        END WHILE
        cupx = cupx + 1
    END WHILE

    CREATE_WINDOW "Teacup rim text", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "text=TEACUP chars=" | nch
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
