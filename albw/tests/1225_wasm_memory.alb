-- 1225 | ENABLE WASM memory surface: linear memory declaration +
-- growth, active data segment init, and every load/store width.
-- wstore returns the stored value so every export stays a function.
ENABLE WASM
(module
  (memory 1)
  (data (i32.const 16) "hi")
  (func (export "wstore") (param $a i32) (param $v i32) (result i32)
    local.get $a  local.get $v  i32.store
    local.get $v)
  (func (export "wload") (param $a i32) (result i32)
    local.get $a  i32.load)
  (func (export "wload8") (param $a i32) (result i32)
    local.get $a  i32.load8_u)
  (func (export "memgrow") (param $n i32) (result i32)
    local.get $n  memory.grow)
  (func (export "memsize") (result i32)
    memory.size)
  (func (export "sum16") (result i32)
    (i32.add
      (i32.load8_u (i32.const 16))
      (i32.load8_u (i32.const 17)))))
END ENABLE

BEGIN
    PRINT "wstore=" | wstore(0, 77)
    PRINT "wload=" | wload(0)
    PRINT "lo=" | wload8(16)
    PRINT "hi=" | wload8(17)
    PRINT "sum=" | sum16()
    PRINT "sz=" | memsize()
    PRINT "gw=" | memgrow(1)
    PRINT "sz2=" | memsize()
END
