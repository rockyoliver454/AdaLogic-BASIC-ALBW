-- 033 | Cholesky decomposition: A = L * L^T for SPD matrix.
BEGIN
    STRICT a[3,3] AS F64;
    a[0,0]=25.0; a[0,1]=15.0; a[0,2]=-5.0;
    a[1,0]=15.0; a[1,1]=18.0; a[1,2]=0.0;
    a[2,0]=-5.0; a[2,1]=0.0;  a[2,2]=11.0;
    STRICT l[3,3] AS F64;
    FOR i = 0 TO 2
        FOR j = 0 TO i
            LET s AS F64 = a[i,j];
            FOR k = 0 TO j - 1
                s = s - l[i,k] * l[j,k];
            END FOR
            IF i = j THEN
                l[i,j] = SQRT(s);
            ELSE
                l[i,j] = s / l[j,j];
            END IF
        END FOR
    END FOR
    FOR i = 0 TO 2
        PRINT$ l[i,0] | " " | l[i,1] | " " | l[i,2];
    END FOR
END
