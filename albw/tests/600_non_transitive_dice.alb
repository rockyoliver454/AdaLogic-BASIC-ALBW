-- 600 | Non-transitive dice: Efron's dice.
-- A=[0,0,4,4,4,4] B=[3,3,3,3,3,3] C=[2,2,2,2,6,6] D=[1,1,1,5,5,5]
-- A beats B, B beats C, C beats D, D beats A (each 2/3 or 4/9...).
DECLARE MODULE Dice
    FUNCTION Beats(x1 AS S64, x2 AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Dice
    STRICT da[6] AS S64
    STRICT db[6] AS S64
    STRICT dc[6] AS S64
    STRICT dd[6] AS S64
    STRICT gx[6] AS S64
    STRICT gy[6] AS S64

    PROCEDURE CopyX(src AS S64, dst AS S64)
        -- copy die src# to gx, dst# to gy via ids 1..4
        FOR i = 0 TO 5
            IF src = 1 THEN gx[i] = da[i] END IF
            IF src = 2 THEN gx[i] = db[i] END IF
            IF src = 3 THEN gx[i] = dc[i] END IF
            IF src = 4 THEN gx[i] = dd[i] END IF
            IF dst = 1 THEN gy[i] = da[i] END IF
            IF dst = 2 THEN gy[i] = db[i] END IF
            IF dst = 3 THEN gy[i] = dc[i] END IF
            IF dst = 4 THEN gy[i] = dd[i] END IF
        END FOR
    END PROCEDURE

    FUNCTION Beats(x1 AS S64, x2 AS S64) AS S64
        CopyX(x1, x2)
        LET w AS S64 = 0
        FOR i = 0 TO 5
            FOR j = 0 TO 5
                IF gx[i] > gy[j] THEN w = w + 1 END IF
            END FOR
        END FOR
        RETURN w
    END FUNCTION

    PROCEDURE Run()
        da[0] = 0
        da[1] = 0
        da[2] = 4
        da[3] = 4
        da[4] = 4
        da[5] = 4
        db[0] = 3
        db[1] = 3
        db[2] = 3
        db[3] = 3
        db[4] = 3
        db[5] = 3
        dc[0] = 2
        dc[1] = 2
        dc[2] = 2
        dc[3] = 2
        dc[4] = 6
        dc[5] = 6
        dd[0] = 1
        dd[1] = 1
        dd[2] = 1
        dd[3] = 5
        dd[4] = 5
        dd[5] = 5
        PRINT "A beats B: " | Beats(1, 2) | "/36"
        PRINT "B beats C: " | Beats(2, 3) | "/36"
        PRINT "C beats D: " | Beats(3, 4) | "/36"
        PRINT "D beats A: " | Beats(4, 1) | "/36"
    END PROCEDURE
END MODULE

IMPORT Dice
BEGIN
    Dice.Run()
END
