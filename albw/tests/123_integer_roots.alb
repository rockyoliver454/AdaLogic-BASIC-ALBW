-- 123 | Integer roots: floor of the real nth root.
DECLARE MODULE R
    FUNCTION IRoot(n AS S32, x AS S64) AS S64
END DECLARE MODULE

MODULE R
    FUNCTION IRoot(n AS S32, x AS S64) AS S64
        LET lo AS S64 = 0;
        LET hi AS S64 = x;
        WHILE hi - lo > 1
            LET mid AS S64 = (lo + hi) / 2;
            LET pw AS S64 = 1;
            LET over AS S32 = 0;
            FOR k = 1 TO n
                IF mid > 1 ANDALSO pw > x / mid THEN
                    over = 1;
                    BREAK;
                END IF
                pw = pw * mid;
                IF pw > x THEN
                    over = 1;
                    BREAK;
                END IF
            END FOR
            IF over = 1 OR pw > x THEN
                hi = mid;
            ELSE
                lo = mid;
            END IF
        END WHILE
        RETURN lo
    END FUNCTION
END MODULE

IMPORT R
BEGIN
    PRINT R.IRoot(2, 100);
    PRINT R.IRoot(3, 27);
    PRINT R.IRoot(4, 1000000);
    PRINT R.IRoot(2, 99);
END
