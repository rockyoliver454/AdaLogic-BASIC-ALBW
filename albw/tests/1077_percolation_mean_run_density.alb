VERSION 1.0

STRICT gr[256] AS S32
STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0
LET nrun AS S64 = 0
LET rsum AS S64 = 0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION


BEGIN
    sd = 1618
    LET i AS S64 = 0
    WHILE i < 256
        IF Nxt() MOD 100 < 50 THEN gr[i] = 1 ELSE gr[i] = 0 END IF
        i = i + 1
    END WHILE

    nrun = 0
    rsum = 0
    LET y AS S64 = 0
    WHILE y < 16
        LET x AS S64 = 0
        WHILE x < 16
            IF gr[y * 16 + x] = 1 THEN
                LET rl AS S64 = 0
                WHILE x < 16 ANDALSO gr[y * 16 + x] = 1
                    rl = rl + 1
                    x = x + 1
                END WHILE
                nrun = nrun + 1
                rsum = rsum + rl
            ELSE
                x = x + 1
            END IF
        END WHILE
        y = y + 1
    END WHILE

    LET y2 AS S64 = 0
    WHILE y2 < 16
        LET x2 AS S64 = 0
        WHILE x2 < 16
            IF gr[y2 * 16 + x2] = 1 THEN
                LET px AS S64 = x2 * 4
                LET py AS S64 = y2 * 4
                LET yy AS S64 = 0
                WHILE yy < 4
                    LET xx AS S64 = 0
                    WHILE xx < 4
                        img[(py + yy) * 64 + px + xx] = 8453888
                        xx = xx + 1
                    END WHILE
                    yy = yy + 1
                END WHILE
            END IF
            x2 = x2 + 1
        END WHILE
        y2 = y2 + 1
    END WHILE

    CREATE_WINDOW "Mean run density", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "p=0.50 rows=16"
    PRINT "runs=" | nrun
    PRINT "cells=" | rsum
    PRINT "mean_len=" | rsum / nrun
    PRINT "ink=" | ink
    PRINT "hitpx=" | fpx
END
