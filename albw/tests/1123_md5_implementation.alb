    MS[60] = 6
    MS[61] = 10
    MS[62] = 15
    MS[63] = 21

    LET msg AS STRING = "The quick brown fox jumps over the lazy dog"
    LET ml AS S64 = LEN(msg)
    LET i AS S64 = 0
    WHILE i < 64
        MDW[i] = 0
        i = i + 1
    END WHILE
    LET nb AS S64 = ml + 1
    WHILE nb MOD 64 <> 56
        nb = nb + 1
    END WHILE
    LET total AS S64 = nb + 8

    i = 0
    WHILE i < ml
        LET bi AS S64 = i MOD 4
        MDW[i / 4] = MDW[i / 4] + ASC(MID$(msg, i + 1, 1)) * P2[bi * 8]
        i = i + 1
    END WHILE
    i = ml
    MDW[i / 4] = MDW[i / 4] + 128 * P2[(i MOD 4) * 8]
    MDW[total / 4 - 2] = ml * 8
    MDW[total / 4 - 1] = 0

    HA = $67452301
    HB = $EFCDAB89
    HC = $98BADCFE
    HD = $10325476

    LET blk AS S64 = 0
    WHILE blk < total / 64
        MdBlock()
        blk = blk + 1
    END WHILE

    PRINT "md5=" | HexWle(HA) | HexWle(HB) | HexWle(HC) | HexWle(HD)
END
