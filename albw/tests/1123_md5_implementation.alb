VERSION 1.0

STRICT MDW[64] AS S64
STRICT MK[64] AS S64
STRICT MS[64] AS S64
STRICT P2[33] AS S64

LET HA AS S64 = 0
LET HB AS S64 = 0
LET HC AS S64 = 0
LET HD AS S64 = 0

PROCEDURE InitP2()
    LET i AS S64 = 0
    P2[0] = 1
    WHILE i < 32
        P2[i + 1] = P2[i] * 2
        i = i + 1
    END WHILE
END PROCEDURE

FUNCTION RotL(x AS S64, r AS S64) AS S64
    LET e AS S64 = 32 - r
    LET v AS S64 = x SHL r
    v = v AND $FFFFFFFF
    LET w AS S64 = x SHR e
    RETURN v + w
END FUNCTION

FUNCTION HexWle(w AS S64) AS STRING
    LET s AS STRING = ""
    LET i AS S64 = 0
    WHILE i < 4
        LET b AS S64 = (w / P2[i * 8]) MOD 256
        LET n AS S64 = b / 16
        IF n < 10 THEN s = s | CHR(48 + n) ELSE s = s | CHR(87 + n) END IF
        n = b MOD 16
        IF n < 10 THEN s = s | CHR(48 + n) ELSE s = s | CHR(87 + n) END IF
        i = i + 1
    END WHILE
    RETURN s
END FUNCTION

PROCEDURE MdBlock()
    LET a AS S64 = HA
    LET b AS S64 = HB
    LET c AS S64 = HC
    LET d AS S64 = HD
    LET i AS S64 = 0
    WHILE i < 64
        LET f AS S64 = 0
        LET g AS S64 = 0
        IF i < 16 THEN
            f = (b AND c) + ((NOT b) AND d)
            g = i
        ELSE
            IF i < 32 THEN
                f = (d AND b) + ((NOT d) AND c)
                g = (i * 5 + 1) MOD 16
            ELSE
                IF i < 48 THEN
                    f = b XOR c XOR d
                    g = (i * 3 + 5) MOD 16
                ELSE
                    f = (c XOR (b OR (NOT d))) AND $FFFFFFFF
                    g = (i * 7) MOD 16
                END IF
            END IF
        END IF
        LET tmp AS S64 = d
        d = c
        c = b
        LET sum AS S64 = (a + f + MK[i] + MDW[g]) MOD 4294967296
        b = (b + RotL(sum, MS[i])) MOD 4294967296
        a = tmp
        i = i + 1
    END WHILE
    HA = (HA + a) MOD 4294967296
    HB = (HB + b) MOD 4294967296
    HC = (HC + c) MOD 4294967296
    HD = (HD + d) MOD 4294967296
END PROCEDURE


