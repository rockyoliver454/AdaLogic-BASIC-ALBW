-- 592 | Sum to 100: insert +, -, or nothing between digits
-- 123456789 to make 100. Enumerates all 3^8 operator patterns,
-- prints every solution and the count.
DECLARE MODULE Sum100
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sum100
    STRICT ops[8] AS S64

    PROCEDURE Show(sol AS S64)
        LET s AS STRING = "1"
        FOR i = 0 TO 7
            IF ops[i] = 1 THEN s = s | "+" | (i + 2) END IF
            IF ops[i] = -1 THEN s = s | "-" | (i + 2) END IF
            IF ops[i] = 0 THEN s = s | (i + 2) END IF
        END FOR
        PRINT s | " = " | sol
    END PROCEDURE

    PROCEDURE Run()
        LET cnt AS S64 = 0
        FOR code = 0 TO 6560
            LET c AS S64 = code
            FOR i = 0 TO 7
                ops[i] = c MOD 3 - 1
                c = c / 3
            END FOR
            -- evaluate: fold digits with +/-
            LET total AS S64 = 0
            LET cur AS S64 = 1
            LET sgn AS S64 = 1
            FOR j = 0 TO 7
                IF ops[j] = 0 THEN
                    cur = cur * 10 + j + 2
                ELSE
                    total = total + sgn * cur
                    sgn = ops[j]
                    cur = j + 2
                END IF
            END FOR
            total = total + sgn * cur
            IF total = 100 THEN
                cnt = cnt + 1
                Show(total)
            END IF
        END FOR
        PRINT "solutions: " | cnt
    END PROCEDURE
END MODULE

IMPORT Sum100
BEGIN
    Sum100.Run()
END
