    LET pk AS STRING = "0450863AD64A87AE8A2FE83C1AF1A8403CB53F53E486D8511DAD8A04887E5B23522CD470243453A299FA9E77237716103ABC11A1DF38855ED6F2EE187E9C582BA6"
    LET i AS S64 = 0
    WHILE i < 65
        LET hv AS S64 = ASC(MID$(pk, i * 2 + 1, 1))
        LET lv AS S64 = ASC(MID$(pk, i * 2 + 2, 1))
        IF hv > 64 THEN
            hv = hv - 55
        ELSE
            hv = hv - 48
        END IF
        IF lv > 64 THEN
            lv = lv - 55
        ELSE
            lv = lv - 48
        END IF
        SBUF[i] = hv * 16 + lv
        i = i + 1
    END WHILE

    ShaInit()
    ShaBytes(65)
    ShaDigestToRBUF()
    RipeInit()
    RipeBytes(32)

    PL[0] = 0
    STRICT hws[5] AS S64
    hws[0] = H0 hws[1] = H1 hws[2] = H2 hws[3] = H3 hws[4] = H4
    i = 0
    WHILE i < 5
        LET j AS S64 = 0
        WHILE j < 4
            PL[1 + i * 4 + j] = (hws[i] SHR (j * 8)) AND 255
            j = j + 1
        END WHILE
        i = i + 1
    END WHILE

    i = 0
    WHILE i < 21
        SBUF[i] = PL[i]
        i = i + 1
    END WHILE
    ShaInit()
    ShaBytes(21)
    ShaDigestToRBUF()
    i = 0
    WHILE i < 32
        SBUF[i] = RBUF[i]
        i = i + 1
    END WHILE
    ShaInit()
    ShaBytes(32)

    i = 0
    WHILE i < 4
        PL[21 + i] = (SH[0] SHR ((3 - i) * 8)) AND 255
        i = i + 1
    END WHILE

    LET zc AS S64 = 0
    LET zi AS S64 = 0
    WHILE zi < 25
        IF PL[zi] = 0 THEN
            zc = zc + 1
        ELSE
            zi = 25
        END IF
        zi = zi + 1
    END WHILE
    LET b58 AS STRING = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    LET digs AS STRING = ""
    LET done AS S64 = 0
    WHILE done = 0
        LET carry AS S64 = 0
        i = 0
        WHILE i < 25
            LET cur AS S64 = carry * 256 + PL[i]
            PL[i] = cur / 58
            carry = cur - PL[i] * 58
            i = i + 1
        END WHILE
        digs = MID$(b58, carry + 1, 1) | digs
        LET nonzero AS S64 = 0
        i = 0
        WHILE i < 25
            IF PL[i] <> 0 THEN
                nonzero = 1
            END IF
            i = i + 1
        END WHILE
        done = 1 - nonzero
    END WHILE
    zi = 0
    WHILE zi < zc
        digs = "1" | digs
        zi = zi + 1
    END WHILE
    PRINT "address=" | digs
    PRINT "expected=16UwLL9Risc3QfPqBUvKofHmBQ7wMtjvM"
    PRINT "match=" | (digs = "16UwLL9Risc3QfPqBUvKofHmBQ7wMtjvM")
