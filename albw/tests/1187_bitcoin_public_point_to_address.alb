VERSION 1.0

STRICT SK[64] AS S64
STRICT SW[64] AS S64
STRICT SH[8] AS S64
STRICT SBUF[80] AS S64
STRICT MW[16] AS S64
STRICT R1[80] AS S64
STRICT R2[80] AS S64
STRICT S1[80] AS S64
STRICT S2[80] AS S64
STRICT RBUF[80] AS S64
STRICT PL[32] AS S64
STRICT DG[32] AS S64
LET H0 AS S64 = 0
LET H1 AS S64 = 0
LET H2 AS S64 = 0
LET H3 AS S64 = 0
LET H4 AS S64 = 0


FUNCTION RotL(x AS S64, r AS S64) AS S64
    LET e AS S64 = 32 - r
    LET v AS S64 = x SHL r
    v = v AND $FFFFFFFF
    LET w AS S64 = x SHR e
    RETURN v + w
END FUNCTION


FUNCTION RotR(x AS S64, r AS S64) AS S64
    LET e AS S64 = 32 - r
    LET v AS S64 = x SHR r
    LET w AS S64 = (x SHL e) AND $FFFFFFFF
    RETURN v + w
END FUNCTION


FUNCTION F1n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN x XOR y XOR z
END FUNCTION


FUNCTION F2n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x AND y) OR ((NOT x) AND z)
END FUNCTION


FUNCTION F3n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x OR (NOT y)) XOR z
END FUNCTION


FUNCTION F4n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN (x AND z) OR (y AND (NOT z))
END FUNCTION


FUNCTION F5n(x AS S64, y AS S64, z AS S64) AS S64
    RETURN x XOR (y OR (NOT z))
END FUNCTION


PROCEDURE ShaBlock()
    LET i AS S64 = 16
    WHILE i < 64
        LET w15 AS S64 = SW[i - 15]
        LET w2 AS S64 = SW[i - 2]
        LET s0 AS S64 = RotR(w15, 7) XOR RotR(w15, 18) XOR (w15 SHR 3)
        LET s1 AS S64 = RotR(w2, 17) XOR RotR(w2, 19) XOR (w2 SHR 10)
        SW[i] = (SW[i - 16] + s0 + SW[i - 7] + s1) AND $FFFFFFFF
        i = i + 1
    END WHILE
    LET a AS S64 = SH[0]
    LET b AS S64 = SH[1]
    LET c AS S64 = SH[2]
    LET d AS S64 = SH[3]
    LET e AS S64 = SH[4]
    LET f AS S64 = SH[5]
    LET g AS S64 = SH[6]
    LET h AS S64 = SH[7]
    i = 0
    WHILE i < 64
        LET bs1 AS S64 = RotR(e, 6) XOR RotR(e, 11) XOR RotR(e, 25)
        LET ch AS S64 = (e AND f) + ((NOT e) AND g)
        LET t1 AS S64 = (h + bs1 + ch + SK[i] + SW[i]) AND $FFFFFFFF
        LET bs0 AS S64 = RotR(a, 2) XOR RotR(a, 13) XOR RotR(a, 22)
        LET mj AS S64 = (a AND b) XOR (a AND c) XOR (b AND c)
        h = g
        g = f
        f = e
        e = (d + t1) AND $FFFFFFFF
        d = c
        c = b
        b = a
        a = (t1 + bs0 + mj) AND $FFFFFFFF
        i = i + 1
    END WHILE
    SH[0] = (SH[0] + a) AND $FFFFFFFF
    SH[1] = (SH[1] + b) AND $FFFFFFFF
    SH[2] = (SH[2] + c) AND $FFFFFFFF
    SH[3] = (SH[3] + d) AND $FFFFFFFF
    SH[4] = (SH[4] + e) AND $FFFFFFFF
    SH[5] = (SH[5] + f) AND $FFFFFFFF
    SH[6] = (SH[6] + g) AND $FFFFFFFF
    SH[7] = (SH[7] + h) AND $FFFFFFFF
END PROCEDURE


PROCEDURE ShaInit()
    SH[0] = $6A09E667
    SH[1] = $BB67AE85
    SH[2] = $3C6EF372
    SH[3] = $A54FF53A
    SH[4] = $510E527F
    SH[5] = $9B05688C
    SH[6] = $1F83D9AB
    SH[7] = $5BE0CD19
END PROCEDURE


PROCEDURE ShaBytes(n AS S64)
    LET total AS S64 = n + 1
    WHILE total MOD 64 <> 56
        total = total + 1
    END WHILE
    total = total + 8
    LET nblk AS S64 = total / 64
    LET blk AS S64 = 0
    WHILE blk < nblk
        LET i AS S64 = 0
        WHILE i < 16
            SW[i] = 0
            i = i + 1
        END WHILE
        i = 0
        WHILE i < 64
            LET gi AS S64 = blk * 64 + i
            LET bv AS S64 = 0
            IF gi < n THEN
                bv = SBUF[gi]
            ELSE
                IF gi = n THEN
                    bv = 128
                END IF
            END IF
            LET wi AS S64 = i / 4
            LET rm AS S64 = i - wi * 4
            SW[wi] = SW[wi] + bv * (1 SHL ((3 - rm) * 8))
            i = i + 1
        END WHILE
        IF blk = nblk - 1 THEN
            SW[15] = n * 8
        END IF
        ShaBlock()
        blk = blk + 1
    END WHILE
END PROCEDURE


PROCEDURE RipeInit()
    H0 = $67452301
    H1 = $EFCDAB89
    H2 = $98BADCFE
    H3 = $10325476
    H4 = $C3D2E1F0
END PROCEDURE


PROCEDURE RipeBlock()
    LET h0 AS S64 = H0
    LET h1 AS S64 = H1
    LET h2 AS S64 = H2
    LET h3 AS S64 = H3
    LET h4 AS S64 = H4
    LET a1 AS S64 = h0
    LET b1 AS S64 = h1
    LET c1 AS S64 = h2
    LET d1 AS S64 = h3
    LET e1 AS S64 = h4
    LET a2 AS S64 = h0
    LET b2 AS S64 = h1
    LET c2 AS S64 = h2
    LET d2 AS S64 = h3
    LET e2 AS S64 = h4
    LET j AS S64 = 0
    WHILE j < 80
        LET rd AS S64 = j / 16
        LET f AS S64 = 0
        LET kk AS S64 = 0
        IF rd = 0 THEN
            f = F1n(b1, c1, d1)
            kk = 0
        ELSE
            IF rd = 1 THEN
                f = F2n(b1, c1, d1)
                kk = $5A827999
            ELSE
                IF rd = 2 THEN
                    f = F3n(b1, c1, d1)
                    kk = $6ED9EBA1
                ELSE
                    IF rd = 3 THEN
                        f = F4n(b1, c1, d1)
                        kk = $8F1BBCDC
                    ELSE
                        f = F5n(b1, c1, d1)
                        kk = $A953FD4E
                    END IF
                END IF
            END IF
        END IF
        LET tv AS S64 = (a1 + f + MW[R1[j]] + kk) AND $FFFFFFFF
        tv = (RotL(tv, S1[j]) + e1) AND $FFFFFFFF
        a1 = e1
        e1 = d1
        d1 = RotL(c1, 10)
        c1 = b1
        b1 = tv
        IF rd = 0 THEN
            f = F5n(b2, c2, d2)
            kk = $50A28BE6
        ELSE
            IF rd = 1 THEN
                f = F4n(b2, c2, d2)
                kk = $5C4DD124
            ELSE
                IF rd = 2 THEN
                    f = F3n(b2, c2, d2)
                    kk = $6D703EF3
                ELSE
                    IF rd = 3 THEN
                        f = F2n(b2, c2, d2)
                        kk = $7A6D76E9
                    ELSE
                        f = F1n(b2, c2, d2)
                        kk = 0
                    END IF
                END IF
            END IF
        END IF
        tv = (a2 + f + MW[R2[j]] + kk) AND $FFFFFFFF
        tv = (RotL(tv, S2[j]) + e2) AND $FFFFFFFF
        a2 = e2
        e2 = d2
        d2 = RotL(c2, 10)
        c2 = b2
        b2 = tv
        j = j + 1
    END WHILE
    LET tt AS S64 = (h1 + c1 + d2) AND $FFFFFFFF
    H1 = (h2 + d1 + e2) AND $FFFFFFFF
    H2 = (h3 + e1 + a2) AND $FFFFFFFF
    H3 = (h4 + a1 + b2) AND $FFFFFFFF
    H4 = (h0 + b1 + c2) AND $FFFFFFFF
    H0 = tt
END PROCEDURE


PROCEDURE RipeBytes(n AS S64)
    LET i AS S64 = 0
    WHILE i < 16
        MW[i] = 0
        i = i + 1
    END WHILE
    i = 0
    WHILE i < n
        LET wi AS S64 = i / 4
        LET sh AS S64 = (i - wi * 4) * 8
        MW[wi] = MW[wi] + RBUF[i] * (1 SHL sh)
        i = i + 1
    END WHILE
    LET wi2 AS S64 = n / 4
    LET sh2 AS S64 = (n - wi2 * 4) * 8
    MW[wi2] = MW[wi2] + 128 * (1 SHL sh2)
    MW[14] = n * 8
    RipeBlock()
END PROCEDURE


PROCEDURE ShaDigestToRBUF()
    LET i AS S64 = 0
    WHILE i < 8
        LET j AS S64 = 0
        WHILE j < 4
            RBUF[i * 4 + j] = (SH[i] SHR ((3 - j) * 8)) AND 255
            j = j + 1
        END WHILE
        i = i + 1
    END WHILE
END PROCEDURE


