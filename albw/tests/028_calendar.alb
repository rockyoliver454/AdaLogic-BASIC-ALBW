-- 028 | Calendar: print a month grid (Sakamoto day-of-week).
DECLARE MODULE Cal
    FUNCTION Dow(y AS S32, m AS S32, d AS S32) AS S32
END DECLARE MODULE

MODULE Cal
    FUNCTION Dow(y AS S32, m AS S32, d AS S32) AS S32
        STRICT t[12] AS S32;
        t[0]=0; t[1]=3; t[2]=2; t[3]=5; t[4]=0; t[5]=3;
        t[6]=5; t[7]=1; t[8]=4; t[9]=6; t[10]=2; t[11]=4;
        IF m < 3 THEN
            y = y - 1;
        END IF
        RETURN (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) MOD 7
    END FUNCTION
END MODULE

IMPORT Cal
BEGIN
    LET y AS S32 = 2024;
    LET mo AS S32 = 3;
    LET days AS S32 = 31;
    PRINT$ "March " | y;
    PRINT$ "Su Mo Tu We Th Fr Sa";
    LET off AS S32 = Cal.Dow(y, mo, 1);
    LET row AS STRING = "";
    FOR i = 0 TO off - 1
        row = row | "   ";
    END FOR
    FOR d = 1 TO days
        IF d < 10 THEN
            row = row | " " | d | " ";
        ELSE
            row = row | d | " ";
        END IF
        IF (off + d) MOD 7 = 0 THEN
            PRINT$ row;
            row = "";
        END IF
    END FOR
    IF LEN(row) > 0 THEN
        PRINT$ row;
    END IF
END
