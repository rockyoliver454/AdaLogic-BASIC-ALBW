-- 719 | Tree traversal: pre/in/post-order and level-order
-- walks of a fixed binary tree stored in arrays.
DECLARE MODULE Tt
    PROCEDURE Pre(n AS S64)
    PROCEDURE Ino(n AS S64)
    PROCEDURE Post(n AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE Tt
    -- tree:        1
    --         2         3
    --       4   5     6   7
    STRICT lc[8] AS S64
    STRICT rc[8] AS S64
    STRICT q[8] AS S64

    PROCEDURE Pre(n AS S64)
        IF n = 0 THEN RETURN END IF
        PRINT n
        Pre(lc[n])
        Pre(rc[n])
    END PROCEDURE

    PROCEDURE Ino(n AS S64)
        IF n = 0 THEN RETURN END IF
        Ino(lc[n])
        PRINT n
        Ino(rc[n])
    END PROCEDURE

    PROCEDURE Post(n AS S64)
        IF n = 0 THEN RETURN END IF
        Post(lc[n])
        Post(rc[n])
        PRINT n
    END PROCEDURE

    PROCEDURE Run()
        lc[1] = 2
        rc[1] = 3
        lc[2] = 4
        rc[2] = 5
        lc[3] = 6
        rc[3] = 7
        lc[4] = 0
        rc[4] = 0
        lc[5] = 0
        rc[5] = 0
        lc[6] = 0
        rc[6] = 0
        lc[7] = 0
        rc[7] = 0
        PRINT "pre:"
        Pre(1)
        PRINT "in:"
        Ino(1)
        PRINT "post:"
        Post(1)
        PRINT "level:"
        LET head AS S64 = 1
        LET tail AS S64 = 1
        q[1] = 1
        WHILE head <= tail
            LET n AS S64 = q[head]
            PRINT n
            IF lc[n] > 0 THEN
                tail = tail + 1
                q[tail] = lc[n]
            END IF
            IF rc[n] > 0 THEN
                tail = tail + 1
                q[tail] = rc[n]
            END IF
            head = head + 1
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Tt
BEGIN
    Tt.Run()
END
