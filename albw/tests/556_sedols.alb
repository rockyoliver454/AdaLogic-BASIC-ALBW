-- 556 | SEDOL check digit: weights 1,3,1,7,3,9 over alphanumeric
-- positions; RC example 710889 -> 9.
DECLARE MODULE Sedol
    FUNCTION Chk(s AS STRING) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sedol
    STRICT w[6] AS S64

    FUNCTION CharVal(c AS S64) AS S64
        IF c >= 48 ANDALSO c <= 57 THEN RETURN c - 48 END IF
        RETURN c - 55
    END FUNCTION

    FUNCTION Chk(s AS STRING) AS S64
        LET sum AS S64 = 0
        FOR i = 1 TO 6
            sum = sum + CharVal(ASC(MID$(s, i, 1))) * w[i]
        END FOR
        RETURN (10 - sum MOD 10) MOD 10
    END FUNCTION

    PROCEDURE Run()
        w[1] = 1
        w[2] = 3
        w[3] = 1
        w[4] = 7
        w[5] = 3
        w[6] = 9
        PRINT "710889 -> " | Chk("710889")
        PRINT "B0YBKJ -> " | Chk("B0YBKJ")
        PRINT "406566 -> " | Chk("406566")
    END PROCEDURE
END MODULE

IMPORT Sedol
BEGIN
    Sedol.Run()
END
