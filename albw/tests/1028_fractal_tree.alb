VERSION 1.0
STRICT x1[130] AS S64
STRICT y1[130] AS S64
STRICT x2[130] AS S64
STRICT y2[130] AS S64

LET frames AS S64 = 0
LET nseg AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE Branch(xi AS S64, yi AS S64, p AS S64)
    LET d AS S64 = p MOD 16
    LET q AS S64 = p / 16
    LET bl AS S64 = q MOD 65536
    LET a AS S64 = q / 65536 - 512
    LET xf AS F64 = xi * 1.0
    LET yf AS F64 = yi * 1.0
    LET bf AS F64 = bl * 1.0
    LET nxi AS S64 = ROUND(xf + Sn(a) * bf)
    LET nyi AS S64 = ROUND(yf - Cs(a) * bf)
    x1[nseg] = xi / 100 y1[nseg] = yi / 100
    x2[nseg] = nxi / 100 y2[nseg] = nyi / 100
    nseg = nseg + 1
    IF d > 0 THEN
        LET nb AS S64 = (bl * 70) / 100
        CALL Branch(nxi, nyi, ((a - 30 + 512) * 65536 + nb) * 16 + d - 1)
        CALL Branch(nxi, nyi, ((a + 30 + 512) * 65536 + nb) * 16 + d - 1)
    END IF
END PROCEDURE

BEGIN
    CALL Branch(3200, 6200, ((0 + 512) * 65536 + 2000) * 16 + 6)

    CREATE_WINDOW "Fractal tree", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $00FF40
        i = 0
        WHILE i < nseg
            DRAW LINE x1[i], y1[i], x2[i], y2[i]
            i = i + 1
        END WHILE
        fpx = READ_PIXEL(x1[0], y1[0])
    END

    LISTEN

    PRINT "depth=6"
    PRINT "branches=" | nseg
    PRINT "trunk=(" | x1[0] | "," | y1[0] | ")->(" | x2[0] | "," | y2[0] | ")"
    PRINT "root_px=" | fpx
END
