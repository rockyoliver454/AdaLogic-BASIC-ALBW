-- 396 | Lucky and even lucky numbers: sieve-based; first 20 of each.
DECLARE MODULE Lucky
    PROCEDURE Run()
END DECLARE MODULE

MODULE Lucky
    STRICT arr[2048] AS S64
    PROCEDURE Run()
        LET sz AS S32 = 400
        LET stp AS S64 = 0
        LET wi AS S32 = 0
        FOR i = 0 TO sz - 1
            arr[i] = 2 * i + 1
        END FOR
        LET pos AS S32 = 1
        WHILE pos < sz
            stp = arr[pos]
            wi = 1
            FOR i = 1 TO sz - 1
                IF (i + 1) MOD stp <> 0 THEN
                    arr[wi] = arr[i]
                    wi = wi + 1
                END IF
            END FOR
            sz = wi
            IF pos >= sz THEN
                pos = sz
            ELSE
                pos = pos + 1
            END IF
        END WHILE
        LET s AS STRING = "lucky: "
        FOR i = 0 TO 19
            s = s | arr[i] | " "
        END FOR
        PRINT s
        sz = 400
        FOR i = 0 TO sz - 1
            arr[i] = 2 * (i + 1)
        END FOR
        pos = 1
        WHILE pos < sz
            stp = arr[pos]
            wi = 1
            FOR i = 1 TO sz - 1
                IF (i + 1) MOD stp <> 0 THEN
                    arr[wi] = arr[i]
                    wi = wi + 1
                END IF
            END FOR
            sz = wi
            IF pos >= sz THEN
                pos = sz
            ELSE
                pos = pos + 1
            END IF
        END WHILE
        LET s2 AS STRING = "even lucky: "
        FOR i = 0 TO 19
            s2 = s2 | arr[i] | " "
        END FOR
        PRINT s2
    END PROCEDURE
END MODULE

IMPORT Lucky
BEGIN
    Lucky.Run()
END
