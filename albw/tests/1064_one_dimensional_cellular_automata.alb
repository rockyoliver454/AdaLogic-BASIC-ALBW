VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET gen AS S64 = 0


BEGIN
    img[32] = 16777215
    gen = 1
    WHILE gen < 56
        LET x AS S64 = 1
        WHILE x < 63
            LET l AS S64 = img[(gen - 1) * 64 + x - 1]
            LET r AS S64 = img[(gen - 1) * 64 + x + 1]
            IF (l <> 0 ANDALSO r = 0) ORELSE (l = 0 ANDALSO r <> 0) THEN
                img[gen * 64 + x] = 16777215
            END IF
            x = x + 1
        END WHILE
        gen = gen + 1
    END WHILE

    CREATE_WINDOW "1D cellular automata", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "rule=90 gens=55"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
