VERSION 1.0

STRICT ia[4096] AS S32
STRICT ib[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET dif AS S64 = 0


BEGIN
    LET i AS S64 = 0
    WHILE i < 4096
        LET x AS S64 = i MOD 64
        LET y AS S64 = i / 64
        LET v AS S64 = (x * 4) MOD 256
        ia[i] = v * 65536 + v * 256 + v
        ib[i] = ia[i]
        IF x >= 16 ANDALSO x < 48 ANDALSO y >= 16 ANDALSO y < 48 THEN
            ib[i] = 16711680
        END IF
        i = i + 1
    END WHILE

    dif = 0
    i = 0
    WHILE i < 4096
        IF ia[i] <> ib[i] THEN
            dif = dif + 1
        END IF
        i = i + 1
    END WHILE

    CREATE_WINDOW "Image difference", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            COLOR ib[k]
            PLOT k MOD 64, k / 64
            ink = ink + 1
            chk = chk + ib[k] / 256
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(32, 32)
    END

    LISTEN

    PRINT "differing=" | dif
    PRINT "pct=" | (dif * 100) / 4096 | "%"
    PRINT "ink=" | ink
    PRINT "px(32,32)=" | fpx
END
