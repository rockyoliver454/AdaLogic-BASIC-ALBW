VERSION 1.0

STRICT ff[1024] AS S32
STRICT f2[1024] AS S32
STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0
LET burnt AS S64 = 0
LET alive AS S64 = 0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION


BEGIN
    sd = 4242
    LET i AS S64 = 0
    WHILE i < 1024
        IF Nxt() MOD 100 < 60 THEN ff[i] = 1 ELSE ff[i] = 0 END IF
        i = i + 1
    END WHILE
    ff[528] = 2

    LET fstep AS S64 = 0
    WHILE fstep < 30
        i = 0
        WHILE i < 1024
            f2[i] = ff[i]
            i = i + 1
        END WHILE
        LET y AS S64 = 1
        WHILE y < 31
            LET x AS S64 = 1
            WHILE x < 31
                LET c AS S64 = y * 32 + x
                IF ff[c] = 2 THEN
                    f2[c] = 0
                    IF ff[c - 33] = 1 THEN f2[c - 33] = 2 END IF
                    IF ff[c - 32] = 1 THEN f2[c - 32] = 2 END IF
                    IF ff[c - 31] = 1 THEN f2[c - 31] = 2 END IF
                    IF ff[c - 1] = 1 THEN f2[c - 1] = 2 END IF
                    IF ff[c + 1] = 1 THEN f2[c + 1] = 2 END IF
                    IF ff[c + 31] = 1 THEN f2[c + 31] = 2 END IF
                    IF ff[c + 32] = 1 THEN f2[c + 32] = 2 END IF
                    IF ff[c + 33] = 1 THEN f2[c + 33] = 2 END IF
                END IF
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
        i = 0
        WHILE i < 1024
            ff[i] = f2[i]
            i = i + 1
        END WHILE
        fstep = fstep + 1
    END WHILE

    alive = 0
    burnt = 0
    i = 0
    WHILE i < 1024
        IF ff[i] = 1 THEN alive = alive + 1 END IF
        i = i + 1
    END WHILE

    i = 0
    WHILE i < 1024
        LET v AS S64 = ff[i]
        LET c2 AS S64 = 0
        IF v = 1 THEN c2 = 65280 END IF
        IF v = 2 THEN c2 = 16711680 END IF
        LET cx AS S64 = (i MOD 32) * 2
        LET cy AS S64 = (i / 32) * 2
        LET yy AS S64 = 0
        WHILE yy < 2
            LET xx AS S64 = 0
            WHILE xx < 2
                img[(cy + yy) * 64 + cx + xx] = c2
                xx = xx + 1
            END WHILE
            yy = yy + 1
        END WHILE
        i = i + 1
    END WHILE

    CREATE_WINDOW "Forest fire", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "steps=30"
    PRINT "trees_left=" | alive
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
