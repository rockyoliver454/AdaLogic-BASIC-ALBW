-- 637 | Honaker primes: primes p (index i) where digit-sum(p)
-- equals digit-sum(i).
DECLARE MODULE Hon
    FUNCTION IsPrime(n AS S64) AS S32
    FUNCTION DigSum(n AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Hon
    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        LET d AS S64 = 2
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 1
        END WHILE
        RETURN 1
    END FUNCTION

    FUNCTION DigSum(n AS S64) AS S64
        LET s AS S64 = 0
        LET m AS S64 = n
        WHILE m > 0
            s = s + m MOD 10
            m = m / 10
        END WHILE
        RETURN s
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET idx AS S64 = 0
        FOR n = 2 TO 1999
            IF IsPrime(n) = 1 THEN
                idx = idx + 1
                IF DigSum(n) = DigSum(idx) THEN s = s | n | " " END IF
            END IF
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Hon
BEGIN
    Hon.Run()
END
