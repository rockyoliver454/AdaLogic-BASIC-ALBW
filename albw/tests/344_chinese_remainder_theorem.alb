-- 344 | Chinese remainder theorem: solve the classic n = 2,3,2 (mod 3,5,7).
DECLARE MODULE CRT
    FUNCTION Solve() AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE CRT
    STRICT rems[8] AS S64
    STRICT mods[8] AS S64

    FUNCTION Solve() AS S64
        LET prod AS S64 = 1
        FOR i = 0 TO 2
            prod = prod * mods[i]
        END FOR
        LET x AS S64 = 0
        FOR i = 0 TO 2
            LET p AS S64 = prod / mods[i]
            LET inv AS S64 = 0
            LET t AS S64 = 1
            WHILE t < mods[i]
                IF (p * t) MOD mods[i] = 1 THEN
                    inv = t
                    t = mods[i]
                END IF
                t = t + 1
            END WHILE
            x = x + rems[i] * p * inv
        END FOR
        RETURN x MOD prod
    END FUNCTION

    PROCEDURE Run()
        rems[0] = 2
        rems[1] = 3
        rems[2] = 2
        mods[0] = 3
        mods[1] = 5
        mods[2] = 7
        LET x AS S64 = Solve()
        PRINT "x = " | x
        PRINT "check: " | (x MOD 3) | " " | (x MOD 5) | " " | (x MOD 7)
    END PROCEDURE
END MODULE

IMPORT CRT
BEGIN
    CRT.Run()
END
