-- 404 | Jacobsthal numbers: J(0)=0, J(1)=1, J(n)=J(n-1)+2J(n-2); first 20.
DECLARE MODULE Jacobsthal
    PROCEDURE Run()
END DECLARE MODULE

MODULE Jacobsthal
    STRICT j[32] AS S64

    PROCEDURE Run()
        j[0] = 0
        j[1] = 1
        FOR n = 2 TO 19
            j[n] = j[n - 1] + 2 * j[n - 2]
        END FOR
        LET s AS STRING = ""
        FOR n = 0 TO 19
            s = s | j[n] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Jacobsthal
BEGIN
    Jacobsthal.Run()
END
