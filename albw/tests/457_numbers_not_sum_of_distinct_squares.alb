-- 457 | Numbers which are not the sum of distinct squares: all such
-- n <= 500, found by subset-sum marking.
DECLARE MODULE NotSq
    PROCEDURE Run()
END DECLARE MODULE

MODULE NotSq
    STRICT reach[501] AS S32

    PROCEDURE Run()
        FOR i = 0 TO 500
            reach[i] = 0
        END FOR
        reach[0] = 1
        FOR k = 1 TO 22
            LET sq AS S64 = k * k
            LET j AS S64 = 500
            WHILE j >= sq
                IF reach[j - sq] = 1 THEN reach[j] = 1 END IF
                j = j - 1
            END WHILE
        END FOR
        LET s AS STRING = ""
        FOR n = 1 TO 500
            IF reach[n] = 0 THEN s = s | n | " " END IF
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT NotSq
BEGIN
    NotSq.Run()
END
