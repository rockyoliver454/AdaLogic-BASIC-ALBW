VERSION 1.0

STRICT img[4096] AS S32
STRICT cx[4] AS S64
STRICT cy[4] AS S64

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET npx AS S64 = 0

PROCEDURE BC()
    LET t AS F64 = 0.0
    WHILE t <= 1.0
        LET u AS F64 = 1.0 - t
        LET x0 AS F64 = cx[0] * 1.0
        LET x1 AS F64 = cx[1] * 1.0
        LET x2 AS F64 = cx[2] * 1.0
        LET x3 AS F64 = cx[3] * 1.0
        LET y0 AS F64 = cy[0] * 1.0
        LET y1 AS F64 = cy[1] * 1.0
        LET y2 AS F64 = cy[2] * 1.0
        LET y3 AS F64 = cy[3] * 1.0
        LET uu AS F64 = u * u
        LET tt AS F64 = t * t
        LET xf AS F64 = uu * u * x0 + 3.0 * uu * t * x1 + 3.0 * u * tt * x2 + tt * t * x3
        LET yf AS F64 = uu * u * y0 + 3.0 * uu * t * y1 + 3.0 * u * tt * y2 + tt * t * y3
        LET sx AS S64 = ROUND(xf)
        LET sy AS S64 = ROUND(yf)
        IF sx >= 0 ANDALSO sx < 64 ANDALSO sy >= 0 ANDALSO sy < 64 THEN
            img[sy * 64 + sx] = 16711935
            npx = npx + 1
        END IF
        t = t + 0.01
    END WHILE
END PROCEDURE


BEGIN
    cx[0] = 4 cy[0] = 32
    cx[1] = 20 cy[1] = 4
    cx[2] = 44 cy[2] = 60
    cx[3] = 60 cy[3] = 32
    CALL BC()

    CREATE_WINDOW "Bezier cubic", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "pts=101"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
