-- 934 | Permutation test: two small samples; count how many
-- reassignments of labels give a mean-difference at least as
-- extreme as observed. Exact enumeration of C(9,4)=126 splits.
DECLARE MODULE Pt
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pt
    STRICT dt[10] AS S64
    STRICT cnt[1] AS S64
    STRICT tot[1] AS S64
    STRICT obs[1] AS S64

    PROCEDURE Run()
        -- group A: 1,1,1 ; group B: 2,3,4  (toy: A = 3,4,5; B=6,7,8)
        dt[1] = 3
        dt[2] = 4
        dt[3] = 5
        dt[4] = 6
        dt[5] = 7
        dt[6] = 8
        LET n AS S64 = 6
        LET na AS S64 = 3
        -- observed |meanA - meanB|
        LET sa AS S64 = dt[1] + dt[2] + dt[3]
        LET sb AS S64 = dt[4] + dt[5] + dt[6]
        obs[1] = (sb * na - sa * (n - na))
        IF obs[1] < 0 THEN obs[1] = 0 - obs[1] END IF
        -- enumerate choose(n,na)=20 subsets, compare |sA'*(n-na)-sB'*na|
        cnt[1] = 0
        tot[1] = 0
        FOR a = 1 TO 6
        FOR b = 1 TO 6
        FOR c = 1 TO 6
            IF a < b ANDALSO b < c THEN
                LET sa2 AS S64 = dt[a] + dt[b] + dt[c]
                LET sb2 AS S64 = 21 - sa2
                LET d AS S64 = sa2 * (n - na) - sb2 * na
                IF d < 0 THEN d = 0 - d END IF
                tot[1] = tot[1] + 1
                IF d >= obs[1] THEN cnt[1] = cnt[1] + 1 END IF
            END IF
        END FOR
        END FOR
        END FOR
        PRINT "splits=" | tot[1]
        PRINT "as-or-more-extreme=" | cnt[1]
        PRINT "p~" | cnt[1] | "/" | tot[1]
    END PROCEDURE
END MODULE

IMPORT Pt
BEGIN
    Pt.Run()
END
