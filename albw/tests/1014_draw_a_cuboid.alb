VERSION 1.0
STRICT vx[8] AS S64
STRICT vy[8] AS S64
STRICT vz[8] AS S64
STRICT px[8] AS S64
STRICT py[8] AS S64
STRICT ex[12] AS S64
STRICT ey[12] AS S64

LET frames AS S64 = 0
LET ipx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE Project()
    LET i AS S64 = 0
    LET cy AS F64 = Sn(30)
    LET sy AS F64 = Cs(30)
    LET cp AS F64 = Sn(20)
    LET sp AS F64 = Cs(20)
    LET xr AS F64 = 0
    LET zr AS F64 = 0
    LET yr AS F64 = 0
    LET xf AS F64 = vx[0] * 1.0
    WHILE i < 8
        xf = vx[i] * 1.0
        xr = xf * sy + (vz[i] * 1.0) * cy
        zr = (vz[i] * 1.0) * sy - xf * cy
        yr = (vy[i] * 1.0) * sp - zr * cp
        px[i] = ROUND(48.0 + xr)
        py[i] = ROUND(32.0 - yr)
        i = i + 1
    END WHILE
END PROCEDURE

BEGIN
    vx[0] = 0 - 24
    vx[1] = 24
    vx[2] = 0 - 24
    vx[3] = 24
    vx[4] = 0 - 24
    vx[5] = 24
    vx[6] = 0 - 24
    vx[7] = 24
    vy[0] = 0 - 16
    vy[1] = 0 - 16
    vy[2] = 16
    vy[3] = 16
    vy[4] = 0 - 16
    vy[5] = 0 - 16
    vy[6] = 16
    vy[7] = 16
    vz[0] = 0 - 10
    vz[1] = 0 - 10
    vz[2] = 0 - 10
    vz[3] = 0 - 10
    vz[4] = 10
    vz[5] = 10
    vz[6] = 10
    vz[7] = 10

    ex[0] = 0 ey[0] = 1 ex[1] = 1 ey[1] = 3 ex[2] = 3 ey[2] = 2 ex[3] = 2 ey[3] = 0
    ex[4] = 4 ey[4] = 5 ex[5] = 5 ey[5] = 7 ex[6] = 7 ey[6] = 6 ex[7] = 6 ey[7] = 4
    ex[8] = 0 ey[8] = 4 ex[9] = 1 ey[9] = 5 ex[10] = 2 ey[10] = 6 ex[11] = 3 ey[11] = 7

    CALL Project()

    CREATE_WINDOW "Draw a cuboid", 96, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET i AS S64 = 0
        CLEAR $000000
        COLOR $FFFF00
        i = 0
        WHILE i < 12
            DRAW LINE px[ex[i]], py[ex[i]], px[ey[i]], py[ey[i]]
            i = i + 1
        END WHILE
        ipx = READ_PIXEL(px[0], py[0])
    END

    LISTEN

    LET i AS S64 = 0
    WHILE i < 8
        PRINT "v" | i | "=(" | px[i] | "," | py[i] | ")"
        i = i + 1
    END WHILE
    PRINT "edges=12 ink=" | ipx
END
