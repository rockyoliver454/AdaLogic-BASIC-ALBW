-- 452 | Sailors, coconuts and a monkey: smallest solution for
-- 5 sailors, and the general solver for 2..6 sailors.
DECLARE MODULE Coco
    FUNCTION Works(nuts AS S64, sailors AS S64) AS S32
    FUNCTION Solve(sailors AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Coco
    FUNCTION Works(nuts AS S64, sailors AS S64) AS S32
        LET n AS S64 = nuts
        FOR i = 1 TO sailors
            IF n MOD sailors <> 1 THEN RETURN 0 END IF
            n = n - 1 - n / sailors
        END FOR
        IF n MOD sailors <> 0 THEN RETURN 0 END IF
        RETURN 1
    END FUNCTION

    FUNCTION Solve(sailors AS S64) AS S64
        LET n AS S64 = 1
        WHILE Works(n, sailors) = 0
            n = n + 1
        END WHILE
        RETURN n
    END FUNCTION

    PROCEDURE Run()
        FOR s = 2 TO 6
            PRINT "sailors=" | s | " nuts=" | Solve(s)
        END FOR
    END PROCEDURE
END MODULE

IMPORT Coco
BEGIN
    Coco.Run()
END
