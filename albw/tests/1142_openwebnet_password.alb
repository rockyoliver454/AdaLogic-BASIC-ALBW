VERSION 1.0

LET RES AS S64 = 0

PROCEDURE CalcPass(pwd AS S64, nonce AS STRING)
    LET flag AS S64 = 1
    LET n1 AS S64 = 0
    LET n2 AS S64 = 0
    LET i AS S64 = 1
    WHILE i <= LEN(nonce)
        LET c AS S64 = ASC(MID$(nonce, i, 1)) - 48
        n2 = n2 AND $FFFFFFFF
        IF c <> 0 ANDALSO flag = 1 THEN
            n2 = pwd
        END IF
        IF c <> 0 ORELSE flag = 0 THEN
            flag = 0
        END IF
        IF c = 1 THEN
            n1 = (n2 AND $FFFFFF80) SHR 7
            n1 = n1 + ((n2 SHL 25) AND $FFFFFFFF)
        ELSE
            IF c = 2 THEN
                n1 = (n2 AND $FFFFFFF0) SHR 4
                n1 = n1 + ((n2 SHL 28) AND $FFFFFFFF)
            ELSE
                IF c = 3 THEN
                    n1 = (n2 AND $FFFFFFF8) SHR 3
                    n1 = n1 + ((n2 SHL 29) AND $FFFFFFFF)
                ELSE
                    IF c = 4 THEN
                        n1 = (n2 SHL 1) AND $FFFFFFFF
                        n1 = n1 + (n2 SHR 31)
                    ELSE
                        IF c = 5 THEN
                            n1 = (n2 SHL 5) AND $FFFFFFFF
                            n1 = n1 + (n2 SHR 27)
                        ELSE
                            IF c = 6 THEN
                                n1 = (n2 SHL 12) AND $FFFFFFFF
                                n1 = n1 + (n2 SHR 20)
                            ELSE
                                IF c = 7 THEN
                                    n1 = (n2 AND $FF00)
                                    n1 = n1 + ((n2 AND $FF) SHL 24)
                                    n1 = n1 + ((n2 AND $FF0000) SHR 16)
                                    n1 = n1 + ((n2 AND $FF000000) SHR 8)
                                ELSE
                                    IF c = 8 THEN
                                        n1 = ((n2 AND $FFFF) SHL 16) AND $FFFFFFFF
                                        n1 = n1 + (n2 SHR 24)
                                        n1 = n1 + ((n2 AND $FF0000) SHR 8)
                                    ELSE
                                        IF c = 9 THEN
                                            n1 = (NOT n2) AND $FFFFFFFF
                                        ELSE
                                            n1 = n2
                                        END IF
                                    END IF
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        END IF
        n2 = n1
        i = i + 1
    END WHILE
    RES = n1 AND $FFFFFFFF
END PROCEDURE


BEGIN
    CalcPass(12345, "603356072")
    PRINT "603356072 -> " | RES | " (expect 25280520)"
    CalcPass(12345, "410501656")
    PRINT "410501656 -> " | RES | " (expect 119537670)"
    CalcPass(12345, "630292165")
    PRINT "630292165 -> " | RES | " (expect 4269684735)"
END
