-- 241 | Tree from nesting levels: derive each node's parent from preorder depths.
BEGIN
    STRICT node_value[7] AS STRING
    STRICT node_level[7] AS S32
    STRICT parent_node[7] AS S32
    STRICT latest_at_level[4] AS S32

    node_value[0] = "A"; node_level[0] = 0
    node_value[1] = "B"; node_level[1] = 1
    node_value[2] = "C"; node_level[2] = 2
    node_value[3] = "D"; node_level[3] = 2
    node_value[4] = "E"; node_level[4] = 1
    node_value[5] = "F"; node_level[5] = 2
    node_value[6] = "G"; node_level[6] = 3

    FOR i = 0 TO 6
        LET depth AS S32 = node_level[i]
        IF depth = 0 THEN
            parent_node[i] = -1
        ELSE
            parent_node[i] = latest_at_level[depth - 1]
        END IF
        latest_at_level[depth] = i
    END FOR

    FOR i = 0 TO 6
        IF parent_node[i] < 0 THEN
            PRINT node_value[i] | " <- root"
        ELSE
            PRINT node_value[i] | " <- " | node_value[parent_node[i]]
        END IF
    END FOR
END
