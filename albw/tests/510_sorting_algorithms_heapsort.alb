-- 510 | Sorting algorithms/Heapsort.
DECLARE MODULE Heap
    PROCEDURE Sift(lo AS S64, hi AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE Heap
    STRICT a[11] AS S64

    PROCEDURE Sift(lo AS S64, hi AS S64)
        LET root AS S64 = lo
        LET done AS S32 = 0
        WHILE root * 2 - lo + 1 <= hi ANDALSO done = 0
            LET child AS S64 = root * 2 - lo + 1
            LET swap AS S64 = root
            IF a[swap] < a[child] THEN swap = child END IF
            IF child + 1 <= hi ANDALSO a[swap] < a[child + 1] THEN swap = child + 1 END IF
            IF swap = root THEN
                done = 1
            ELSE
                LET t AS S64 = a[root]
                a[root] = a[swap]
                a[swap] = t
                root = swap
            END IF
        END WHILE
    END PROCEDURE

    PROCEDURE Run()
        a[1] = 44
        a[2] = 3
        a[3] = 19
        a[4] = 88
        a[5] = 51
        a[6] = 27
        a[7] = 63
        a[8] = 9
        a[9] = 72
        a[10] = 36
        a[11] = 14
        FOR st = 1 TO 5
            Sift(6 - st, 11)
        END FOR
        FOR e = 2 TO 11
            LET en AS S64 = 13 - e
            LET t AS S64 = a[1]
            a[1] = a[en]
            a[en] = t
            Sift(1, en - 1)
        END FOR
        LET s AS STRING = ""
        FOR k = 1 TO 11
            s = s | a[k] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Heap
BEGIN
    Heap.Run()
END
