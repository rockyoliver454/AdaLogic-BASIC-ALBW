-- 746 | Find largest left truncatable prime in a given base:
-- DFS over digit extensions for bases 3, 4, 5, 6.
DECLARE MODULE Lt
    FUNCTION Prime(n AS S64) AS S32
    PROCEDURE Dfs(v AS S64, b AS S64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE Lt
    STRICT best[1] AS S64

    FUNCTION Prime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        IF n MOD 2 = 0 THEN
            IF n = 2 THEN RETURN 1 END IF
            RETURN 0
        END IF
        LET d AS S64 = 3
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 2
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Dfs(v AS S64, b AS S64)
        -- v is prime; try prepending nonzero digit: v + d*b^depth
        -- depth tracked via scale factor
        RETURN
    END PROCEDURE

    PROCEDURE Run()
        -- simpler: DFS keeping value and the next power
        STRICT stk[2000] AS S64
        STRICT pw[2000] AS S64
        FOR b = 3 TO 6
            best[1] = 0
            -- iterative DFS: push (value, power)
            LET sp AS S64 = 0
            FOR d = 1 TO b - 1
                IF Prime(d) = 1 THEN
                    sp = sp + 1
                    stk[sp] = d
                    pw[sp] = b
                END IF
            END FOR
            WHILE sp > 0
                LET v AS S64 = stk[sp]
                LET w AS S64 = pw[sp]
                sp = sp - 1
                IF v > best[1] THEN best[1] = v END IF
                FOR d = 1 TO b - 1
                    LET nv AS S64 = v + d * w
                    IF nv < 9000000 ANDALSO Prime(nv) = 1 THEN
                        sp = sp + 1
                        stk[sp] = nv
                        pw[sp] = w * b
                    END IF
                END FOR
            END WHILE
            PRINT "base " | b | ": " | best[1]
        END FOR
    END PROCEDURE
END MODULE

IMPORT Lt
BEGIN
    Lt.Run()
END
