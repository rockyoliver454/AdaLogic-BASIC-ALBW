-- 085 | Flow-control structures: IF, SELECT, FOR, WHILE, REPEAT, BREAK.
BEGIN
    LET x AS S32 = 2;
    IF x = 1 THEN
        PRINT$ "if";
    ELSEIF x = 2 THEN
        PRINT$ "elseif";
    ELSE
        PRINT$ "else";
    END IF
    SELECT x
        CASE 1 => PRINT$ "one"
        CASE 2 => PRINT$ "two"
        ELSE => PRINT$ "other"
    END SELECT
    FOR i = 0 TO 2
        PRINT$ "for " | i;
    END FOR
    LET w AS S32 = 0;
    WHILE w < 2
        PRINT$ "while " | w;
        w = w + 1;
    END WHILE
    LET r AS S32 = 0;
    REPEAT
        PRINT$ "repeat " | r;
        r = r + 1;
    UNTIL r >= 2
    FOR i = 0 TO 9
        IF i > 0 THEN
            BREAK
        END IF
        PRINT$ "break " | i;
    END FOR
END
