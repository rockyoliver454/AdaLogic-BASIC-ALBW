VERSION 1.0

LET frames AS S64 = 0
LET px AS S64 = 0
LET bg AS S64 = 0


BEGIN
    CREATE_WINDOW "color probe", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        CLEAR $008000
        COLOR $FF8040
        FILL RECT 8, 8, 16, 16
        bg = READ_PIXEL(40, 40)
        px = READ_PIXEL(12, 12)
    END

    LISTEN

    PRINT "bg=" | bg
    PRINT "fg=" | px
END
