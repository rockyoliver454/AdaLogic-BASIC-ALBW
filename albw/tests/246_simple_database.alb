-- 246 | Simple database: CSV persistence, Septerra validation, and required queries.
INCLUDE "septerra.albi"

DECLARE MODULE SimpleDb
    PROCEDURE Add(description AS STRING, category AS STRING, date_value AS STRING)
    PROCEDURE SaveAndValidate()
    PROCEDURE PrintLatest()
    PROCEDURE PrintLatestByCategory()
    PROCEDURE PrintSorted()
END DECLARE MODULE

MODULE SimpleDb
    STRICT descriptions[8] AS STRING
    STRICT categories[8] AS STRING
    STRICT dates[8] AS STRING
    LET entry_count AS S32 = 0

    FUNCTION TextEqual(a AS STRING, b AS STRING) AS S32
        IF LEN(a) <> LEN(b) THEN RETURN 0 END IF
        FOR i = 1 TO LEN(a)
            IF ASC(MID$(a,i,1)) <> ASC(MID$(b,i,1)) THEN RETURN 0 END IF
        END FOR
        RETURN 1
    END FUNCTION

    FUNCTION DateGreater(a AS STRING, b AS STRING) AS S32
        FOR i = 1 TO 10
            LET ac AS S32 = ASC(MID$(a,i,1))
            LET bc AS S32 = ASC(MID$(b,i,1))
            IF ac > bc THEN RETURN 1 END IF
            IF ac < bc THEN RETURN 0 END IF
        END FOR
        RETURN 0
    END FUNCTION

    PROCEDURE Add(description AS STRING, category AS STRING, date_value AS STRING)
        descriptions[entry_count] = description
        categories[entry_count] = category
        dates[entry_count] = date_value
        entry_count = entry_count + 1
    END PROCEDURE

    PROCEDURE SaveAndValidate()
        LET csv AS STRING = "description,category,date" | CHR(10)
        FOR i = 0 TO entry_count - 1
            csv = csv | descriptions[i] | "," | categories[i] | "," | dates[i] | CHR(10)
        END FOR
        LET file_handle = OPEN("simple_database.csv", "w")
        WRITE file_handle, csv
        CLOSE file_handle
        LET read_handle = OPEN("simple_database.csv", "r")
        LET loaded AS STRING = READ(read_handle, FILELEN("simple_database.csv"))
        CLOSE read_handle
        Septerra.ClearTab()
        FOR i = 1 TO LEN(loaded)
            Septerra.PutByte(ASC(MID$(loaded,i,1)))
        END FOR
        LET parse_result AS S32 = Septerra.FillKind(0)
        PRINT "csv rows = " | Septerra.RowCount() | ", cols = " | Septerra.ColCount(1) | ", status = " | parse_result
    END PROCEDURE

    PROCEDURE PrintLatest()
        LET i AS S32 = entry_count - 1
        PRINT "latest: " | descriptions[i] | " | " | categories[i] | " | " | dates[i]
    END PROCEDURE

    PROCEDURE PrintLatestByCategory()
        PRINT "latest by category:"
        FOR i = entry_count - 1 TO 0 STEP -1
            LET seen AS S32 = 0
            FOR j = i + 1 TO entry_count - 1
                IF TextEqual(categories[i], categories[j]) THEN seen = 1 END IF
            END FOR
            IF seen = 0 THEN PRINT categories[i] | ": " | descriptions[i] END IF
        END FOR
    END PROCEDURE

    PROCEDURE PrintSorted()
        STRICT order_index[8] AS S32
        FOR i = 0 TO entry_count - 1
            order_index[i] = i
        END FOR
        FOR i = 1 TO entry_count - 1
            LET held AS S32 = order_index[i]
            LET j AS S32 = i - 1
            WHILE j >= 0 ANDALSO DateGreater(dates[order_index[j]], dates[held])
                order_index[j + 1] = order_index[j]
                j = j - 1
            END WHILE
            order_index[j + 1] = held
        END FOR
        PRINT "sorted:"
        FOR i = 0 TO entry_count - 1
            LET pos AS S32 = order_index[i]
            PRINT dates[pos] | " | " | categories[pos] | " | " | descriptions[pos]
        END FOR
    END PROCEDURE
END MODULE

IMPORT SimpleDb
BEGIN
    SimpleDb.Add("Compiler handbook", "books", "2024-03-10")
    SimpleDb.Add("Blue Train", "music", "2023-08-01")
    SimpleDb.Add("Language design", "books", "2025-01-15")
    SimpleDb.Add("Kind of Blue", "music", "2024-11-20")
    SimpleDb.SaveAndValidate()
    SimpleDb.PrintLatest()
    SimpleDb.PrintLatestByCategory()
    SimpleDb.PrintSorted()
END
