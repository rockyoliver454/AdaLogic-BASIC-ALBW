-- 403 | Largest proper divisor of n: n's greatest divisor below n, for 1..25.
DECLARE MODULE LPD
    FUNCTION LargestProper(n AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE LPD
    FUNCTION LargestProper(n AS S64) AS S64
        IF n <= 1 THEN RETURN 1 END IF
        LET d AS S64 = 2
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN n / d END IF
            d = d + 1
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        FOR n = 1 TO 25
            s = s | LargestProper(n) | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT LPD
BEGIN
    LPD.Run()
END
