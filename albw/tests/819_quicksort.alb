-- Rosetta: quicksort -- recursive partitioning over a global STRICT
-- array (module procedures reach crate-root statics via unsafe).
DECLARE MODULE S
    PROCEDURE Qsort(lo AS S32, hi AS S32)
END DECLARE MODULE

STRICT a[8] AS S32

MODULE S
    PROCEDURE Qsort(lo AS S32, hi AS S32)
        LET i AS S32 = lo
        LET j AS S32 = hi
        LET piv AS S32 = a[(lo + hi) / 2]
        WHILE i <= j
            WHILE a[i] < piv
                i = i + 1
            END WHILE
            WHILE a[j] > piv
                j = j - 1
            END WHILE
            IF i <= j THEN
                LET t AS S32 = a[i]
                a[i] = a[j]
                a[j] = t
                i = i + 1
                j = j - 1
            END IF
        END WHILE
        IF lo < j THEN
            Qsort(lo, j)
        END IF
        IF i < hi THEN
            Qsort(i, hi)
        END IF
    END PROCEDURE
END MODULE

BEGIN
    a[0] = 5
    a[1] = 2
    a[2] = 9
    a[3] = 1
    a[4] = 7
    a[5] = 3
    a[6] = 8
    a[7] = 4
    S.Qsort(0, 7)
    FOR i = 0 TO 7
        PRINT a[i]
    END FOR
END
