-- 378 | Leonardo numbers: L(0)=L(1)=1, L(n)=L(n-1)+L(n-2)+1; first 25.
DECLARE MODULE Leon
    PROCEDURE Run()
END DECLARE MODULE

MODULE Leon
    STRICT l[32] AS S64
    PROCEDURE Run()
        l[0] = 1
        l[1] = 1
        FOR n = 2 TO 24
            l[n] = l[n - 1] + l[n - 2] + 1
        END FOR
        LET s AS STRING = ""
        FOR n = 0 TO 24
            s = s | l[n] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Leon
BEGIN
    Leon.Run()
END
