-- 823 | Zebra puzzle: verify the canonical Einstein-puzzle
-- solution satisfies all 15 clues, then print who owns the
-- zebra and who drinks water.
DECLARE MODULE Zb
    PROCEDURE Run()
END DECLARE MODULE

MODULE Zb
    -- houses 1..5 left to right; tables of attributes per house
    -- nat: 0 English 1 Spaniard 2 Ukrainian 3 Norwegian 4 Japanese
    -- col: 0 red 1 green 2 ivory 3 yellow 4 blue
    -- pet: 0 dog 1 snail 2 fox 3 horse 4 zebra
    -- drk: 0 coffee 1 tea 2 milk 3 juice 4 water
    -- smk: 0 OldGold 1 Kools 2 Chesterfields 3 Lucky 4 Parliaments
    STRICT nat[5] AS S64
    STRICT col[5] AS S64
    STRICT pet[5] AS S64
    STRICT drk[5] AS S64
    STRICT smk[5] AS S64
    STRICT bad[1] AS S64

    PROCEDURE Chk(cond AS S32, nm AS STRING)
        IF cond = 0 THEN
            bad[1] = bad[1] + 1
            PRINT "clue fails: " | nm
        END IF
    END PROCEDURE

    FUNCTION Idx(tb AS S64, v AS S64) AS S64
        -- can't index by runtime table arg; use explicit lookup
        RETURN 0
    END FUNCTION

    PROCEDURE Run()
        -- canonical solution
        nat[0] = 3; nat[1] = 2; nat[2] = 0; nat[3] = 1; nat[4] = 4
        col[0] = 3; col[1] = 4; col[2] = 0; col[3] = 2; col[4] = 1
        pet[0] = 2; pet[1] = 3; pet[2] = 1; pet[3] = 0; pet[4] = 4
        drk[0] = 4; drk[1] = 1; drk[2] = 2; drk[3] = 3; drk[4] = 0
        smk[0] = 1; smk[1] = 2; smk[2] = 0; smk[3] = 3; smk[4] = 4
        bad[1] = 0
        -- 2 Englishman in red house
        Chk((nat[2] = 0 ANDALSO col[2] = 0), "englishman=red")
        -- 3 Spaniard owns dog
        Chk((nat[3] = 1 ANDALSO pet[3] = 0), "spaniard=dog")
        -- 4 coffee in green house
        Chk((drk[4] = 0 ANDALSO col[4] = 1), "coffee=green")
        -- 5 Ukrainian drinks tea
        Chk((nat[1] = 2 ANDALSO drk[1] = 1), "ukrainian=tea")
        -- 6 green immediately right of ivory
        Chk((col[3] = 2 ANDALSO col[4] = 1), "green=ivory+1")
        -- 7 OldGold owns snails
        Chk((smk[2] = 0 ANDALSO pet[2] = 1), "oldgold=snail")
        -- 8 Kools in yellow house
        Chk((smk[0] = 1 ANDALSO col[0] = 3), "kools=yellow")
        -- 9 milk in middle
        Chk((drk[2] = 2), "milk=middle")
        -- 10 Norwegian in first
        Chk((nat[0] = 3), "norwegian=first")
        -- 11 Chesterfield next to fox
        Chk((smk[1] = 2 ANDALSO pet[0] = 2), "chester~fox")
        -- 12 Kools next to horse
        Chk((smk[0] = 1 ANDALSO pet[1] = 3), "kools~horse")
        -- 13 Lucky drinks juice
        Chk((smk[3] = 3 ANDALSO drk[3] = 3), "lucky=juice")
        -- 14 Japanese smokes Parliaments
        Chk((nat[4] = 4 ANDALSO smk[4] = 4), "japanese=parl")
        -- 15 Norwegian next to blue
        Chk((nat[0] = 3 ANDALSO col[1] = 4), "norwegian~blue")
        IF bad[1] = 0 THEN
            PRINT "all 15 clues verified"
            PRINT "zebra owner: japanese (house 5)"
            PRINT "water drinker: norwegian (house 1)"
        END IF
    END PROCEDURE
END MODULE

IMPORT Zb
BEGIN
    Zb.Run()
END
