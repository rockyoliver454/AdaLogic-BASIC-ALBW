-- 683 | Erdos-Woods numbers (= prime-partitionable numbers):
-- k such that the primes < k split into X, Y where for every
-- x+y=k either p|x for some p in X or q|y for some q in Y.
DECLARE MODULE Ew
    FUNCTION Ewn(k AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Ew
    STRICT pr[20] AS S64

    FUNCTION Ewn(k AS S64) AS S32
        LET m AS S64 = 0
        FOR p = 2 TO k - 1
            LET isp AS S32 = 1
            LET d AS S64 = 2
            WHILE d * d <= p
                IF p MOD d = 0 THEN isp = 0 END IF
                d = d + 1
            END WHILE
            IF isp = 1 THEN
                m = m + 1
                pr[m] = p
            END IF
        END FOR
        LET lim AS S64 = 1
        FOR i = 1 TO m
            lim = lim * 2
        END FOR
        FOR mask = 0 TO lim - 1
            LET ok AS S32 = 1
            FOR x = 1 TO k - 1
                LET y AS S64 = k - x
                LET cov AS S32 = 0
                FOR i2 = 1 TO m
                    IF (mask / 2 ^ (i2 - 1)) MOD 2 = 1 THEN
                        IF x MOD pr[i2] = 0 THEN cov = 1 END IF
                    ELSE
                        IF y MOD pr[i2] = 0 THEN cov = 1 END IF
                    END IF
                END FOR
                IF cov = 0 THEN ok = 0 END IF
            END FOR
            IF ok = 1 THEN RETURN 1 END IF
        END FOR
        RETURN 0
    END FUNCTION

    PROCEDURE Run()
        FOR k = 2 TO 56
            IF Ewn(k) = 1 THEN PRINT k END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Ew
BEGIN
    Ew.Run()
END
