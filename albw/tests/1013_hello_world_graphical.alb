VERSION 1.0
LET frames AS S64 = 0
LET ink AS S64 = 0
LET px AS S64 = 0

BEGIN
    CREATE_WINDOW "Hello world/Graphical", 128, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET x AS S64 = 0
        LET y AS S64 = 0
        CLEAR $000000
        COLOR $FFFFFF
        DRAW TEXT 16, 24, "Hello World!"
        ink = 0
        y = 24
        WHILE y < 36
            x = 16
            WHILE x < 112
                px = READ_PIXEL(x, y)
                IF px <> 4278190080 ANDALSO px <> 0 THEN
                    ink = ink + 1
                END IF
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END

    LISTEN

    PRINT "message=Hello World!"
    PRINT "ink=" | ink
    IF ink > 0 THEN
        PRINT "text rendered"
    ELSE
        PRINT "FAIL"
    END IF
END
