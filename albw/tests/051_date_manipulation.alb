-- 051 | Date manipulation: add 45 days via civil-epoch math.
DECLARE MODULE C
    FUNCTION DaysFromCivil(y AS S64, m AS S64, d AS S64) AS S64
    PROCEDURE CivilFromDays(z AS S64)
END DECLARE MODULE

MODULE C
    FUNCTION DaysFromCivil(y AS S64, m AS S64, d AS S64) AS S64
        LET yy AS S64 = y;
        IF m <= 2 THEN
            yy = yy - 1;
        END IF
        LET era AS S64 = yy / 400;
        LET yoe AS S64 = yy - era * 400;
        LET mp AS S64 = (m + 9) MOD 12;
        LET doy AS S64 = (153 * mp + 2) / 5 + d - 1;
        LET doe AS S64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        RETURN era * 146097 + doe - 719468
    END FUNCTION
    PROCEDURE CivilFromDays(z AS S64)
        LET zz AS S64 = z + 719468;
        LET era AS S64 = zz / 146097;
        LET doe AS S64 = zz - era * 146097;
        LET yoe AS S64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        LET y AS S64 = yoe + era * 400;
        LET doy AS S64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
        LET mp AS S64 = (5 * doy + 2) / 153;
        LET d AS S64 = doy - (153 * mp + 2) / 5 + 1;
        LET m AS S64 = mp + 3;
        IF m > 12 THEN
            m = m - 12;
            y = y + 1;
        END IF
        PRINT$ y | "-" | m | "-" | d;
    END PROCEDURE
END MODULE

IMPORT C
BEGIN
    C.CivilFromDays(C.DaysFromCivil(2024, 1, 31) + 45);
    C.CivilFromDays(C.DaysFromCivil(2024, 12, 25) + 45);
    C.CivilFromDays(C.DaysFromCivil(2023, 3, 1) - 1);
END
