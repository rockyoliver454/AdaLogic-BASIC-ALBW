-- 228 | Catamorphism: reduce a list from the left to sum and product values.
DECLARE MODULE Fold
    PROCEDURE Initialize()
    FUNCTION Sum() AS S32
    FUNCTION Product() AS S32
END DECLARE MODULE

MODULE Fold
    STRICT numbers[5] AS S32

    PROCEDURE Initialize()
        numbers[0] = 1
        numbers[1] = 2
        numbers[2] = 3
        numbers[3] = 4
        numbers[4] = 5
    END PROCEDURE

    FUNCTION Sum() AS S32
        LET accumulator AS S32 = numbers[0]
        FOR i = 1 TO 4
            accumulator = accumulator + numbers[i]
        END FOR
        RETURN accumulator
    END FUNCTION

    FUNCTION Product() AS S32
        LET accumulator AS S32 = numbers[0]
        FOR i = 1 TO 4
            accumulator = accumulator * numbers[i]
        END FOR
        RETURN accumulator
    END FUNCTION
END MODULE

IMPORT Fold
BEGIN
    Fold.Initialize()
    PRINT "sum = " | Fold.Sum()
    PRINT "product = " | Fold.Product()
END
