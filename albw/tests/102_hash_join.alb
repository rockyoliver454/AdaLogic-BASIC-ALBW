-- 102 | Hash join: join two tables on a shared key.
BEGIN
    STRICT en[4] AS STRING;
    STRICT ed[4] AS S32;
    en[0]="ada"; en[1]="bob"; en[2]="cat"; en[3]="dan";
    ed[0]=1;    ed[1]=2;     ed[2]=1;     ed[3]=3;
    STRICT dn[3] AS STRING;
    dn[0]="eng"; dn[1]="ops"; dn[2]="hr";
    FOR i = 0 TO 3
        FOR j = 0 TO 2
            IF ed[i] - 1 = j THEN
                PRINT$ en[i] | " dept " | ed[i] | " = " | dn[j];
            END IF
        END FOR
    END FOR
END
