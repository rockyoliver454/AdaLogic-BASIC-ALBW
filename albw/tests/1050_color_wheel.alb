VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET hue AS S64 = (x * 360) / 64
            LET sec AS S64 = hue / 60
            LET f AS S64 = (hue MOD 60) * 255 / 60
            LET r AS S64 = 0
            LET gg AS S64 = 0
            LET b AS S64 = 0
            IF sec = 0 THEN r = 255 gg = f b = 0 END IF
            IF sec = 1 THEN r = 255 - f gg = 255 b = 0 END IF
            IF sec = 2 THEN r = 0 gg = 255 b = f END IF
            IF sec = 3 THEN r = 0 gg = 255 - f b = 255 END IF
            IF sec = 4 THEN r = f gg = 0 b = 255 END IF
            IF sec = 5 THEN r = 255 gg = 0 b = 255 - f END IF
            LET lv AS S64 = y * 4
            IF lv > 255 THEN lv = 255 END IF
            img[y * 64 + x] = (r * lv / 255) * 65536 + (gg * lv / 255) * 256 + (b * lv / 255)
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Color wheel", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
                k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "hues=360 value=vary"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
