-- 537 | Round-robin tournament schedule: circle method for 6
-- players, printing each round's pairings.
DECLARE MODULE RR
    PROCEDURE Run()
END DECLARE MODULE

MODULE RR
    STRICT p[6] AS S64

    PROCEDURE Run()
        FOR i = 1 TO 6
            p[i] = i
        END FOR
        FOR r = 1 TO 5
            LET s AS STRING = "round " | r | ": "
            FOR k = 1 TO 3
                s = s | p[k] | "v" | p[7 - k] | " "
            END FOR
            PRINT s
            LET last AS S64 = p[6]
            LET j AS S64 = 6
            WHILE j >= 3
                p[j] = p[j - 1]
                j = j - 1
            END WHILE
            p[2] = last
        END FOR
    END PROCEDURE
END MODULE

IMPORT RR
BEGIN
    RR.Run()
END
