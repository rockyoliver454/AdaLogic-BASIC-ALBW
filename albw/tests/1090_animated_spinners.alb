VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET fr AS S64 = 0


BEGIN
    LET cy AS S64 = 0
    WHILE cy < 2
        LET cx AS S64 = 0
        WHILE cx < 3
            LET ox AS S64 = 12 + cx * 20
            LET oy AS S64 = 12 + cy * 24
            LET a AS S64 = (cx + cy * 3) * 60 + 30
            LET af AS F64 = a * 1.0
            LET ex AS S64 = ROUND((ox * 1.0) + COS(af * 0.017453292519943295) * 8.0)
            LET ey AS S64 = ROUND((oy * 1.0) + SIN(af * 0.017453292519943295) * 8.0)
            LET s AS S64 = 0
            WHILE s < 16
                LET px AS S64 = ox + (ex - ox) * s / 16
                LET py AS S64 = oy + (ey - oy) * s / 16
                img[py * 64 + px] = 16777215
                s = s + 1
            END WHILE
            img[ey * 64 + ex] = 16711680
            cx = cx + 1
        END WHILE
        cy = cy + 1
    END WHILE
    fr = 4

    CREATE_WINDOW "Animated spinners", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "spinners=6 frame=" | fr
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
