VERSION 1.0

STRICT img[4096] AS S32
STRICT sm[4096] AS S32
STRICT ed[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET nedge AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET v AS S64 = 40
            LET dx AS S64 = x - 32
            LET dy AS S64 = y - 32
            IF dx * dx + dy * dy < 324 THEN v = 220 END IF
            img[y * 64 + x] = v
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    y = 1
    WHILE y < 63
        x = 1
        WHILE x < 63
            LET i AS S64 = y * 64 + x
            LET s AS S64 = img[i - 65] + img[i - 64] * 2 + img[i - 63]
            s = s + img[i - 1] * 2 + img[i] * 4 + img[i + 1] * 2
            s = s + img[i + 63] + img[i + 64] * 2 + img[i + 65]
            sm[i] = s / 16
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    nedge = 0
    y = 1
    WHILE y < 63
        x = 1
        WHILE x < 63
            LET i AS S64 = y * 64 + x
            LET gx AS S64 = sm[i - 63] + sm[i + 1] * 2 + sm[i + 65] - sm[i - 65] - sm[i - 1] * 2 - sm[i + 63]
            LET gy AS S64 = sm[i + 63] + sm[i + 64] * 2 + sm[i + 65] - sm[i - 65] - sm[i - 64] * 2 - sm[i - 63]
            IF gx < 0 THEN gx = 0 - gx END IF
            IF gy < 0 THEN gy = 0 - gy END IF
            LET m AS S64 = gx + gy
            IF m > 150 THEN
                ed[i] = 16777215
                nedge = nedge + 1
            END IF
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    LET kk AS S64 = 0
    WHILE kk < 4096
        img[kk] = ed[kk]
        kk = kk + 1
    END WHILE

    CREATE_WINDOW "Canny edge detector", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "edges=" | nedge
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
