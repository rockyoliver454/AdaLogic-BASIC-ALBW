-- 757 | Fractran: run PRIMEGAME; exponents of pure powers of
-- 2 give the prime sequence.
DECLARE MODULE Fr
    PROCEDURE Run()
END DECLARE MODULE

MODULE Fr
    STRICT num[15] AS S64
    STRICT den[15] AS S64

    PROCEDURE Run()
        -- PRIMEGAME fractions
        num[1] = 17
        den[1] = 91
        num[2] = 78
        den[2] = 85
        num[3] = 19
        den[3] = 51
        num[4] = 23
        den[4] = 38
        num[5] = 29
        den[5] = 33
        num[6] = 77
        den[6] = 29
        num[7] = 95
        den[7] = 23
        num[8] = 77
        den[8] = 19
        num[9] = 1
        den[9] = 17
        num[10] = 11
        den[10] = 13
        num[11] = 13
        den[11] = 11
        num[12] = 15
        den[12] = 14
        num[13] = 15
        den[13] = 2
        num[14] = 55
        den[14] = 1
        LET v AS S64 = 2
        LET steps AS S64 = 0
        LET found AS S64 = 0
        WHILE found < 6 ANDALSO steps < 3000
            -- is v a power of 2? report exponent
            LET t AS S64 = v
            LET e AS S64 = 0
            WHILE t MOD 2 = 0
                t = t / 2
                e = e + 1
            END WHILE
            IF t = 1 ANDALSO e >= 2 THEN
                PRINT "2^" | e
                found = found + 1
            END IF
            LET ap AS S32 = 0
            FOR i = 1 TO 14
                IF ap = 0 ANDALSO v * num[i] MOD den[i] = 0 THEN
                    v = v * num[i] / den[i]
                    ap = 1
                END IF
            END FOR
            steps = steps + 1
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Fr
BEGIN
    Fr.Run()
END
