-- 650 | Sub-unit squares: decimal expansion of the unit
-- fractions 1/n^2 for n = 2..10.
DECLARE MODULE Sub
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sub
    PROCEDURE Run()
        FOR n = 2 TO 10
            LET sq AS S64 = n * n
            LET s AS STRING = "1/" | sq | " = 0."
            LET rem AS S64 = 1
            FOR i = 1 TO 8
                rem = rem * 10
                s = s | (rem / sq)
                rem = rem MOD sq
            END FOR
            PRINT s
        END FOR
    END PROCEDURE
END MODULE

IMPORT Sub
BEGIN
    Sub.Run()
END
