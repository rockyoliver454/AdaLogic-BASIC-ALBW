-- 591 | Magic squares of doubly even order: 4x4 via the
-- complement pattern method (magic constant 34).
DECLARE MODULE MSQ
    PROCEDURE Run()
END DECLARE MODULE

MODULE MSQ
    STRICT m[16] AS S64

    PROCEDURE Run()
        LET n AS S64 = 4
        FOR i = 0 TO 15
            LET r AS S64 = i / n
            LET c AS S64 = i MOD n
            IF (r MOD 4 = c MOD 4) ORELSE ((r MOD 4) + (c MOD 4) = 3) THEN
                m[i] = i + 1
            ELSE
                m[i] = n * n - i
            END IF
        END FOR
        FOR rr = 0 TO 3
            PRINT m[rr * 4] | " " | m[rr * 4 + 1] | " " | m[rr * 4 + 2] | " " | m[rr * 4 + 3]
        END FOR
        PRINT "magic constant: " | (m[0] + m[1] + m[2] + m[3])
    END PROCEDURE
END MODULE

IMPORT MSQ
BEGIN
    MSQ.Run()
END
