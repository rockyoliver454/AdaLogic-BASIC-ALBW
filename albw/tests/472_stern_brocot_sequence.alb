-- 472 | Stern-Brocot sequence (fusc): first 100 terms.
DECLARE MODULE SB
    PROCEDURE Run()
END DECLARE MODULE

MODULE SB
    STRICT a[103] AS S64

    PROCEDURE Run()
        a[1] = 0
        a[2] = 1
        FOR n = 1 TO 50
            a[2 * n + 1] = a[n + 1]
            a[2 * n + 2] = a[n + 1] + a[n + 2]
        END FOR
        LET s AS STRING = ""
        FOR i = 1 TO 100
            s = s | a[i] | " "
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT SB
BEGIN
    SB.Run()
END
