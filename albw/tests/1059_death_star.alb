VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET dx AS S64 = x - 32
            LET dy AS S64 = y - 34
            LET r2 AS S64 = dx * dx + dy * dy
            IF r2 <= 484 THEN
                img[y * 64 + x] = 8421504
            END IF
            LET cdx AS S64 = x - 42
            LET cdy AS S64 = y - 24
            LET cr2 AS S64 = cdx * cdx + cdy * cdy
            IF cr2 <= 64 THEN
                img[y * 64 + x] = 3289650
            END IF
            IF r2 <= 484 ANDALSO cr2 > 64 ANDALSO cr2 < 120 THEN
                img[y * 64 + x] = 12632256
            END IF
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Death Star", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "sphere_r=22 lens_r=8"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
