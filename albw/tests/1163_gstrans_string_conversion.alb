VERSION 1.0


FUNCTION GEncode(ss AS STRING) AS STRING
    LET res AS STRING = ""
    LET i AS S64 = 1
    LET sl AS S64 = LEN(ss)
    WHILE i <= sl
        LET c AS S64 = ASC(MID$(ss, i, 1))
        IF c < 32 THEN
            res = res | "|" | CHR(c + 64)
        ELSE
            IF c = 34 ORELSE c = 124 THEN
                res = res | "|" | CHR(c)
            ELSE
                IF c <= 126 THEN
                    res = res | CHR(c)
                ELSE
                    IF c = 127 THEN
                        res = res | "|?"
                    ELSE
                        LET lo AS S64 = c - 128
                        IF lo < 32 THEN
                            res = res | "|!|" | CHR(lo + 64)
                        ELSE
                            IF lo = 34 ORELSE lo = 124 THEN
                                res = res | "|!|" | CHR(lo)
                            ELSE
                                res = res | "|!" | CHR(lo)
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        END IF
        i = i + 1
    END WHILE
    RETURN res
END FUNCTION


FUNCTION GDecode(ss AS STRING) AS STRING
    LET res AS STRING = ""
    LET i AS S64 = 1
    LET sl AS S64 = LEN(ss)
    WHILE i <= sl
        LET c AS S64 = ASC(MID$(ss, i, 1))
        IF c <> 124 THEN
            res = res | CHR(c)
            i = i + 1
        ELSE
            LET c2 AS S64 = ASC(MID$(ss, i + 1, 1))
            IF c2 = 33 THEN
                LET c3 AS S64 = ASC(MID$(ss, i + 2, 1))
                IF c3 = 124 THEN
                    LET c4 AS S64 = ASC(MID$(ss, i + 3, 1))
                    res = res | CHR(128 + c4 - 64)
                    i = i + 4
                ELSE
                    res = res | CHR(128 + c3)
                    i = i + 3
                END IF
            ELSE
                IF c2 = 63 THEN
                    res = res | CHR(127)
                ELSE
                    IF c2 = 34 ORELSE c2 = 124 THEN
                        res = res | CHR(c2)
                    ELSE
                        res = res | CHR(c2 - 64)
                    END IF
                END IF
                i = i + 2
            END IF
        END IF
    END WHILE
    RETURN res
END FUNCTION


BEGIN
    LET src AS STRING = CHR(12) | "Hello" | CHR(7) | CHR(10) | CHR(13)
    LET enc AS STRING = GEncode(src)
    PRINT "enc1=" | enc
    LET dec AS STRING = GDecode(enc)
    PRINT "roundtrip1=" | (dec = src)

    LET src2 AS STRING = CHR(13) | CHR(10) | CHR(0) | CHR(5) | CHR(244) | CHR(13) | CHR(255)
    LET enc2 AS STRING = GEncode(src2)
    PRINT "enc2=" | enc2
    LET dec2 AS STRING = GDecode(enc2)
    PRINT "roundtrip2=" | (dec2 = src2)

    LET enc3 AS STRING = GEncode("quoted|text")
    PRINT "enc3=" | enc3
    PRINT "roundtrip3=" | (GDecode(enc3) = "quoted|text")
END
