-- 699 | Composite numbers k with no single-digit factors
-- whose prime factors are all substrings of k (as decimals).
DECLARE MODULE Ck
    FUNCTION Prime(n AS S64) AS S32
    FUNCTION Sub(k AS S64, d AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Ck
    FUNCTION Prime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        LET d AS S64 = 2
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 1
        END WHILE
        RETURN 1
    END FUNCTION

    FUNCTION Sub(k AS S64, d AS S64) AS S32
        -- is decimal d a contiguous substring of decimal k?
        LET scale AS S64 = 1
        LET dv AS S64 = d
        WHILE dv > 0
            scale = scale * 10
            dv = dv / 10
        END WHILE
        LET v AS S64 = k
        WHILE v >= d
            IF v MOD scale = d THEN RETURN 1 END IF
            v = v / 10
        END WHILE
        RETURN 0
    END FUNCTION

    PROCEDURE Run()
        FOR n = 10 TO 100000
            IF Prime(n) = 0 THEN
                LET ok AS S32 = 1
                LET nodig AS S32 = 1
                LET v AS S64 = n
                LET d AS S64 = 2
                WHILE d * d <= v
                    IF v MOD d = 0 THEN
                        IF d < 10 THEN nodig = 0 END IF
                        IF Sub(n, d) = 0 THEN ok = 0 END IF
                        WHILE v MOD d = 0
                            v = v / d
                        END WHILE
                    END IF
                    d = d + 1
                END WHILE
                IF v > 1 THEN
                    IF v < 10 THEN nodig = 0 END IF
                    IF Sub(n, v) = 0 THEN ok = 0 END IF
                END IF
                IF ok = 1 ANDALSO nodig = 1 THEN PRINT n END IF
            END IF
        END FOR
    END PROCEDURE
END MODULE

IMPORT Ck
BEGIN
    Ck.Run()
END
