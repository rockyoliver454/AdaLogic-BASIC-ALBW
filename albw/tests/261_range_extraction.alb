-- 261 | Range extraction: compress a sorted list into range notation.
BEGIN
    STRICT values[20] AS S32
    values[0] = -6
    values[1] = -3
    values[2] = -2
    values[3] = -1
    values[4] = 0
    values[5] = 1
    values[6] = 3
    values[7] = 4
    values[8] = 5
    values[9] = 7
    values[10] = 8
    values[11] = 9
    values[12] = 10
    values[13] = 11
    values[14] = 14
    values[15] = 15
    values[16] = 17
    values[17] = 18
    values[18] = 19
    values[19] = 20

    LET out_line AS STRING = ""
    LET emitted AS S32 = 0
    LET i AS S32 = 0
    WHILE i < 20
        LET j AS S32 = i
        WHILE j + 1 < 20 ANDALSO values[j + 1] = values[j] + 1
            j = j + 1
        END WHILE
        LET span AS S32 = j - i + 1
        IF span >= 3 THEN
            IF emitted = 1 THEN out_line = out_line | "," END IF
            out_line = out_line | values[i] | "-" | values[j]
            emitted = 1
            i = j + 1
        ELSE
            FOR k = i TO j
                IF emitted = 1 THEN out_line = out_line | "," END IF
                out_line = out_line | values[k]
                emitted = 1
            END FOR
            i = j + 1
        END IF
    END WHILE
    PRINT out_line
END
