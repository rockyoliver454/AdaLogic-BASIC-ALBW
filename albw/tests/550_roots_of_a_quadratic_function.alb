-- 550 | Roots of a quadratic function: ax^2+bx+c=0 for
-- (1,-5,6): roots 3,2; (1,0,1): complex; (1,2,1): double root -1.
DECLARE MODULE Quad
    PROCEDURE Solve(a AS F64, b AS F64, c AS F64)
    PROCEDURE Run()
END DECLARE MODULE

MODULE Quad
    PROCEDURE Solve(a AS F64, b AS F64, c AS F64)
        LET disc AS F64 = b * b - 4.0 * a * c
        IF disc > 0.0 THEN
            LET sq AS F64 = SQRT(disc)
            PRINT "roots: " | ((0.0 - b + sq) / (2.0 * a)) | " " | ((0.0 - b - sq) / (2.0 * a))
        ELSE
            IF disc = 0.0 THEN
                PRINT "double root: " | ((0.0 - b) / (2.0 * a))
            ELSE
                LET sq2 AS F64 = SQRT(0.0 - disc)
                PRINT "complex: " | ((0.0 - b) / (2.0 * a)) | " +/- " | (sq2 / (2.0 * a)) | "i"
            END IF
        END IF
    END PROCEDURE

    PROCEDURE Run()
        Solve(1.0, -5.0, 6.0)
        Solve(1.0, 2.0, 1.0)
        Solve(1.0, 0.0, 1.0)
    END PROCEDURE
END MODULE

IMPORT Quad
BEGIN
    Quad.Run()
END
