VERSION 1.0

STRICT img[4096] AS S32
STRICT cnv[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET y AS S64 = 0
    LET x AS S64 = 0
    WHILE y < 64
        x = 0
        WHILE x < 64
            LET v AS S64 = (x * x + y * y) MOD 256
            img[y * 64 + x] = v
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    y = 1
    WHILE y < 63
        x = 1
        WHILE x < 63
            LET acc AS S64 = 0
            acc = acc + img[(y - 1) * 64 + x] * 0
            acc = acc + img[y * 64 + x - 1] * 0 - img[y * 64 + x - 1]
            acc = acc + img[y * 64 + x] * 4
            acc = acc - img[y * 64 + x + 1]
            acc = acc - img[(y - 1) * 64 + x]
            acc = acc - img[(y + 1) * 64 + x]
            IF acc < 0 THEN acc = 0 END IF
            IF acc > 255 THEN acc = 255 END IF
            cnv[y * 64 + x] = acc * 65536 + acc * 256 + acc
            x = x + 1
        END WHILE
        y = y + 1
    END WHILE

    CREATE_WINDOW "Image convolution", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF cnv[k] <> 0 THEN
                COLOR cnv[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(32, 32)
    END

    LISTEN

    PRINT "kernel=laplacian"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(32,32)=" | fpx
END
