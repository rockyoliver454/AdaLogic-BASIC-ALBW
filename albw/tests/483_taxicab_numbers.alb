-- 483 | Taxicab numbers: first 25 — smallest n expressible as
-- a^3+b^3 = c^3+d^3 with (a,b) <> (c,d), a<b, c<d.
DECLARE MODULE Taxi
    PROCEDURE Run()
END DECLARE MODULE

MODULE Taxi
    PROCEDURE Run()
        LET got AS S64 = 0
        LET n AS S64 = 2
        WHILE got < 25
            LET ways AS S64 = 0
            LET w1 AS STRING = ""
            LET w2 AS STRING = ""
            FOR a = 1 TO 80
                LET a3 AS S64 = a * a * a
                IF a3 < n THEN
                    LET rem AS S64 = n - a3
                    LET b AS S64 = a
                    WHILE b * b * b < rem
                        b = b + 1
                    END WHILE
                    IF b * b * b = rem ANDALSO b >= a THEN
                        ways = ways + 1
                        IF ways = 1 THEN w1 = a | "^3+" | b | "^3" END IF
                        IF ways = 2 THEN w2 = a | "^3+" | b | "^3" END IF
                    END IF
                END IF
            END FOR
            IF ways >= 2 THEN
                PRINT n | " = " | w1 | " = " | w2
                got = got + 1
            END IF
            n = n + 1
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Taxi
BEGIN
    Taxi.Run()
END
