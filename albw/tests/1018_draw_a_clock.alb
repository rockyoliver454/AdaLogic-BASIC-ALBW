VERSION 1.0
STRICT hx[12] AS S64
STRICT hy[12] AS S64

LET frames AS S64 = 0
LET mhx AS S64 = 0
LET mhy AS S64 = 0
LET hhx AS S64 = 0
LET hhy AS S64 = 0
LET shx AS S64 = 0
LET shy AS S64 = 0
LET fpx AS S64 = 0

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

PROCEDURE CHand(deg AS S64, hlen AS S64, oi AS S64)
    LET ex AS S64 = ROUND(32.0 + Sn(deg) * (hlen * 1.0))
    LET ey AS S64 = ROUND(32.0 - Cs(deg) * (hlen * 1.0))
    hx[oi] = ex
    hy[oi] = ey
END PROCEDURE

BEGIN
    LET h AS S64 = 0
    WHILE h < 12
        CALL CHand(h * 30, 26, h)
        h = h + 1
    END WHILE
    CALL CHand(305, 14, 0)
    hhx = hx[0] hhy = hy[0]
    CALL CHand(60, 22, 0)
    mhx = hx[0] mhy = hy[0]
    CALL CHand(180, 24, 0)
    shx = hx[0] shy = hy[0]

    CREATE_WINDOW "Draw a clock", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET h AS S64 = 0
        LET tx1 AS S64 = 0
        LET ty1 AS S64 = 0
        LET tx2 AS S64 = 0
        LET ty2 AS S64 = 0
        CLEAR $001020
        COLOR $C0C0C0
        DRAW CIRCLE 32, 32, 28
        h = 0
        WHILE h < 12
            tx1 = ROUND(32.0 + Sn(h * 30) * 24.0)
            ty1 = ROUND(32.0 - Cs(h * 30) * 24.0)
            tx2 = ROUND(32.0 + Sn(h * 30) * 27.0)
            ty2 = ROUND(32.0 - Cs(h * 30) * 27.0)
            DRAW LINE tx1, ty1, tx2, ty2
            h = h + 1
        END WHILE
        COLOR $FFFFFF
        DRAW LINE 32, 32, hhx, hhy
        COLOR $FFFF00
        DRAW LINE 32, 32, mhx, mhy
        COLOR $FF4040
        DRAW LINE 32, 32, shx, shy
        fpx = READ_PIXEL(32, 4)
    END

    LISTEN

    PRINT "time=10:10:30"
    PRINT "hour=(" | hhx | "," | hhy | ")"
    PRINT "min=(" | mhx | "," | mhy | ")"
    PRINT "sec=(" | shx | "," | shy | ")"
    PRINT "face_px=" | fpx
END
