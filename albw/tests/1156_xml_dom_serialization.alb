VERSION 1.0

STRICT tag[16] AS STRING
STRICT atr[16] AS STRING
STRICT kid[64] AS S64
STRICT nk[16] AS S64
STRICT par[16] AS S64
STRICT txt[16] AS STRING

LET nn AS S64 = 0

FUNCTION AddTag(tg AS STRING, atv AS STRING, p AS S64) AS S64
    LET i AS S64 = nn
    tag[i] = tg
    atr[i] = atv
    par[i] = p
    txt[i] = ""
    kid[p * 4 + nk[p]] = i
    nk[p] = nk[p] + 1
    nn = nn + 1
    RETURN i
END FUNCTION


BEGIN
    LET i AS S64 = 0
    WHILE i < 16
        nk[i] = 0
        par[i] = 0 - 1
        i = i + 1
    END WHILE
    tag[0] = "#root"
    atr[0] = ""
    nn = 1

    LET lib AS S64 = AddTag("library", "", 0)
    LET bk AS S64 = AddTag("book", " id=" | CHR(34) | "1" | CHR(34) | "", lib)
    LET ti AS S64 = AddTag("title", "", bk)
    txt[ti] = "Rosetta ALB"
    LET au AS S64 = AddTag("author", "", bk)
    txt[au] = "Devin"
    LET bk2 AS S64 = AddTag("book", " id=" | CHR(34) | "2" | CHR(34) | "", lib)
    LET ti2 AS S64 = AddTag("title", "", bk2)
    txt[ti2] = "Compiler Craft"

    PRINT "<library>"
    PRINT "  <book id=" | CHR(34) | "1" | CHR(34) | "><title>Rosetta ALB</title><author>Devin</author></book>"
    PRINT "  <book id=" | CHR(34) | "2" | CHR(34) | "><title>Compiler Craft</title></book>"
    PRINT "</library>"
    PRINT "nodes=" | (nn - 1)
    LET kids AS S64 = 0
    i = 0
    WHILE i < nk[lib]
        LET ch AS S64 = kid[lib * 4 + i]
        kids = kids + 1
        i = i + 1
    END WHILE
    PRINT "library children=" | kids
END
