-- 361 | Totient function: phi(1..25) and the count of primes found that way.
DECLARE MODULE Totient
    FUNCTION Gcd(a AS S64, b AS S64) AS S64
    FUNCTION Phi(n AS S64) AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Totient
    FUNCTION Gcd(a AS S64, b AS S64) AS S64
        LET x AS S64 = a
        LET y AS S64 = b
        WHILE y <> 0
            LET t AS S64 = x MOD y
            x = y
            y = t
        END WHILE
        RETURN x
    END FUNCTION

    FUNCTION Phi(n AS S64) AS S64
        LET c AS S64 = 0
        FOR k = 1 TO n
            IF Gcd(k, n) = 1 THEN c = c + 1 END IF
        END FOR
        RETURN c
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET primes AS S32 = 0
        FOR n = 1 TO 25
            LET p AS S64 = Phi(n)
            s = s | p | " "
            IF n > 1 ANDALSO p = n - 1 THEN primes = primes + 1 END IF
        END FOR
        PRINT s
        PRINT "primes found: " | primes
    END PROCEDURE
END MODULE

IMPORT Totient
BEGIN
    Totient.Run()
END
