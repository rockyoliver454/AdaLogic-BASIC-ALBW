-- 132 | K-means++ clustering: seeded centers, 5 Lloyd iterations.
BEGIN
    STRICT px[8] AS F64;
    STRICT py[8] AS F64;
    px[0]=1.0; py[0]=1.0;   px[1]=1.5; py[1]=2.0;
    px[2]=3.0; py[2]=4.0;   px[3]=5.0; py[3]=7.0;
    px[4]=3.5; py[4]=5.0;   px[5]=4.5; py[5]=5.0;
    px[6]=3.5; py[6]=4.5;   px[7]=8.0; py[7]=8.0;
    STRICT cx[2] AS F64;
    STRICT cy[2] AS F64;
    --  k-means++ seeding: first center = first point, second = farthest
    cx[0] = px[0]; cy[0] = py[0];
    LET far AS S32 = 0;
    LET fd AS F64 = 0.0;
    FOR i = 1 TO 7
        LET dd AS F64 = (px[i] - cx[0]) * (px[i] - cx[0]) + (py[i] - cy[0]) * (py[i] - cy[0]);
        IF dd > fd THEN
            fd = dd;
            far = i;
        END IF
    END FOR
    cx[1] = px[far]; cy[1] = py[far];
    STRICT asn[8] AS S32;
    FOR it = 0 TO 4
        FOR c = 0 TO 1
            LET sx AS F64 = 0.0;
            LET sy AS F64 = 0.0;
            LET cnt AS S32 = 0;
            FOR i = 0 TO 7
                LET d0 AS F64 = (px[i] - cx[0]) * (px[i] - cx[0]) + (py[i] - cy[0]) * (py[i] - cy[0]);
                LET d1 AS F64 = (px[i] - cx[1]) * (px[i] - cx[1]) + (py[i] - cy[1]) * (py[i] - cy[1]);
                IF d1 < d0 THEN
                    asn[i] = 1;
                ELSE
                    asn[i] = 0;
                END IF
                IF asn[i] = c THEN
                    sx = sx + px[i];
                    sy = sy + py[i];
                    cnt = cnt + 1;
                END IF
            END FOR
            IF cnt > 0 THEN
                cx[c] = sx / cnt;
                cy[c] = sy / cnt;
            END IF
        END FOR
    END FOR
    PRINT$ "c0: " | cx[0] | "," | cy[0];
    PRINT$ "c1: " | cx[1] | "," | cy[1];
END
