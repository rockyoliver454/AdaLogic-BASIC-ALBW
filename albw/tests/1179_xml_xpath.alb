VERSION 1.0

STRICT tag[10] AS STRING
STRICT par[10] AS S64
STRICT txt[10] AS STRING
LET nnd AS S64 = 0


PROCEDURE AddNode(tg AS STRING, p AS S64, tv AS STRING)
    tag[nnd] = tg
    par[nnd] = p
    txt[nnd] = tv
    nnd = nnd + 1
END PROCEDURE


BEGIN
    nnd = 0
    AddNode("library", -1, "")
    AddNode("book", 0, "")
    AddNode("title", 1, "Rosetta ALB")
    AddNode("author", 1, "Devin")
    AddNode("book", 0, "")
    AddNode("title", 4, "Compiler Craft")

    LET hits AS S64 = 0
    LET i AS S64 = 0
    WHILE i < nnd
        IF tag[i] = "title" THEN
            LET p AS S64 = par[i]
            IF p >= 0 ANDALSO tag[p] = "book" THEN
                LET gp AS S64 = par[p]
                IF gp >= 0 ANDALSO tag[gp] = "library" THEN
                    hits = hits + 1
                    PRINT "/library/book/title -> " | txt[i]
                END IF
            END IF
        END IF
        i = i + 1
    END WHILE
    PRINT "xpath hits=" | hits

    LET hits2 AS S64 = 0
    i = 0
    WHILE i < nnd
        IF par[i] = 0 ANDALSO tag[i] = "book" THEN
            hits2 = hits2 + 1
        END IF
        i = i + 1
    END WHILE
    PRINT "/library/book count=" | hits2
END
