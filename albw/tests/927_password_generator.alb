-- 927 | Password generator: seeded; enforce one of each
-- class (lower, upper, digit, symbol) then fill, then verify
-- the generated password satisfies the policy.
DECLARE MODULE Pw
    FUNCTION Nxt() AS S64
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pw
    STRICT sd[1] AS S64
    STRICT pw[33] AS S64

    FUNCTION Nxt() AS S64
        sd[1] = (sd[1] * 1103515245 + 12345) MOD 2147483648
        RETURN (sd[1] / 65536) MOD 32768
    END FUNCTION

    PROCEDURE Run()
        LET low AS STRING = "abcdefghijklmnopqrstuvwxyz"
        LET up AS STRING = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        LET dg AS STRING = "0123456789"
        LET sy AS STRING = "!@#$%^&*"
        LET all AS STRING = low | up | dg | sy
        sd[1] = 31415
        LET n AS S64 = 16
        -- one of each class
        pw[1] = ASC(MID$(low, Nxt() MOD 26 + 1, 1))
        pw[2] = ASC(MID$(up, Nxt() MOD 26 + 1, 1))
        pw[3] = ASC(MID$(dg, Nxt() MOD 10 + 1, 1))
        pw[4] = ASC(MID$(sy, Nxt() MOD 8 + 1, 1))
        FOR i = 5 TO n
            pw[i] = ASC(MID$(all, Nxt() MOD LEN(all) + 1, 1))
        END FOR
        -- Fisher-Yates shuffle positions
        FOR k = 2 TO n
            LET j AS S64 = Nxt() MOD k + 1
            LET t AS S64 = pw[k]
            pw[k] = pw[j]
            pw[j] = t
        END FOR
        LET s AS STRING = ""
        FOR i = 1 TO n
            s = s | CHR(pw[i])
        END FOR
        PRINT s
        -- verify classes present
        LET nl AS S64 = 0
        LET nu AS S64 = 0
        LET nd AS S64 = 0
        LET ns AS S64 = 0
        FOR i = 1 TO n
            LET c AS S64 = pw[i]
            IF c >= 97 ANDALSO c <= 122 THEN nl = nl + 1 END IF
            IF c >= 65 ANDALSO c <= 90 THEN nu = nu + 1 END IF
            IF c >= 48 ANDALSO c <= 57 THEN nd = nd + 1 END IF
            IF (c >= 33 ANDALSO c <= 38) ORELSE c = 64 ORELSE c = 42 THEN ns = ns + 1 END IF
        END FOR
        IF nl > 0 ANDALSO nu > 0 ANDALSO nd > 0 ANDALSO ns > 0 THEN
            PRINT "policy ok"
        ELSE
            PRINT "policy FAIL"
        END IF
    END PROCEDURE
END MODULE

IMPORT Pw
BEGIN
    Pw.Run()
END
