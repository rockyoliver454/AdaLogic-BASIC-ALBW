VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION


BEGIN
    sd = 777
    LET col AS S64 = 0
    WHILE col < 16
        LET head AS S64 = Nxt() MOD 40
        LET rlen AS S64 = 6 + Nxt() MOD 20
        LET r AS S64 = 0
        WHILE r < rlen
            LET y AS S64 = head - r
            IF y >= 0 ANDALSO y < 64 THEN
                LET v AS S64 = 255 - r * 12
                IF v < 32 THEN v = 32 END IF
                img[y * 64 + col * 4 + 1] = v * 256
                img[y * 64 + col * 4 + 2] = v * 256
            END IF
            r = r + 1
        END WHILE
        col = col + 1
    END WHILE

    CREATE_WINDOW "Matrix digital rain", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "columns=16"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
