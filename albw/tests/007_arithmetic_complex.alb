-- 007 | Arithmetic/Complex: (re,im) pairs with add/mul/magnitude.
DEFINE STRUCT Complex
    re AS F64
    im AS F64
END STRUCT

BEGIN
    LET a AS Complex
    a.re = 1.0; a.im = 2.0;
    LET b AS Complex
    b.re = 3.0; b.im = -1.0;
    LET s AS Complex
    s.re = a.re + b.re; s.im = a.im + b.im;
    LET p AS Complex
    p.re = a.re * b.re - a.im * b.im;
    p.im = a.re * b.im + a.im * b.re;
    PRINT$ "sum:  " | s.re | " + " | s.im | "i";
    PRINT$ "prod: " | p.re | " + " | p.im | "i";
    PRINT$ "|a|:  " | SQRT(a.re * a.re + a.im * a.im);
END
