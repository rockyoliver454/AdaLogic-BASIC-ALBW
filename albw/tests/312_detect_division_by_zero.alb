-- 312 | Detect division by zero: guard the divisor before dividing.
BEGIN
    STRICT nums[2] AS S32
    STRICT dens[2] AS S32
    nums[0] = 42
    dens[0] = 7
    nums[1] = 17
    dens[1] = 0

    FOR i = 0 TO 1
        IF dens[i] = 0 THEN
            PRINT "division by zero"
        ELSE
            PRINT nums[i] / dens[i]
        END IF
    END FOR
END
