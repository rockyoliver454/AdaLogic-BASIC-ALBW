-- 287 | Split a character string based on change of character.
DECLARE MODULE CharSplit
    PROCEDURE Split(s AS STRING)
END DECLARE MODULE

MODULE CharSplit
    STRICT groups[16] AS STRING
    LET group_count AS S32 = 0

    PROCEDURE Split(s AS STRING)
        group_count = 0
        LET cur AS STRING = ""
        LET prev AS S32 = -1
        FOR i = 1 TO LEN(s)
            LET c AS S32 = ASC(MID$(s, i, 1))
            IF prev >= 0 ANDALSO c <> prev THEN
                groups[group_count] = cur
                group_count = group_count + 1
                cur = ""
            END IF
            cur = cur | CHR(c)
            prev = c
        END FOR
        IF LEN(cur) > 0 THEN
            groups[group_count] = cur
            group_count = group_count + 1
        END IF

        LET out_line AS STRING = ""
        FOR g = 0 TO group_count - 1
            IF g > 0 THEN out_line = out_line | ", " END IF
            out_line = out_line | "'" | groups[g] | "'"
        END FOR
        PRINT out_line
    END PROCEDURE
END MODULE

IMPORT CharSplit
BEGIN
    CharSplit.Split("gHHH5YY++///" | CHR(92))
    CharSplit.Split("aabbbbaab")
END
