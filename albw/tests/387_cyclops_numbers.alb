-- 387 | Cyclops numbers: palindromes with odd digit count, middle digit 0, others
--        nonzero; first 30.
DECLARE MODULE Cyclops
    FUNCTION IsCyclops(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Cyclops
    STRICT dig[20] AS S64
    FUNCTION IsCyclops(n AS S64) AS S32
        LET m AS S64 = n
        LET nd AS S32 = 0
        WHILE m > 0
            dig[nd] = m MOD 10
            nd = nd + 1
            m = m / 10
        END WHILE
        IF nd MOD 2 = 0 THEN RETURN 0 END IF
        IF dig[nd / 2] <> 0 THEN RETURN 0 END IF
        FOR i = 0 TO nd / 2
            IF i < nd - 1 - i THEN
                IF dig[i] <> dig[nd - 1 - i] THEN RETURN 0 END IF
                IF dig[i] = 0 THEN RETURN 0 END IF
            END IF
        END FOR
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = ""
        LET found AS S32 = 0
        LET n AS S64 = 1
        WHILE found < 30
            IF IsCyclops(n) = 1 THEN
                s = s | n | " "
                found = found + 1
            END IF
            n = n + 1
        END WHILE
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Cyclops
BEGIN
    Cyclops.Run()
END
