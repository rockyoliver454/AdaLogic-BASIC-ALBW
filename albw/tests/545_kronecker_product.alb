-- 545 | Kronecker product of A(2x2)=[[0,1,0],[1,0,1]...] use classic
-- RC example: A=[[1,2],[3,4]], B=[[0,5],[6,7]].
DECLARE MODULE Kron
    PROCEDURE Run()
END DECLARE MODULE

MODULE Kron
    PROCEDURE Run()
        LET a1 AS S64 = 1
        LET a2 AS S64 = 2
        LET a3 AS S64 = 3
        LET a4 AS S64 = 4
        PRINT a1 * 0 | " " | a1 * 5 | " " | a2 * 0 | " " | a2 * 5
        PRINT a1 * 6 | " " | a1 * 7 | " " | a2 * 6 | " " | a2 * 7
        PRINT a3 * 0 | " " | a3 * 5 | " " | a4 * 0 | " " | a4 * 5
        PRINT a3 * 6 | " " | a3 * 7 | " " | a4 * 6 | " " | a4 * 7
    END PROCEDURE
END MODULE

IMPORT Kron
BEGIN
    Kron.Run()
END
