-- 233 | Associative array merging: copy base entries, then replace/append updates.
DECLARE MODULE Maps
    PROCEDURE Initialize()
    PROCEDURE Merge()
    PROCEDURE ShowResult()
END DECLARE MODULE

MODULE Maps
    STRICT base_keys[3] AS STRING
    STRICT base_values[3] AS STRING
    STRICT update_keys[3] AS STRING
    STRICT update_values[3] AS STRING
    STRICT result_keys[6] AS STRING
    STRICT result_values[6] AS STRING
    LET result_count AS S32 = 0

    FUNCTION KeysEqual(a AS STRING, b AS STRING) AS S32
        IF LEN(a) <> LEN(b) THEN RETURN 0 END IF
        FOR i = 1 TO LEN(a)
            IF ASC(MID$(a, i, 1)) <> ASC(MID$(b, i, 1)) THEN RETURN 0 END IF
        END FOR
        RETURN 1
    END FUNCTION

    FUNCTION FindResult(key_value AS STRING) AS S32
        FOR i = 0 TO result_count - 1
            IF KeysEqual(result_keys[i], key_value) THEN RETURN i END IF
        END FOR
        RETURN -1
    END FUNCTION

    PROCEDURE Initialize()
        base_keys[0] = "name"
        base_values[0] = "Rocket Skates"
        base_keys[1] = "price"
        base_values[1] = "12.75"
        base_keys[2] = "color"
        base_values[2] = "yellow"
        update_keys[0] = "price"
        update_values[0] = "15.25"
        update_keys[1] = "color"
        update_values[1] = "red"
        update_keys[2] = "year"
        update_values[2] = "1974"
    END PROCEDURE

    PROCEDURE Merge()
        result_count = 0
        FOR i = 0 TO 2
            result_keys[result_count] = base_keys[i]
            result_values[result_count] = base_values[i]
            result_count = result_count + 1
        END FOR
        FOR i = 0 TO 2
            LET pos AS S32 = FindResult(update_keys[i])
            IF pos >= 0 THEN
                result_values[pos] = update_values[i]
            ELSE
                result_keys[result_count] = update_keys[i]
                result_values[result_count] = update_values[i]
                result_count = result_count + 1
            END IF
        END FOR
    END PROCEDURE

    PROCEDURE ShowResult()
        FOR i = 0 TO result_count - 1
            PRINT result_keys[i] | " = " | result_values[i]
        END FOR
    END PROCEDURE
END MODULE

IMPORT Maps
BEGIN
    Maps.Initialize()
    Maps.Merge()
    Maps.ShowResult()
END
