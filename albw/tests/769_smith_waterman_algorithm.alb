-- 769 | Smith-Waterman algorithm: local sequence alignment,
-- match=1 mismatch=-1 gap=-1.
DECLARE MODULE Sw
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sw
    STRICT hh[900] AS S64

    PROCEDURE Run()
        LET a AS STRING = "TGTTACGG"
        LET b AS STRING = "GGTTGACTA"
        LET m AS S64 = LEN(a)
        LET n AS S64 = LEN(b)
        FOR i = 0 TO m
            hh[i * (n + 1)] = 0
        END FOR
        FOR j = 0 TO n
            hh[j] = 0
        END FOR
        LET best AS S64 = 0
        LET bi AS S64 = 0
        LET bj AS S64 = 0
        FOR i = 1 TO m
            FOR j = 1 TO n
                LET s AS S64 = 0 - 1
                IF MID$(a, i, 1) = MID$(b, j, 1) THEN s = 1 END IF
                LET v AS S64 = hh[(i - 1) * (n + 1) + j - 1] + s
                LET u AS S64 = hh[(i - 1) * (n + 1) + j] - 1
                LET l AS S64 = hh[i * (n + 1) + j - 1] - 1
                IF u > v THEN v = u END IF
                IF l > v THEN v = l END IF
                IF v < 0 THEN v = 0 END IF
                hh[i * (n + 1) + j] = v
                IF v > best THEN
                    best = v
                    bi = i
                    bj = j
                END IF
            END FOR
        END FOR
        PRINT "score=" | best
        LET ra AS STRING = ""
        LET rb AS STRING = ""
        LET i AS S64 = bi
        LET j AS S64 = bj
        WHILE i > 0 ANDALSO j > 0 ANDALSO hh[i * (n + 1) + j] > 0
            LET diag AS S64 = hh[(i - 1) * (n + 1) + j - 1]
            LET cur AS S64 = hh[i * (n + 1) + j + 1]
            LET s2 AS S64 = 0 - 1
            IF MID$(a, i, 1) = MID$(b, j, 1) THEN s2 = 1 END IF
            IF cur = diag + s2 THEN
                ra = MID$(a, i, 1) | ra
                rb = MID$(b, j, 1) | rb
                i = i - 1
                j = j - 1
            ELSE
                LET up AS S64 = hh[(i - 1) * (n + 1) + j]
                IF cur = up - 1 THEN
                    ra = MID$(a, i, 1) | ra
                    rb = "-" | rb
                    i = i - 1
                ELSE
                    ra = "-" | ra
                    rb = MID$(b, j, 1) | rb
                    j = j - 1
                END IF
            END IF
        END WHILE
        PRINT ra
        PRINT rb
    END PROCEDURE
END MODULE

IMPORT Sw
BEGIN
    Sw.Run()
END
