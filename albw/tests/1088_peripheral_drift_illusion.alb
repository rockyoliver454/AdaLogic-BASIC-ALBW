VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET nq AS S64 = 0


BEGIN
    LET ry AS S64 = 0
    WHILE ry < 5
        LET rx AS S64 = 0
        WHILE rx < 5
            LET ox AS S64 = rx * 12 + (ry MOD 2) * 6 + 3
            LET oy AS S64 = ry * 12 + 3
            LET yy AS S64 = 0
            WHILE yy < 9
                LET xx AS S64 = 0
                WHILE xx < 9
                    LET ring AS S64 = 0
                    IF xx = 0 ORELSE xx = 8 ORELSE yy = 0 ORELSE yy = 8 THEN ring = 1 END IF
                    IF xx = 2 ORELSE xx = 6 ORELSE yy = 2 ORELSE yy = 6 THEN ring = 2 END IF
                    LET v AS S64 = 0
                    IF ring = 1 THEN v = 16777215 END IF
                    IF ring = 2 THEN v = 65535 END IF
                    IF xx > 2 ANDALSO xx < 6 ANDALSO yy > 2 ANDALSO yy < 6 THEN v = 16711680 END IF
                    img[(oy + yy) * 64 + ox + xx] = v
                    xx = xx + 1
                END WHILE
                yy = yy + 1
            END WHILE
            nq = nq + 1
            rx = rx + 1
        END WHILE
        ry = ry + 1
    END WHILE

    CREATE_WINDOW "Peripheral drift illusion", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "tiles=" | nq
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
