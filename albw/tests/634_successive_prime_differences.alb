-- 634 | Successive prime differences: gaps between consecutive
-- primes below 100.
DECLARE MODULE Pd
    FUNCTION IsPrime(n AS S64) AS S32
    PROCEDURE Run()
END DECLARE MODULE

MODULE Pd
    FUNCTION IsPrime(n AS S64) AS S32
        IF n < 2 THEN RETURN 0 END IF
        LET d AS S64 = 2
        WHILE d * d <= n
            IF n MOD d = 0 THEN RETURN 0 END IF
            d = d + 1
        END WHILE
        RETURN 1
    END FUNCTION

    PROCEDURE Run()
        LET prev AS S64 = 2
        LET s AS STRING = ""
        FOR n = 3 TO 99
            IF IsPrime(n) = 1 THEN
                s = s | (n - prev) | " "
                prev = n
            END IF
        END FOR
        PRINT s
    END PROCEDURE
END MODULE

IMPORT Pd
BEGIN
    Pd.Run()
END
