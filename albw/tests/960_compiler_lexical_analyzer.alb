-- 960 | Compiler/lexical analyzer: tokenize a source string
-- into (type, lexeme) pairs: number, ident, op, lparen...
DECLARE MODULE Lx
    PROCEDURE Run()
END DECLARE MODULE

MODULE Lx
    FUNCTION IsDig(c AS S64) AS S64
        RETURN c >= ASC("0") ANDALSO c <= ASC("9")
    END FUNCTION
    FUNCTION IsAlp(c AS S64) AS S64
        RETURN (c >= ASC("a") ANDALSO c <= ASC("z")) ORELSE (c >= ASC("A") ANDALSO c <= ASC("Z")) ORELSE c = ASC("_")
    END FUNCTION

    PROCEDURE Run()
        LET s AS STRING = "sum = alpha + 42 * (beta - 7)"
        LET n AS S64 = LEN(s)
        LET i AS S64 = 1
        WHILE i <= n
            LET c AS S64 = ASC(MID$(s, i, 1))
            IF c = 32 ORELSE c = 9 THEN
                i = i + 1
            ELSE
                IF IsDig(c) <> 0 THEN
                    LET j AS S64 = i
                    WHILE j <= n ANDALSO IsDig(ASC(MID$(s, j, 1))) <> 0
                        j = j + 1
                    END WHILE
                    PRINT "num  " | MID$(s, i, j - i)
                    i = j
                ELSE
                    IF IsAlp(c) <> 0 THEN
                        LET j AS S64 = i
                        WHILE j <= n ANDALSO (IsAlp(ASC(MID$(s, j, 1))) <> 0 ORELSE IsDig(ASC(MID$(s, j, 1))) <> 0)
                            j = j + 1
                        END WHILE
                        LET t AS STRING = MID$(s, i, j - i)
                        IF ASC(MID$(t, 1, 1)) = ASC("s") ANDALSO LEN(t) = 3 THEN
                            PRINT "kw   " | t
                        ELSE
                            PRINT "id   " | t
                        END IF
                        i = j
                    ELSE
                        IF c = ASC("(") THEN PRINT "lpar ("
                        ELSE IF c = ASC(")") THEN PRINT "rpar )"
                        ELSE PRINT "op   " | MID$(s, i, 1)
                        END IF
                        END IF
                        i = i + 1
                    END IF
                END IF
            END IF
        END WHILE
    END PROCEDURE
END MODULE

IMPORT Lx
BEGIN
    Lx.Run()
END
