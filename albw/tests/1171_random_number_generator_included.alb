VERSION 1.0

LET st AS S64 = 0
STRICT buckets[10] AS S64


FUNCTION XNext() AS S64
    st = st XOR (st SHL 13)
    st = st XOR (st SHR 7)
    st = st XOR (st SHL 17)
    RETURN st
END FUNCTION


BEGIN
    st = 88172645463325252
    LET i AS S64 = 0
    WHILE i < 8
        LET v AS S64 = XNext()
        IF v < 0 THEN
            v = 0 - v
        END IF
        PRINT "x" | i | "=" | (v MOD 1000000)
        i = i + 1
    END WHILE
    i = 0
    WHILE i < 10000
        LET v2 AS S64 = XNext()
        IF v2 < 0 THEN
            v2 = 0 - v2
        END IF
        buckets[v2 MOD 10] = buckets[v2 MOD 10] + 1
        i = i + 1
    END WHILE
    LET lo AS S64 = 99999
    LET hi AS S64 = 0
    i = 0
    WHILE i < 10
        IF buckets[i] < lo THEN
            lo = buckets[i]
        END IF
        IF buckets[i] > hi THEN
            hi = buckets[i]
        END IF
        i = i + 1
    END WHILE
    PRINT "digit spread lo=" | lo | " hi=" | hi
END
