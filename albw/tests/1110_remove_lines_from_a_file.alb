VERSION 1.0

BEGIN
    LET h AS S64 = OPEN("rm.txt", "w")
    WRITE h, "keep one" | CHR(10) | "drop me" | CHR(10) | "keep two" | CHR(10) | "drop again" | CHR(10)
    CLOSE h

    LET r AS S64 = OPEN("rm.txt", "r")
    LET whole AS STRING = READ(r, FILELEN("rm.txt"))
    CLOSE r
    whole = whole | CHR(10)

    LET res AS STRING = ""
    LET removed AS S64 = 0
    LET start AS S64 = 1
    LET i AS S64 = 1
    WHILE i <= LEN(whole)
        IF ASC(MID$(whole, i, 1)) = 10 THEN
            LET ln AS STRING = MID$(whole, start, i - start)
            IF LEFT$(ln, 4) = "drop" THEN
                removed = removed + 1
            ELSE
                res = res | ln | CHR(10)
            END IF
            start = i + 1
        END IF
        i = i + 1
    END WHILE

    LET w AS S64 = OPEN("rm.txt", "w")
    WRITE w, res
    CLOSE w

    LET r2 AS S64 = OPEN("rm.txt", "r")
    PRINT "removed=" | removed
    PRINT "kept=" | READ(r2, FILELEN("rm.txt"))
    CLOSE r2
END
