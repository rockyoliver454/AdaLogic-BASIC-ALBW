-- 168 | LU decomposition (Doolittle) of a 3x3 matrix.
BEGIN
    STRICT a[3,3] AS F64;
    a[0,0]=1.0; a[0,1]=3.0; a[0,2]=5.0;
    a[1,0]=2.0; a[1,1]=4.0; a[1,2]=7.0;
    a[2,0]=1.0; a[2,1]=1.0; a[2,2]=0.0;
    STRICT l[3,3] AS F64;
    STRICT u[3,3] AS F64;
    FOR i = 0 TO 2
        FOR k = i TO 2
            LET s AS F64 = 0.0;
            FOR j = 0 TO i - 1
                s = s + l[i,j] * u[j,k];
            END FOR
            u[i,k] = a[i,k] - s;
        END FOR
        l[i,i] = 1.0;
        FOR k = i + 1 TO 2
            LET s AS F64 = 0.0;
            FOR j = 0 TO i - 1
                s = s + l[k,j] * u[j,i];
            END FOR
            l[k,i] = (a[k,i] - s) / u[i,i];
        END FOR
    END FOR
    FOR i = 0 TO 2
        PRINT$ l[i,0] | " " | l[i,1] | " " | l[i,2];
    END FOR
    PRINT$ "---";
    FOR i = 0 TO 2
        PRINT$ u[i,0] | " " | u[i,1] | " " | u[i,2];
    END FOR
END
