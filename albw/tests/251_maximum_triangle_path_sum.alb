-- 251 | Maximum triangle path sum: Euler #18, bottom-up dynamic programming.
DECLARE MODULE TriPath
    FUNCTION MaxPathSum() AS S32
END DECLARE MODULE

MODULE TriPath
    STRICT tri[171] AS S32
    LET rows AS S32 = 18

    FUNCTION Index(r AS S32, c AS S32) AS S32
        RETURN (r * (r + 1)) / 2 + c
    END FUNCTION

    FUNCTION Max2(a AS S32, b AS S32) AS S32
        IF a > b THEN RETURN a END IF
        RETURN b
    END FUNCTION

