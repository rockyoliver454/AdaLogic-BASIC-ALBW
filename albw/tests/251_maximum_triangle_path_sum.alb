    END PROCEDURE

    FUNCTION MaxPathSum() AS S32
        LET r AS S32 = rows - 2
        WHILE r >= 0
            FOR c = 0 TO r
                LET down_left AS S32 = tri[Index(r + 1, c)]
                LET down_right AS S32 = tri[Index(r + 1, c + 1)]
                tri[Index(r, c)] = tri[Index(r, c)] + Max2(down_left, down_right)
            END FOR
            r = r - 1
        END WHILE
        RETURN tri[Index(0, 0)]
    END FUNCTION
END MODULE

IMPORT TriPath
BEGIN
    TriPath.Init()
    PRINT TriPath.MaxPathSum()
END
