-- 991 | Sierpinski carpet: 27x27 ASCII, cell survives if
-- no digit pair (x,y) is both 1 in base 3.
DECLARE MODULE Sk
    PROCEDURE Run()
END DECLARE MODULE

MODULE Sk
    PROCEDURE Run()
        FOR y = 0 TO 26
            LET row AS STRING = ""
            FOR x = 0 TO 26
                LET xx AS S64 = x
                LET yy AS S64 = y
                LET fl AS S64 = 1
                WHILE xx > 0 ORELSE yy > 0
                    IF xx MOD 3 = 1 ANDALSO yy MOD 3 = 1 THEN fl = 0 END IF
                    xx = xx / 3
                    yy = yy / 3
                END WHILE
                IF fl = 1 THEN
                    row = row | "#"
                ELSE
                    row = row | " "
                END IF
            END FOR
            PRINT row
        END FOR
    END PROCEDURE
END MODULE

IMPORT Sk
BEGIN
    Sk.Run()
END
