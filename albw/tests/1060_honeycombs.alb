VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET nhex AS S64 = 0

PROCEDURE HexE(cx AS S64, cy AS S64)
    nhex = nhex + 1
    LET i AS S64 = 0
    WHILE i < 6
        LET a AS S64 = i * 60 + 30
        LET xf AS F64 = cx * 1.0
        LET yf AS F64 = cy * 1.0
        LET af AS F64 = a * 1.0
        LET sx AS S64 = ROUND(xf + COS(af * 0.017453292519943295) * 7.0)
        LET sy AS S64 = ROUND(yf + SIN(af * 0.017453292519943295) * 7.0)
        LET j AS S64 = (i + 1) MOD 6
        LET aj AS S64 = j * 60 + 30
        LET ajf AS F64 = aj * 1.0
        LET ex AS S64 = ROUND(xf + COS(ajf * 0.017453292519943295) * 7.0)
        LET ey AS S64 = ROUND(yf + SIN(ajf * 0.017453292519943295) * 7.0)
        LET s AS S64 = 0
        WHILE s < 8
            LET px AS S64 = sx + (ex - sx) * s / 8
            LET py AS S64 = sy + (ey - sy) * s / 8
            IF px >= 0 ANDALSO px < 64 ANDALSO py >= 0 ANDALSO py < 64 THEN
                img[py * 64 + px] = 16776960
            END IF
            s = s + 1
        END WHILE
        i = i + 1
    END WHILE
END PROCEDURE


BEGIN
    LET row AS S64 = 0
    WHILE row < 5
        LET col AS S64 = 0
        WHILE col < 5
            LET cx AS S64 = 8 + col * 12 + (row MOD 2) * 6
            LET cy AS S64 = 8 + row * 11
            CALL HexE(cx, cy)
            col = col + 1
        END WHILE
        row = row + 1
    END WHILE

    CREATE_WINDOW "Honeycombs", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "hexagons=" | nhex
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
