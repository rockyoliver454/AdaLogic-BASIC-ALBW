-- 138 | Knapsack unbounded: unlimited copies, DP.
BEGIN
    STRICT wt[3] AS S32;
    STRICT vl[3] AS S32;
    wt[0]=2; vl[0]=3;  wt[1]=3; vl[1]=4;  wt[2]=4; vl[2]=5;
    LET cap AS S32 = 10;
    STRICT dp[11] AS S32;
    FOR w = 0 TO cap
        FOR i = 0 TO 2
            IF wt[i] <= w THEN
                LET cand AS S32 = dp[w - wt[i]] + vl[i];
                IF cand > dp[w] THEN
                    dp[w] = cand;
                END IF
            END IF
        END FOR
    END FOR
    PRINT dp[cap];
END
