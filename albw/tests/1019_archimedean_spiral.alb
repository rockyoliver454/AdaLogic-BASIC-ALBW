VERSION 1.0
STRICT img[4096] AS S32

LET frames AS S64 = 0
LET np AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fx AS S64 = 0
LET fy AS S64 = 0
LET fpx AS S64 = 0

BEGIN
    LET t AS F64 = 0.0
    LET r AS F64 = 0.0
    LET sx AS S64 = 0
    LET sy AS S64 = 0
    WHILE t < 18.849555921538759
        r = t * 1.2
        sx = ROUND(32.0 + r * COS(t))
        sy = ROUND(32.0 + r * SIN(t))
        IF sx >= 0 ANDALSO sx < 64 ANDALSO sy >= 0 ANDALSO sy < 64 THEN
            img[sy * 64 + sx] = 16776960
        END IF
        np = np + 1
        t = t + 0.03
    END WHILE

    CREATE_WINDOW "Archimedean spiral", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
        k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fx = k MOD 64
        fy = k / 64
        fpx = READ_PIXEL(fx, fy)
    END

    LISTEN

    PRINT "points=" | np
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px(" | fx | "," | fy | ")=" | fpx
END
