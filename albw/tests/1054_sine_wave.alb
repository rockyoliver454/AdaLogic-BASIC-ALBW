VERSION 1.0

STRICT img[4096] AS S32

LET frames AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0


BEGIN
    LET x AS S64 = 0
    WHILE x < 64
        LET xf AS F64 = x * 1.0
        LET v AS F64 = SIN(xf * 0.19634954084936207)
        LET y AS S64 = ROUND(32.0 - v * 22.0)
        img[y * 64 + x] = 65535
        IF y + 1 < 64 THEN img[(y + 1) * 64 + x] = 65535 END IF
        x = x + 1
    END WHILE

    CREATE_WINDOW "Sine wave", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END
    ON PAINT
        LET k AS S64 = 0
        CLEAR $000000
        k = 0
        ink = 0
        chk = 0
        WHILE k < 4096
            IF img[k] <> 0 THEN
                COLOR img[k]
                PLOT k MOD 64, k / 64
                ink = ink + 1
                chk = chk + k
            END IF
            k = k + 1
        END WHILE
                k = 0
        WHILE img[k] = 0 ANDALSO k < 4095
            k = k + 1
        END WHILE
        fpx = READ_PIXEL(k MOD 64, k / 64)
    END

    LISTEN

    PRINT "cycles=2 amp=22"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "hitpx=" | fpx
END
