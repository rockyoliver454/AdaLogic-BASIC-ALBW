VERSION 1.0
STRICT img[4096] AS S32
STRICT vx[5] AS S64
STRICT vy[5] AS S64

LET frames AS S64 = 0
LET np AS S64 = 0
LET ink AS S64 = 0
LET chk AS S64 = 0
LET fpx AS S64 = 0
LET sd AS S64 = 0
LET cpx AS F64 = 32.0
LET cpy AS F64 = 32.0

FUNCTION Nxt() AS S64
    sd = (sd * 1103515245 + 12345) MOD 2147483648
    RETURN (sd / 65536) MOD 32768
END FUNCTION

FUNCTION Sn(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN SIN(df * 0.017453292519943295)
END FUNCTION

FUNCTION Cs(deg AS S64) AS F64
    LET df AS F64 = deg * 1.0
    RETURN COS(df * 0.017453292519943295)
END FUNCTION

BEGIN
    LET i AS S64 = 0
    WHILE i < 5
        vx[i] = ROUND(32.0 + 26.0 * Sn(i * 72))
        vy[i] = ROUND(32.0 - 26.0 * Cs(i * 72))
        i = i + 1
    END WHILE

    sd = 4241
    i = 0
    LET k AS S64 = 0
    LET sx AS S64 = 0
    LET sy AS S64 = 0
    WHILE i < 8000
        k = Nxt() MOD 5
        cpx = cpx + (0.382 * ((vx[k] * 1.0) - cpx))
        cpy = cpy + (0.382 * ((vy[k] * 1.0) - cpy))
        IF i > 20 THEN
            sx = ROUND(cpx)
            sy = ROUND(cpy)
            IF sx >= 0 ANDALSO sx < 64 ANDALSO sy >= 0 ANDALSO sy < 64 THEN
                img[sy * 64 + sx] = 16766720
            END IF
            np = np + 1
        END IF
        i = i + 1
    END WHILE

    CREATE_WINDOW "Sierpinski pentagon", 64, 64

    ON TICK
        TICK 16
        frames = frames + 1
        IF frames >= 3 THEN
            CEASE
        END IF
    END

    ON PAINT
        LET k2 AS S64 = 0
        CLEAR $000000
        k2 = 0
        ink = 0
        chk = 0
        WHILE k2 < 4096
            IF img[k2] <> 0 THEN
                COLOR img[k2]
                PLOT k2 MOD 64, k2 / 64
                ink = ink + 1
                chk = chk + k2
            END IF
            k2 = k2 + 1
        END WHILE
        k2 = 0
        WHILE img[k2] = 0 ANDALSO k2 < 4095
            k2 = k2 + 1
        END WHILE
        fpx = READ_PIXEL(k2 MOD 64, k2 / 64)
    END

    LISTEN

    PRINT "iters=8000"
    PRINT "ink=" | ink
    PRINT "chk=" | chk
    PRINT "px=" | fpx
END
