-- ============================================================================
-- Nemeth - Nemeth Braille Code for Mathematics and Science Notation
--
-- Transcribes mathematical notation into 6-dot braille cells per the
-- Nemeth Code (BANA 2022 edition).  Three output layers
--   cell bitmasks (dot 1 = bit 0 .. dot 6 = bit 5, value 0..63)
--   BRF  (North American Braille ASCII - embosser/braille-display ready)
--   Unicode braille patterns (U+2800+)
--
-- Two modes: pure Nemeth, or Nemeth-in-UEB (literary runs wrapped in the
-- switch indicators _% / _: ).  Strict transcription: anything outside
-- the implemented spec lands in the error ledger, never wrong output.
--
-- Layer 1 (this file): cell model, tables, emit buffer, encoders,
--   linear builder API, error ledger.
-- Later layers: expression parser, spatial arrangements, UEB bridge,
--   stitchforge french-knot export, MCP tools.
--
-- USE
INCLUDE "nemeth.albi"
IMPORT Nemeth
--       Nemeth.Reset()
--       Nemeth.Num("3"): Nemeth.Plus(): Nemeth.Num("4")
--       Nemeth.Space(): Nemeth.Equals(): Nemeth.Space()
--       Nemeth.Num("7")
--       PRINT Nemeth.ToBrf()     =>   #3+4 .K #7
-- ============================================================================

VERSION 1.0

DECLARE MODULE Nemeth
    -- lifecycle / raw emit
    PROCEDURE Reset()
    PROCEDURE Put(c AS S64)
    PROCEDURE Space()
    PROCEDURE Newline()

    -- buffer access / encoders
    FUNCTION Count() AS S64
    FUNCTION Cell(i AS S64) AS S64
    FUNCTION ToBrf() AS STRING
    FUNCTION ToUni() AS STRING

    -- row readback (cells split on the -1 line-break sentinel)
    FUNCTION RowCount() AS S64
    FUNCTION RowBrf(r AS S64) AS STRING
    FUNCTION RowUni(r AS S64) AS STRING

    -- error ledger (strict transcription)
    FUNCTION ErrCount() AS S64
    FUNCTION ErrText(i AS S64) AS STRING

    -- mode flags (numeric-mode suppresses the indicator, levels mark
    -- superscript/subscript position where numerals take no indicator)
    PROCEDURE Num(s AS STRING)
    PROCEDURE Letters(s AS STRING)

    -- signs of operation
    PROCEDURE Plus()
    PROCEDURE Minus()
    PROCEDURE TimesCross()        -- x multiplication
    PROCEDURE DotOp()        -- . multiplication dot
    PROCEDURE Obelus()       -- division
    PROCEDURE Slash()        -- / between expressions
    PROCEDURE PlusMinus()

    -- signs of comparison (caller supplies surrounding spaces)
    PROCEDURE Equals()
    PROCEDURE Lt()
    PROCEDURE Gt()
    PROCEDURE Le()
    PROCEDURE Ge()
    PROCEDURE Ne()

    -- grouping
    PROCEDURE ParenL()
    PROCEDURE ParenR()
    PROCEDURE BracketL()     -- [
    PROCEDURE BracketR()     -- ]
    PROCEDURE BraceL()       -- {
    PROCEDURE BraceR()       -- }
    PROCEDURE BarSym()       -- |  (abs value / such-that)
    PROCEDURE FloorL()       -- |_
    PROCEDURE FloorR()       -- _|
    PROCEDURE CeilL()        -- |
    PROCEDURE CeilR()        -- |
    PROCEDURE AngL()         -- <
    PROCEDURE AngR()         -- >

    -- fractions:  k = 0 simple, 1 complex, 2 hypercomplex
    PROCEDURE FracOpen(k AS S64)
    PROCEDURE FracLine(k AS S64)
    PROCEDURE FracClose(k AS S64)
    PROCEDURE MFracOpen()    -- fractional part of a mixed number
    PROCEDURE MFracClose()

    -- levels: each emits its indicator; content follows until the next
    -- level/baseline call or a space
    PROCEDURE Sup()
    PROCEDURE Sub()
    PROCEDURE Base()

    -- radicals: Rad() opens, RadIdx() marks the index, Term() closes
    PROCEDURE Rad()
    PROCEDURE RadIdx()
    PROCEDURE Term()

    -- indicators and misc
    PROCEDURE Punct(ch AS STRING)   -- punctuation in math context
    PROCEDURE Shape()               -- shape indicator (geometry)
    PROCEDURE Omission()            -- blank/dash in a problem
    PROCEDURE Prime()               -- '
    PROCEDURE Ellipsis()            -- ...

    -- named symbols: packed-table lookup + emit (latex + asciimath
    -- names share one dictionary); Parse() walks the whole grammar
    FUNCTION SymFind(nm AS STRING) AS S64
    PROCEDURE SymPut(i AS S64)
    PROCEDURE SymEmit(nm AS STRING)
    PROCEDURE Parse(s AS STRING)
    PROCEDURE Transcribe(s AS STRING)   -- Reset + Parse, one-shot

    -- spatial engine:  matrices (enlarged grouping, left-justified
    -- columns) and stacked arithmetic (+ - x, separation lines).
    -- encl:  0 none  1 paren  2 bracket  3 brace  4 bar  5 cases
    -- (open brace only).  Parse() also accepts \begin{pmatrix|
    -- bmatrix|Bmatrix|vmatrix|matrix|cases} with & and \\, and
    -- \binom{n}{k}.  Spatial numerals take no # indicator.
    PROCEDURE MatBegin(encl AS S64)
    PROCEDURE MatEntry(s AS STRING)
    PROCEDURE MatRow()
    PROCEDURE MatEnd()
    -- stacked arithmetic;  op: 0 none 1 '+' 2 '-' 3 'x'
    PROCEDURE StackBegin()
    PROCEDURE StackRow(txt AS STRING, op AS S64)
    PROCEDURE StackLine()
    PROCEDURE StackEnd()
    -- long division:  quotient over sep-line over divisor+dividend
    PROCEDURE LDiv(dend AS STRING, dsor AS STRING, quot AS STRING)

    -- ---------------------------------------------------------------
    --  markup bridge:  source -> LaTeX / MathML.  Shares Tok() + the
    --  symbol table but renders instead of transcribing.  Iterative
    --  frame-stack machine (ALB bans recursion): open constructs push
    --  frames; \frac / \sqrt / envs are operand-hungry frames that
    --  complete on delivered units; ^ _ buffer sub/sup slots.
    -- ---------------------------------------------------------------
    FUNCTION ToLatex(s AS STRING) AS STRING
    FUNCTION ToMathML(s AS STRING) AS STRING
    FUNCTION LxEsc(s AS STRING) AS STRING
    FUNCTION LxSymL(w AS STRING) AS STRING
    FUNCTION LxSymM(w AS STRING) AS STRING
    FUNCTION LxBig(w AS STRING) AS S64
    FUNCTION LxMat(base AS STRING, sub AS STRING, sup AS STRING,
                   op AS S64) AS STRING
    PROCEDURE LxFlush()
    PROCEDURE LxPush(k AS S64, env AS STRING)
    PROCEDURE LxRestore()
    FUNCTION LxWrap(k AS S64, inner AS STRING) AS STRING
    PROCEDURE LxDeliver(txt AS STRING, inner AS STRING, grp AS S64,
                        op AS S64)
    PROCEDURE LxGroupEnd(k AS S64, rgt AS STRING)
    PROCEDURE LxCellCommit()
    PROCEDURE LxRowCommit()
    FUNCTION LxRun(s AS STRING, m AS S64) AS STRING

    -- ---------------------------------------------------------------
    --  back-translation:  cell stream -> canonical math source (B1b).
    --  Contract: Transcribe(From*(x)) reproduces x's cell stream; the
    --  returned SOURCE is canonical (fracs all \frac, scripts braced,
    --  ambiguous forms pick one spelling).  Iterative nb_* frame
    --  stack, same shape as Lx*.
    -- ---------------------------------------------------------------
    FUNCTION FromCells(n AS S64) AS STRING
    FUNCTION ToSource() AS STRING
    FUNCTION FromBrf(b AS STRING) AS STRING
    FUNCTION FromUni(u AS STRING) AS STRING
    FUNCTION NbPackAt(pos AS S64) AS S64
    FUNCTION NbIsLet(c AS S64) AS S64
    FUNCTION NbIsDig(c AS S64) AS S64
    FUNCTION NbDigVal(c AS S64) AS S64
    PROCEDURE NbFlush()
    PROCEDURE NbUnit(t AS STRING)
    PROCEDURE NbOp(t AS STRING)
    PROCEDURE NbPush(k AS S64)
    PROCEDURE NbPop()
    PROCEDURE NbEndScr()
    PROCEDURE NbScrPush(k AS S64)
    PROCEDURE NbNum()
    PROCEDURE NbWord()
    FUNCTION NbSymOut(i AS S64) AS STRING
    FUNCTION NbGrpL(k AS S64) AS STRING
    FUNCTION NbGrpR(k AS S64) AS STRING
    FUNCTION NbEnvName(k AS S64) AS STRING
    PROCEDURE NbDots()
    FUNCTION NbSpaced(pos AS S64) AS S64
    FUNCTION NbSpaced1(pos AS S64) AS S64
    PROCEDURE NbEnvEnd()
    PROCEDURE NbFour()
    PROCEDURE NbOpInd()
    PROCEDURE NbPunc()
    PROCEDURE NbRun()
    FUNCTION NbInit(n AS S64) AS STRING
END DECLARE MODULE

MODULE Nemeth

    -- ---------------------------------------------------------------
    --  cell model:  value = bitmask, dot n = 2^(n-1)
    -- ---------------------------------------------------------------
    --  verified against BANA Nemeth 2022 indicator table + NFB symbol
    --  library (dots listed for each entry)

    #NEM_MAX   = 8192        -- max cells in one transcription stream
    #NEM_ERR   = 64          -- bounded error ledger
    #NEM_LF    = -1          -- line-break sentinel in the cell stream

    STRICT ncell[#NEM_MAX] AS S64
    STRICT nerr[#NEM_ERR]  AS STRING
    --  positions of real fraction markers (open/line/close first
    --  cell).  cell VALUES collide:  # numeric indicator is 60 like
    --  the frac-close cell, so markers are tracked by position.
    STRICT nmk[#NEM_MAX]   AS S64
    LET nmk_n  AS S64 = 0
    LET ncnt   AS S64 = 0
    LET nen    AS S64 = 0
    LET nnum   AS S64 = 0    -- numeric mode:  1 = inside a numeral
    LET nlev   AS S64 = 0    -- level:  0 baseline, + sup, - sub
    LET ncapw  AS S64 = 0    -- inside a double-cap word

    --  spatial engine state:  entries transcribe into the scratch
    --  tail of ncell, copy to the grid buffer, and rewind
    #GE_BUF  = 8192
    #GE_MAX  = 256
    #GE_ROWS = 64
    STRICT ge_buf[#GE_BUF]  AS S64
    STRICT ge_off[#GE_MAX]  AS S64
    STRICT ge_len[#GE_MAX]  AS S64
    STRICT gr_start[#GE_ROWS] AS S64
    STRICT gr_op[#GE_ROWS]  AS S64      --  stacked-arith op per row
    STRICT gcw[#GE_ROWS]    AS S64      --  scratch: column widths
    LET ge_n  AS S64 = 0
    LET gr_n  AS S64 = 0
    LET ge_p  AS S64 = 0                --  ge_buf write cursor
    LET gm_encl AS S64 = 0
    LET gm_cols AS S64 = 0
    LET nsp_flag AS S64 = 0             --  1 = spatial (no # indicator)
    LET nsp0  AS S64 = 0                --  scratch base inside ncell
    LET nmk0  AS S64 = 0                --  marker base for rewind

    -- ---------------------------------------------------------------
    --  lookup tables (filled by FillTabs, run by Reset)
    -- ---------------------------------------------------------------
    STRICT nlet[26]  AS S64      -- a-z literary cells
    STRICT ndig[10]  AS S64      -- nemeth digits (lower cells)
    STRICT brfa[64]  AS S64      -- cell -> BRF ascii code

    PROCEDURE FillTabs()
        -- literary letters (standard braille)
        nlet[0]  = 1     --  a  dots 1
        nlet[1]  = 3     --  b  dots 1,2
        nlet[2]  = 9     --  c  dots 1,4
        nlet[3]  = 25    --  d  dots 1,4,5
        nlet[4]  = 17    --  e  dots 1,5
        nlet[5]  = 11    --  f  dots 1,2,4
        nlet[6]  = 27    --  g  dots 1,2,4,5
        nlet[7]  = 19    --  h  dots 1,2,5
        nlet[8]  = 10    --  i  dots 2,4
        nlet[9]  = 26    --  j  dots 2,4,5
        nlet[10] = 5     --  k  dots 1,3
        nlet[11] = 7     --  l  dots 1,2,3
        nlet[12] = 13    --  m  dots 1,3,4
        nlet[13] = 29    --  n  dots 1,3,4,5
        nlet[14] = 21    --  o  dots 1,3,5
        nlet[15] = 15    --  p  dots 1,2,3,4
        nlet[16] = 31    --  q  dots 1,2,3,4,5
        nlet[17] = 23    --  r  dots 1,2,3,5
        nlet[18] = 14    --  s  dots 2,3,4
        nlet[19] = 30    --  t  dots 2,3,4,5
        nlet[20] = 37    --  u  dots 1,3,6
        nlet[21] = 39    --  v  dots 1,2,3,6
        nlet[22] = 58    --  w  dots 2,4,5,6
        nlet[23] = 45    --  x  dots 1,3,4,6
        nlet[24] = 61    --  y  dots 1,3,4,5,6
        nlet[25] = 53    --  z  dots 1,3,5,6
        -- nemeth digits: lower-cell forms of a-j
        ndig[0] = 52     --  0  dots 3,5,6
        ndig[1] = 2      --  1  dot 2
        ndig[2] = 6      --  2  dots 2,3
        ndig[3] = 18     --  3  dots 2,5
        ndig[4] = 50     --  4  dots 2,5,6
        ndig[5] = 34     --  5  dots 2,6
        ndig[6] = 22     --  6  dots 2,3,5
        ndig[7] = 54     --  7  dots 2,3,5,6
        ndig[8] = 38     --  8  dots 2,3,6
        ndig[9] = 20     --  9  dots 3,5
        -- North American Braille ASCII (NABCC): cell -> char code
        brfa[0]  = 32    --  space
        brfa[1]  = 65    --  A
        brfa[2]  = 49    --  1
        brfa[3]  = 66    --  B
        brfa[4]  = 39    --  '
        brfa[5]  = 75    --  K
        brfa[6]  = 50    --  2
        brfa[7]  = 76    --  L
        brfa[8]  = 64    --  @
        brfa[9]  = 67    --  C
        brfa[10] = 73    --  I
        brfa[11] = 70    --  F
        brfa[12] = 47    --  /
        brfa[13] = 77    --  M
        brfa[14] = 83    --  S
        brfa[15] = 80    --  P
        brfa[16] = 34    --  "
        brfa[17] = 69    --  E
        brfa[18] = 51    --  3
        brfa[19] = 72    --  H
        brfa[20] = 57    --  9
        brfa[21] = 79    --  O
        brfa[22] = 54    --  6
        brfa[23] = 82    --  R
        brfa[24] = 94    --  ^
        brfa[25] = 68    --  D
        brfa[26] = 74    --  J
        brfa[27] = 71    --  G
        brfa[28] = 62    --  >
        brfa[29] = 78    --  N
        brfa[30] = 84    --  T
        brfa[31] = 81    --  Q
        brfa[32] = 44    --  ,
        brfa[33] = 42    --  *
        brfa[34] = 53    --  5
        brfa[35] = 60    --  <
        brfa[36] = 45    --  -
        brfa[37] = 85    --  U
        brfa[38] = 56    --  8
        brfa[39] = 86    --  V
        brfa[40] = 46    --  .
        brfa[41] = 37    --  %
        brfa[42] = 91    --  [
        brfa[43] = 36    --  $
        brfa[44] = 43    --  +
        brfa[45] = 88    --  X
        brfa[46] = 33    --  !
        brfa[47] = 38    --  &
        brfa[48] = 59    --  ;
        brfa[49] = 58    --
brfa[50] = 52    --  4
        brfa[51] = 92    --  \
        brfa[52] = 48    --  0
        brfa[53] = 90    --  Z
        brfa[54] = 55    --  7
        brfa[55] = 40    --  (
        brfa[56] = 95    --  _
        brfa[57] = 63    --  ?
        brfa[58] = 87    --  W
        brfa[59] = 93    --  ]
        brfa[60] = 35    --  #
        brfa[61] = 89    --  Y
        brfa[62] = 41    --  )
        brfa[63] = 61    --  =
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  errors: strict ledger, never wrong output
    -- ---------------------------------------------------------------
    PROCEDURE NErr(s AS STRING)
        IF nen < #NEM_ERR THEN
            nerr[nen] = s
            nen = nen + 1
        END IF
    END PROCEDURE

    FUNCTION ErrCount() AS S64
        RETURN nen
    END FUNCTION

    FUNCTION ErrText(i AS S64) AS STRING
        IF i < 0 ORELSE i >= nen THEN RETURN "" END IF
        RETURN nerr[i]
    END FUNCTION

    -- ---------------------------------------------------------------
    --  emit
    -- ---------------------------------------------------------------
    PROCEDURE Put(c AS S64)
        IF ncnt >= #NEM_MAX THEN
CALL NErr("cell buffer full (" | #NEM_MAX | ")")
            RETURN
        END IF
        IF c < 0 ORELSE c > 63 THEN
            IF c <> #NEM_LF THEN
CALL NErr("bad cell value " | c)
                RETURN
            END IF
        END IF
        ncell[ncnt] = c
        ncnt = ncnt + 1
    END PROCEDURE

    PROCEDURE Space()
        --  collapse adjacent blanks:  input spaces and the spaces
        --  transcription adds around relations must not double up
        IF ncnt = 0 ORELSE ncell[ncnt - 1] <> 0 THEN
            CALL Put(0)
        END IF
        nnum = 0
        ncapw = 0
        --  spaces inside a levelled group are content and keep the
        --  level;  a space at base level does return to baseline
        IF InLevGroup() = 0 THEN nlev = 0 END IF
    END PROCEDURE

    PROCEDURE Newline()
CALL Put(#NEM_LF)
        nnum = 0
        ncapw = 0
    END PROCEDURE

    PROCEDURE Reset()
        ncnt = 0
        nen = 0
        nnum = 0
        nlev = 0
        ncapw = 0
        nmk_n = 0
        nsp_flag = 0
        ge_n = 0
        gr_n = 0
        ge_p = 0
CALL FillTabs()
CALL FillSym()
    END PROCEDURE

    FUNCTION Count() AS S64
        RETURN ncnt
    END FUNCTION

    FUNCTION Cell(i AS S64) AS S64
        IF i < 0 ORELSE i >= ncnt THEN RETURN -2 END IF
        RETURN ncell[i]
    END FUNCTION

    -- ---------------------------------------------------------------
    --  encoders
    -- ---------------------------------------------------------------
    FUNCTION ToBrf() AS STRING
        LET s AS STRING = ""
        LET i AS S64 = 0
        LET c AS S64 = 0
        i = 0
        WHILE i < ncnt
            c = ncell[i]
            IF c = #NEM_LF THEN
                s = s | CHR(10)
            ELSE
                s = s | CHR(brfa[c])
            END IF
            i = i + 1
        END WHILE
        RETURN s
    END FUNCTION

    FUNCTION ToUni() AS STRING
        LET s AS STRING = ""
        LET i AS S64 = 0
        LET c AS S64 = 0
        i = 0
        WHILE i < ncnt
            c = ncell[i]
            IF c = #NEM_LF THEN
                s = s | CHR(10)
            ELSE
                s = s | CHR(10240 + c)
            END IF
            i = i + 1
        END WHILE
        RETURN s
    END FUNCTION

    -- ---------------------------------------------------------------
    --  row readback — the cell stream is flat with -1 line-break
    --  sentinels; row r is the text between sentinels r-1 and r.
    --  A trailing newline yields a final empty row (RowCount counts
    --  it).  Out-of-range r returns "".
    -- ---------------------------------------------------------------
    FUNCTION RowCount() AS S64
        LET n AS S64 = 0
        LET i AS S64 = 0
        LET c AS S64 = 0
        IF ncnt = 0 THEN RETURN 0 END IF
        n = 1
        i = 0
        WHILE i < ncnt
            c = ncell[i]
            IF c = #NEM_LF THEN n = n + 1 END IF
            i = i + 1
        END WHILE
        RETURN n
    END FUNCTION

    FUNCTION RowBrf(r AS S64) AS STRING
        LET s AS STRING = ""
        LET i AS S64 = 0
        LET cur AS S64 = 0
        LET c AS S64 = 0
        i = 0
        WHILE i < ncnt
            c = ncell[i]
            IF c = #NEM_LF THEN
                IF cur = r THEN RETURN s END IF
                cur = cur + 1
            ELSE
                IF cur = r THEN s = s | CHR(brfa[c]) END IF
            END IF
            i = i + 1
        END WHILE
        IF cur = r THEN RETURN s END IF
        RETURN ""
    END FUNCTION

    FUNCTION RowUni(r AS S64) AS STRING
        LET s AS STRING = ""
        LET i AS S64 = 0
        LET cur AS S64 = 0
        LET c AS S64 = 0
        i = 0
        WHILE i < ncnt
            c = ncell[i]
            IF c = #NEM_LF THEN
                IF cur = r THEN RETURN s END IF
                cur = cur + 1
            ELSE
                IF cur = r THEN s = s | CHR(10240 + c) END IF
            END IF
            i = i + 1
        END WHILE
        IF cur = r THEN RETURN s END IF
        RETURN ""
    END FUNCTION

    -- ---------------------------------------------------------------
    --  builder: numerals and letters
    -- ---------------------------------------------------------------
    --  numerals take the numeric indicator unless numeric mode is on
    --  or they sit in super/subscript position (spec: no indicator in
    --  raised/lowered position).  "." decimal point, "," numeric comma.
    PROCEDURE Num(s AS STRING)
        LET i AS S64 = 0
        LET a AS S64 = 0
        LET ch AS STRING = ""
        IF LEN(s) < 1 THEN
CALL NErr("Num: empty string")
            RETURN
        END IF
        IF nnum = 0 AND nlev = 0 AND nsp_flag = 0 THEN
CALL Put(60)            --  numeric indicator  dots 3,4,5,6
        END IF
        i = 1
        WHILE i <= LEN(s)
            ch = MID(s, i, 1)
            a = ASC(ch)
            IF a >= 48 AND a <= 57 THEN
CALL Put(ndig[a - 48])
            ELSEIF ch = "." THEN
CALL Put(40)        --  decimal point      dots 4,6
            ELSEIF ch = "," THEN
CALL Put(32)        --  numeric comma      dot 6
            ELSE
CALL NErr("Num: bad char '" | ch | "'")
            END IF
            i = i + 1
        END WHILE
        nnum = 1
    END PROCEDURE

    --  letters: single lowercase letter standing alone gets the
    --  English-letter indicator (dots 5,6).  a single capital gets dot 6;
    --  an all-caps word gets double-dot-6 once; mixed case caps each
    --  uppercase letter.  caller passes one word/variable per call.
    PROCEDURE Letters(s AS STRING)
        LET i AS S64 = 0
        LET a AS S64 = 0
        LET n AS S64 = 0
        LET ch AS STRING = ""
        LET allup AS S64 = 1
        n = LEN(s)
        IF n < 1 THEN
CALL NErr("Let: empty string")
            RETURN
        END IF
        i = 1
        WHILE i <= n
            ch = MID(s, i, 1)
            a = ASC(ch)
            IF a < 65 ORELSE a > 122 ORELSE (a > 90 AND a < 97) THEN
CALL NErr("Let: bad char '" | ch | "'")
                RETURN
            END IF
            IF a >= 97 THEN allup = 0 END IF
            i = i + 1
        END WHILE
        IF n = 1 THEN
            ch = MID(s, 1, 1)
            a = ASC(ch)
            IF a >= 97 THEN
CALL Put(48)        --  ELI                dots 5,6
CALL Put(nlet[a - 97])
            ELSE
CALL Put(32)        --  single cap         dot 6
CALL Put(nlet[a - 65])
            END IF
        ELSE
            IF allup = 1 THEN
CALL Put(32)        --  double cap word
CALL Put(32)
            END IF
            i = 1
            WHILE i <= n
                ch = MID(s, i, 1)
                a = ASC(ch)
                IF a >= 97 THEN
CALL Put(nlet[a - 97])
                ELSE
                    IF allup = 0 THEN CALL Put(32) END IF
CALL Put(nlet[a - 65])
                END IF
                i = i + 1
            END WHILE
        END IF
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  signs of operation
    -- ---------------------------------------------------------------
    PROCEDURE Plus()                     --  +    dots 3,4,6
CALL Put(44)
    END PROCEDURE

    PROCEDURE Minus()                    --  -    dots 3,6
CALL Put(36)
    END PROCEDURE

    PROCEDURE TimesCross()                    --  x    dot4 , dots 1,6
CALL Put(8)
CALL Put(33)
    END PROCEDURE

    PROCEDURE DotOp()                    --  .    dots 1,6
CALL Put(33)
    END PROCEDURE

    PROCEDURE Obelus()                   --  div  dots 4,6 , dots 3,4
CALL Put(40)
CALL Put(12)
    END PROCEDURE

    PROCEDURE Slash()                    --  /    dots 4,5,6 , dots 3,4
CALL Put(56)
CALL Put(12)
    END PROCEDURE

    PROCEDURE PlusMinus()                --  +-   plus then minus cells
CALL Put(44)
CALL Put(36)
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  signs of comparison (caller must Space() around them)
    -- ---------------------------------------------------------------
    PROCEDURE Equals()                   --  =    dots 4,6 , dots 1,3
CALL Put(40)
CALL Put(5)
        nnum = 0
    END PROCEDURE

    PROCEDURE Lt()                       --  <    dot 5 , dots 1,3
CALL Put(16)
CALL Put(5)
        nnum = 0
    END PROCEDURE

    PROCEDURE Gt()                       --  >    dots 4,6 , dot 2
CALL Put(40)
CALL Put(2)
        nnum = 0
    END PROCEDURE

    PROCEDURE Le()                       --  <=   lt + bar  dots 1,5,6
CALL Put(16)
CALL Put(5)
CALL Put(49)
        nnum = 0
    END PROCEDURE

    PROCEDURE Ge()                       --  >=   gt + bar
CALL Put(40)
CALL Put(2)
CALL Put(49)
        nnum = 0
    END PROCEDURE

    PROCEDURE Ne()                       --  /=   slash-negation + equals
CALL Put(12)
CALL Put(40)
CALL Put(5)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  grouping
    -- ---------------------------------------------------------------
    PROCEDURE ParenL()                   --  (    dots 1,2,3,5,6
CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE ParenR()                   --  )    dots 2,3,4,5,6
CALL Put(62)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  fractions  (k: 0 simple, 1 complex, 2 hypercomplex = dot6 x k)
    -- ---------------------------------------------------------------
    PROCEDURE FracOpen(k AS S64)
        LET i AS S64 = 0
        IF k < 0 ORELSE k > 2 THEN
CALL NErr("FracOpen: bad level " | k)
            RETURN
        END IF
        i = 0
        WHILE i < k
CALL Put(32)            --  dot 6 prefix
            i = i + 1
        END WHILE
CALL Put(57)                --  opening fraction  dots 1,4,5,6
        nnum = 0
    END PROCEDURE

    PROCEDURE FracLine(k AS S64)
        LET i AS S64 = 0
        IF k < 0 ORELSE k > 2 THEN
CALL NErr("FracLine: bad level " | k)
            RETURN
        END IF
        i = 0
        WHILE i < k
CALL Put(32)
            i = i + 1
        END WHILE
CALL Put(12)                --  fraction line     dots 3,4
        nnum = 0
    END PROCEDURE

    PROCEDURE FracClose(k AS S64)
        LET i AS S64 = 0
        IF k < 0 ORELSE k > 2 THEN
CALL NErr("FracClose: bad level " | k)
            RETURN
        END IF
        i = 0
        WHILE i < k
CALL Put(32)
            i = i + 1
        END WHILE
CALL Put(60)                --  closing fraction  dots 3,4,5,6
        nnum = 0
    END PROCEDURE

    PROCEDURE MFracOpen()           --  mixed-number frac  _?
CALL Put(56)
CALL Put(57)
        nnum = 0
    END PROCEDURE

    PROCEDURE MFracClose()          --                     _#
CALL Put(56)
CALL Put(60)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  levels
    -- ---------------------------------------------------------------
    PROCEDURE Sup()                     --  superscript   dots 4,5
CALL Put(24)
        nlev = nlev + 1
        nnum = 0
    END PROCEDURE

    PROCEDURE Sub()                     --  subscript     dots 5,6
CALL Put(48)
        nlev = nlev - 1
        nnum = 0
    END PROCEDURE

    PROCEDURE Base()                    --  baseline      dot 5
CALL Put(16)
        nlev = 0
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  radicals
    -- ---------------------------------------------------------------
    PROCEDURE Rad()                     --  radical       dots 1,4,6
CALL Put(41)
        nnum = 0
    END PROCEDURE

    PROCEDURE RadIdx()                  --  index mark    dots 1,2,6
CALL Put(35)
        nnum = 0
    END PROCEDURE

    PROCEDURE Term()                    --  termination   dots 1,2,4,5,6
CALL Put(59)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  indicators and misc
    -- ---------------------------------------------------------------
    PROCEDURE Punct(ch AS STRING)
        --  nemeth punctuation: , and ' are bare cells; the rest take
        --  the punctuation indicator (dots 4,5,6) + literary cell
        IF LEN(ch) <> 1 THEN
CALL NErr("Punct: want 1 char")
            RETURN
        END IF
        IF ch = "," THEN
CALL Put(32)            --  comma          dot 6
        ELSEIF ch = "'" THEN
CALL Put(4)             --  apostrophe     dot 3
        ELSEIF ch = ";" THEN
CALL Put(56)
CALL Put(6)
        ELSEIF ch = ":" THEN
CALL Put(56)
CALL Put(18)
        ELSEIF ch = "." THEN
CALL Put(56)
CALL Put(50)
        ELSEIF ch = "!" THEN
CALL Put(56)
CALL Put(22)
        ELSEIF ch = "?" THEN
CALL Put(56)
CALL Put(38)
        ELSEIF ch = "-" THEN
CALL Put(56)
CALL Put(36)
        ELSE
CALL NErr("Punct: unmapped '" | ch | "'")
            RETURN
        END IF
        nnum = 0
    END PROCEDURE

    PROCEDURE Shape()                   --  shape indicator  dots 1,2,4,6
CALL Put(43)
        nnum = 0
    END PROCEDURE

    PROCEDURE Omission()                --  blank/dash  dots 3,6 x 4
CALL Put(36)                    --  TODO spec-verify count/form
CALL Put(36)
CALL Put(36)
CALL Put(36)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  grouping variants
    -- ---------------------------------------------------------------
    PROCEDURE BracketL()                --  [   dot 4 , parenL
CALL Put(8)
CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE BracketR()                --  ]   dot 4 , parenR
CALL Put(8)
CALL Put(62)
        nnum = 0
    END PROCEDURE

    PROCEDURE BraceL()                  --  {   dots 4,6 , parenL
