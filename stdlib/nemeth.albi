CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE BraceR()                  --  }   dots 4,6 , parenR
CALL Put(40)
CALL Put(62)
        nnum = 0
    END PROCEDURE

    PROCEDURE BarSym()                  --  |   dots 1,6 (abs / such-that)
CALL Put(33)
        nnum = 0
    END PROCEDURE

    PROCEDURE FloorL()                  --  |_  dot 4 , sub , parenL
CALL Put(8)
CALL Put(48)
CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE FloorR()                  --  _|  dot 4 , sub , parenR
CALL Put(8)
CALL Put(48)
CALL Put(62)
        nnum = 0
    END PROCEDURE

    PROCEDURE CeilL()                   --  |   dot 4 , sup , parenL
CALL Put(8)
CALL Put(24)
CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE CeilR()                   --  |   dot 4 , sup , parenR
CALL Put(8)
CALL Put(24)
CALL Put(62)
        nnum = 0
    END PROCEDURE

    PROCEDURE AngL()                    --  <   dots 4,6 x 2 , parenL
CALL Put(40)
CALL Put(40)
CALL Put(55)
        nnum = 0
    END PROCEDURE

    PROCEDURE AngR()                    --  >   dots 4,6 x 2 , parenR
CALL Put(40)
CALL Put(40)
CALL Put(62)
        nnum = 0
    END PROCEDURE

    PROCEDURE Prime()                   --  '   dot 3
CALL Put(4)
        nnum = 0
    END PROCEDURE

    PROCEDURE Ellipsis()                --  ...  dot 3 x 3
CALL Put(4)
CALL Put(4)
CALL Put(4)
        nnum = 0
    END PROCEDURE

    -- ---------------------------------------------------------------
    --  cell insertion: shift [pos,ncnt) right, drop c at pos.
    --  used by fraction wrapping: the open/line/close markers and
    --  their dot-6 level prefixes go around already-emitted factors.
    -- ---------------------------------------------------------------
    PROCEDURE InsCell(pos AS S64, c AS S64)
        LET j AS S64 = 0
        IF pos < 0 ORELSE pos >= ncnt THEN
CALL NErr("InsCell: bad pos")
            RETURN
        END IF
        IF ncnt >= #NEM_MAX THEN
CALL NErr("cell buffer full")
            RETURN
        END IF
        j = ncnt
        WHILE j > pos
            ncell[j] = ncell[j - 1]
            j = j - 1
        END WHILE
        ncell[pos] = c
        ncnt = ncnt + 1
        --  every marker at or right of pos slides one cell
        j = 0
        WHILE j < nmk_n
            IF nmk[j] >= pos THEN nmk[j] = nmk[j] + 1 END IF
            j = j + 1
        END WHILE
    END PROCEDURE

    --  record a fraction marker position for ScanFrac
    PROCEDURE MkAt(pos AS S64)
        IF pos < 0 ORELSE pos >= ncnt THEN RETURN END IF
        IF nmk_n >= #NEM_MAX THEN
            CALL NErr("marker table full")
            RETURN
        END IF
        nmk[nmk_n] = pos
        nmk_n = nmk_n + 1
    END PROCEDURE

    --  scan [a,b): deepest dot-6 prefix run ahead of a REAL fraction
    --  marker (positions tracked in nmk; cell values alone lie:
    --  # numeric indicator is also cell 60).  returns the max inner
    --  fraction level, or -1 when the range holds no markers.
    FUNCTION ScanFrac(a AS S64, b AS S64) AS S64
        LET i AS S64 = 0
        LET j AS S64 = 0
        LET k AS S64 = 0
        LET m AS S64 = 0
        LET mx AS S64 = -1
        i = 0
        WHILE i < nmk_n
            m = nmk[i]
            IF m >= a AND m < b THEN
                k = 0
                j = m - 1
                WHILE j >= a AND ncell[j] = 32
                    k = k + 1
                    j = j - 1
                END WHILE
                IF k > mx THEN mx = k END IF
            END IF
            i = i + 1
        END WHILE
        RETURN mx
    END FUNCTION

    -- ---------------------------------------------------------------
    --  named-symbol dictionary: name -> packed cells
    --  pack = n * 2^48 | c0 | c1*64 | ...  (<= 8 cells = 48 bits,
    --  count fits above;  whole value stays < 2^53 for f64-exact
    --  arithmetic)
    -- ---------------------------------------------------------------
    #NEM_NSYM = 200
    STRICT ns_name[#NEM_NSYM] AS STRING
    STRICT ns_pack[#NEM_NSYM] AS S64
    STRICT ns_rel[#NEM_NSYM]  AS S64     --  1 = spaced relation
    LET ns_n AS S64 = 0

    PROCEDURE SymReg(nm AS STRING, p AS S64, r AS S64)
        IF ns_n >= #NEM_NSYM THEN
CALL NErr("symbol table full")
            RETURN
        END IF
        ns_name[ns_n] = nm
        ns_pack[ns_n] = p
        ns_rel[ns_n] = r
        ns_n = ns_n + 1
    END PROCEDURE

    FUNCTION Pack1(c0 AS S64) AS S64
        RETURN 281474976710656 + c0
    END FUNCTION

    FUNCTION Pack2(c0 AS S64, c1 AS S64) AS S64
        RETURN 562949953421312 + c0 + c1 * 64
    END FUNCTION

    FUNCTION Pack3(c0 AS S64, c1 AS S64, c2 AS S64) AS S64
        RETURN 844424930131968 + c0 + c1 * 64 + c2 * 4096
    END FUNCTION

    FUNCTION Pack4(c0 AS S64, c1 AS S64, c2 AS S64, c3 AS S64) AS S64
        RETURN 1125899906842624 + c0 + c1 * 64 + c2 * 4096 +
               c3 * 262144
    END FUNCTION

    FUNCTION Pack5(c0 AS S64, c1 AS S64, c2 AS S64, c3 AS S64,
                   c4 AS S64) AS S64
        RETURN 1407374883553280 + c0 + c1 * 64 + c2 * 4096 +
               c3 * 262144 + c4 * 16777216
    END FUNCTION

    FUNCTION Pack6(c0 AS S64, c1 AS S64, c2 AS S64, c3 AS S64,
                   c4 AS S64, c5 AS S64) AS S64
        RETURN 1688849860263936 + c0 + c1 * 64 + c2 * 4096 +
               c3 * 262144 + c4 * 16777216 + c5 * 1073741824
    END FUNCTION

    FUNCTION Pack7(c0 AS S64, c1 AS S64, c2 AS S64, c3 AS S64,
                   c4 AS S64, c5 AS S64, c6 AS S64) AS S64
        RETURN 1970324836974592 + c0 + c1 * 64 + c2 * 4096 +
               c3 * 262144 + c4 * 16777216 + c5 * 1073741824 +
               c6 * 68719476736
    END FUNCTION

    PROCEDURE FillSym()
        ns_n = 0
        --  constants and misc          name       cells              rel
CALL SymReg("infty",       Pack2(32, 63),              0)
CALL SymReg("oo",          Pack2(32, 63),              0)
