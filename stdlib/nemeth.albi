CALL SymReg("oslash",      Pack7(43, 9, 56, 43, 56, 12, 59),0)
        --  comparisons and relations (rel = 1: caller wraps spaces)
CALL SymReg("~",           Pack2(8, 49),               1)
CALL SymReg("neq",         Pack3(12, 40, 5),           1)
CALL SymReg("ne",          Pack3(12, 40, 5),           1)
CALL SymReg("!=",          Pack3(12, 40, 5),           1)
CALL SymReg("leq",         Pack3(16, 5, 49),           1)
