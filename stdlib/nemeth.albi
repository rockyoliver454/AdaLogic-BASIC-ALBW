CALL SymReg("setminus",    Pack2(56, 33),              0)
CALL SymReg("wedge",       Pack2(8, 41),               0)
CALL SymReg("vee",         Pack2(8, 44),               0)
CALL SymReg("oplus",       Pack6(43, 9, 56, 43, 44, 59),   0)
