CALL SymReg("amp",         Pack2(56, 47),              0)
CALL SymReg("degree",      Pack3(24, 40, 33),          0)
CALL SymReg("deg",         Pack3(24, 40, 33),          0)
        --  operations
CALL SymReg("pm",          Pack2(44, 36),              0)
CALL SymReg("+-",          Pack2(44, 36),              0)
CALL SymReg("mp",          Pack2(36, 44),              0)
CALL SymReg("-+",          Pack2(36, 44),              0)
CALL SymReg("times",       Pack2(8, 33),               0)
CALL SymReg("xx",          Pack2(8, 33),               0)
CALL SymReg("cdot",        Pack1(33),                  0)
CALL SymReg("ast",         Pack2(8, 60),               0)
CALL SymReg("div",         Pack2(40, 12),              0)
CALL SymReg("circ",        Pack2(40, 33),              0)
CALL SymReg("cap",         Pack2(40, 41),              0)
CALL SymReg("nn",          Pack2(40, 41),              0)
