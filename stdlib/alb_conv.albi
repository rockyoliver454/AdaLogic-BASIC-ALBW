-- ============================================================================
-- alb_conv — numeric conversions the builtins don't cover.
--
-- ToHex/ToBin/ToOct format S64 in bases 16/2/8 via a shared private
-- radix core (uppercase digits). ParseInt is a strict base-10 parser —
-- no float round-trip — and LikeInt reports whether a string is all
-- digits (optional leading '-'). Negative inputs to the radix core
-- format as "-" + magnitude (S64_MIN edge: wraps, documented).
--
--   PRINT AlbConv.ToHex(255)      -- "FF"
--   PRINT AlbConv.ToBin(5)        -- "101"
--   n = AlbConv.ParseInt("-42")
--   IF AlbConv.LikeInt("123") THEN ...
-- ============================================================================

MODULE AlbConv
    PRIVATE FUNCTION Digit(d AS S32) AS STRING
        RETURN MID$("0123456789ABCDEF", d + 1, 1)
    END FUNCTION

    PRIVATE FUNCTION Radix(v AS S64, b AS S64) AS STRING
        IF v = 0 THEN RETURN "0" END IF
        IF v < 0 THEN RETURN "-" | Radix(0 - v, b) END IF
        LET r AS STRING = ""
        LET n AS S64 = v
        WHILE n <> 0
            LET dd AS S32 = n MOD b
            r = Digit(dd) | r
            n = n / b
        END WHILE
        RETURN r
    END FUNCTION

    FUNCTION ToHex(v AS S64) AS STRING
        RETURN Radix(v, 16)
    END FUNCTION

    FUNCTION ToBin(v AS S64) AS STRING
        RETURN Radix(v, 2)
    END FUNCTION

    FUNCTION ToOct(v AS S64) AS STRING
        RETURN Radix(v, 8)
    END FUNCTION

    FUNCTION ParseInt(s AS STRING) AS S64
        LET n AS S64 = 0
        LET ix AS S32 = 1
        LET neg AS S32 = 0
        IF LEN(s) > 0 ANDALSO MID$(s, 1, 1) = "-" THEN
            neg = 1
            ix = 2
        END IF
        WHILE ix <= LEN(s)
            n = n * 10 + ASC(MID$(s, ix, 1)) - 48
            ix = ix + 1
        END WHILE
        IF neg = 1 THEN n = 0 - n END IF
        RETURN n
    END FUNCTION

    FUNCTION LikeInt(s AS STRING) AS S32
        IF LEN(s) = 0 THEN RETURN 0 END IF
        LET ix AS S32 = 1
        IF MID$(s, 1, 1) = "-" THEN ix = 2 END IF
        IF ix > LEN(s) THEN RETURN 0 END IF
        WHILE ix <= LEN(s)
            LET c AS S64 = ASC(MID$(s, ix, 1))
            IF c < 48 ORELSE c > 57 THEN RETURN 0 END IF
            ix = ix + 1
        END WHILE
        RETURN 1
    END FUNCTION
END MODULE
